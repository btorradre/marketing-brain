<h1 class="lt-min-title">{{ collection.title }}</h1>
<p>{{ collection.description }}</p>
<div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 22px; margin-top: 28px;">
{% for product in collection.products %}
  <a href="{{ product.url }}" style="text-decoration:none; color:inherit;">
    <div style="background: var(--lt-cream-2); border:1px solid var(--lt-line); border-radius: 12px; overflow: hidden;">
      <div style="aspect-ratio: 1/1; overflow: hidden;"><img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" style="width:100%; height:100%; object-fit:cover; display:block;"></div>
      <div style="padding: 16px;">
        <div style="font-family:'Cormorant Garamond',serif; font-size:20px; font-weight:600;">{{ product.title }}</div>
        <div style="margin-top:6px; color: var(--lt-muted); font-size: 14px;">From {{ product.price_min | money }}</div>
      </div>
    </div>
  </a>
{% endfor %}
</div>
