<h1 class="lt-min-title">Create Account</h1>
<div style="max-width: 420px;">
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <label style="display:block; font-size:12px; letter-spacing:0.18em; text-transform:uppercase; margin-bottom:6px;">First Name</label>
    <input type="text" name="customer[first_name]" style="width:100%; padding:14px 18px; border:1px solid var(--lt-line); border-radius:10px; background: var(--lt-cream-2); margin-bottom:14px;">
    <label style="display:block; font-size:12px; letter-spacing:0.18em; text-transform:uppercase; margin-bottom:6px;">Last Name</label>
    <input type="text" name="customer[last_name]" style="width:100%; padding:14px 18px; border:1px solid var(--lt-line); border-radius:10px; background: var(--lt-cream-2); margin-bottom:14px;">
    <label style="display:block; font-size:12px; letter-spacing:0.18em; text-transform:uppercase; margin-bottom:6px;">Email</label>
    <input type="email" name="customer[email]" required style="width:100%; padding:14px 18px; border:1px solid var(--lt-line); border-radius:10px; background: var(--lt-cream-2); margin-bottom:14px;">
    <label style="display:block; font-size:12px; letter-spacing:0.18em; text-transform:uppercase; margin-bottom:6px;">Password</label>
    <input type="password" name="customer[password]" required style="width:100%; padding:14px 18px; border:1px solid var(--lt-line); border-radius:10px; background: var(--lt-cream-2); margin-bottom:20px;">
    <button type="submit" style="display:block; width:100%; background: var(--lt-gold-deep); color:white; border:none; border-radius: 10px; padding: 16px; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; cursor: pointer;">Create Account</button>
  {% endform %}
</div>
