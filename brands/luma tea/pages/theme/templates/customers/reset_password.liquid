<h1 class="lt-min-title">Reset Password</h1>
<div style="max-width:420px;">
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="New password" required style="width:100%; padding:14px 18px; border:1px solid var(--lt-line); border-radius:10px; background:var(--lt-cream-2); margin-bottom:14px;">
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required style="width:100%; padding:14px 18px; border:1px solid var(--lt-line); border-radius:10px; background:var(--lt-cream-2); margin-bottom:20px;">
    <button type="submit" style="display:block; width:100%; background: var(--lt-gold-deep); color:white; border:none; border-radius: 10px; padding: 16px; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; cursor: pointer;">Reset</button>
  {% endform %}
</div>
