<h1 class="lt-min-title">Your Luma Gift Card</h1>
<div style="text-align:center; padding:32px 0;">
  <div style="font-size:42px; font-family:'Cormorant Garamond',serif; color: var(--lt-gold-deep);">{{ gift_card.initial_value | money_without_trailing_zeros }}</div>
  <div style="font-size:12px; color: var(--lt-muted); letter-spacing:0.18em; text-transform:uppercase; margin-top:8px;">Gift Card</div>
  <div style="margin-top:32px; padding:24px; border:1px dashed var(--lt-line); border-radius:10px; font-family: monospace; font-size:18px; letter-spacing:0.1em;">{{ gift_card.code | format_code }}</div>
  <a href="{{ shop.url }}" style="display:inline-block; margin-top:32px; background: var(--lt-gold-deep); color:white; padding: 14px 28px; border-radius: 10px; text-decoration:none; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600;">Shop with this Card &rarr;</a>
</div>
