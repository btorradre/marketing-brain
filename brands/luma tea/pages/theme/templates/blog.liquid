<h1 class="lt-min-title">{{ blog.title }}</h1>
{% for article in blog.articles %}
  <article style="padding: 20px 0; border-bottom:1px solid var(--lt-line);">
    <a href="{{ article.url }}" style="text-decoration:none; color:inherit;">
      <h2 style="margin:0 0 6px;">{{ article.title }}</h2>
      <div style="font-size:12px; color: var(--lt-muted); letter-spacing: 0.12em; text-transform:uppercase;">{{ article.published_at | date: "%B %e, %Y" }}</div>
      <p style="margin-top:10px;">{{ article.excerpt_or_content | strip_html | truncate: 200 }}</p>
    </a>
  </article>
{% endfor %}
