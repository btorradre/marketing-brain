{% comment %} Lunessa PDP — Custom Theme {% endcomment %}

<style>
:root {
  --ln-accent:       #590e05;
  --ln-accent-hover: #7a1507;
  --ln-accent-tint:  #fdf5f4;
  --ln-accent-border:#e8c4c0;
  --ln-text:         #1a1a1a;
  --ln-muted:        #6b7280;
  --ln-border:       #e5e7eb;
  --ln-bg-alt:       #f9fafb;
  --ln-r:            16px;
  --ln-r-sm:         8px;
}

/* ── RESET (scoped) ─────────────────────────── */
.ln * { box-sizing: border-box; }
.ln a { text-decoration: none; color: inherit; }
.ln ul { list-style: none; padding: 0; margin: 0; }
.ln img { display: block; max-width: 100%; height: auto; }

/* ── GLOBAL ─────────────────────────────────── */
.ln { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: var(--ln-text); }
.ln-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

/* ── TOP BAR ────────────────────────────────── */
.ln-topbar { background: var(--ln-accent); color: #fff; padding: 10px 24px; font-size: 13px; font-weight: 500; text-align: center; }
.ln-topbar-row { display: flex; justify-content: center; gap: 32px; flex-wrap: wrap; }
.ln-topbar-row span { display: flex; align-items: center; gap: 5px; }

/* ── HEADER ─────────────────────────────────── */
.ln-header { position: sticky; top: 0; z-index: 900; background: #fff; border-bottom: 1px solid var(--ln-border); padding: 14px 0; }
.ln-header-inner { display: flex; align-items: center; justify-content: space-between; max-width: 1280px; margin: 0 auto; padding: 0 24px; }
.ln-logo { font-size: 22px; font-weight: 800; color: var(--ln-accent); letter-spacing: -0.5px; }
.ln-cart-btn { display: flex; align-items: center; gap: 8px; background: var(--ln-accent); color: #fff; border: none; border-radius: 50px; padding: 10px 20px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit; }
.ln-cart-count { background: #fff; color: var(--ln-accent); border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }

/* ── PROOF STRIP ────────────────────────────── */
.ln-proof { background: var(--ln-accent-tint); border-bottom: 1px solid var(--ln-accent-border); padding: 9px 0; }
.ln-proof-row { display: flex; justify-content: center; align-items: center; gap: 28px; flex-wrap: wrap; font-size: 13px; color: var(--ln-muted); max-width: 1280px; margin: 0 auto; padding: 0 24px; }
.ln-proof-row span { display: flex; align-items: center; gap: 5px; }
.ln-gold { color: #f59e0b; }

/* ── HERO ───────────────────────────────────── */
.ln-hero { padding: 48px 0; }
.ln-hero-grid {
  display: grid;
  grid-template-columns: 58% 42%;
  gap: 48px;
  align-items: start;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Gallery */
.ln-gallery { position: sticky; top: 82px; }

.ln-gallery-main {
  width: 100%;
  border-radius: var(--ln-r);
  overflow: hidden;
  background: #f7f7f7;
  line-height: 0;
}
.ln-gallery-main img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.ln-thumbs { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
.ln-thumb {
  width: 76px;
  height: 76px;
  border-radius: var(--ln-r-sm);
  overflow: hidden;
  border: 2px solid transparent;
  cursor: pointer;
  transition: border-color .2s;
  flex-shrink: 0;
  background: #f7f7f7;
  line-height: 0;
}
.ln-thumb img { width: 100%; height: 100%; object-fit: cover; }
.ln-thumb.active, .ln-thumb:hover { border-color: var(--ln-accent); }

/* Hero right column */
.ln-hero-body {}
.ln-badge-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
.ln-rating-chip { display: flex; align-items: center; gap: 6px; background: var(--ln-accent-tint); border: 1px solid var(--ln-accent-border); border-radius: 50px; padding: 5px 14px; font-size: 13px; font-weight: 600; color: var(--ln-accent); }
.ln-viewers { font-size: 12px; color: var(--ln-muted); }
.ln-viewers b { color: var(--ln-accent); }

.ln-h1 { font-size: 30px; font-weight: 800; line-height: 1.22; margin: 0 0 8px; }
.ln-subheader { font-size: 15px; line-height: 1.5; color: var(--ln-muted); margin: 0 0 16px; }
.ln-sub { font-size: 16px; color: var(--ln-muted); line-height: 1.7; margin: 0 0 20px; }

.ln-checks { margin: 0 0 24px; }
.ln-checks li { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; margin-bottom: 9px; line-height: 1.5; }
.ln-check-dot { width: 20px; height: 20px; border-radius: 50%; background: var(--ln-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; flex-shrink: 0; margin-top: 1px; }

/* Bundle selector */
.ln-bundle-lbl { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--ln-text); margin-bottom: 10px; }
.ln-bundles { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
.ln-bundle {
  position: relative;
  border: 2px solid var(--ln-border);
  border-radius: var(--ln-r-sm);
  padding: 13px 44px 13px 14px;
  cursor: pointer;
  transition: border-color .15s, background .15s;
}
.ln-bundle:hover { border-color: var(--ln-accent); }
.ln-bundle.sel { border-color: var(--ln-accent); background: var(--ln-accent-tint); }
.ln-bundle input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; }
.ln-bundle-top { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; }
.ln-bundle-name { font-size: 15px; font-weight: 700; }
.ln-pill { border-radius: 50px; padding: 2px 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #fff; letter-spacing: .4px; }
.ln-pill-pop { background: var(--ln-accent); }
.ln-pill-val { background: #16a34a; }
.ln-bundle-supply { font-size: 13px; color: var(--ln-muted); margin-bottom: 5px; }
.ln-bundle-prices { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.ln-price-cur { font-size: 20px; font-weight: 800; color: var(--ln-accent); }
.ln-price-was { font-size: 14px; color: var(--ln-muted); text-decoration: line-through; }
.ln-save-tag { background: #dcfce7; color: #16a34a; border-radius: 50px; padding: 2px 8px; font-size: 12px; font-weight: 700; }
.ln-bundle-per { font-size: 12px; color: var(--ln-muted); margin-top: 3px; }
.ln-radio-circle {
  position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
  width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--ln-border);
  transition: all .15s; pointer-events: none;
}
.ln-bundle.sel .ln-radio-circle { border-color: var(--ln-accent); background: var(--ln-accent); box-shadow: inset 0 0 0 4px #fff; }

/* CTA */
.ln-cta { width: 100%; background: var(--ln-accent); color: #fff; border: none; border-radius: 50px; padding: 17px 24px; font-size: 17px; font-weight: 700; cursor: pointer; margin-bottom: 10px; transition: background .2s, transform .1s; font-family: inherit; letter-spacing: .1px; }
.ln-cta:hover { background: var(--ln-accent-hover); }
.ln-cta:active { transform: scale(.98); }
.ln-ship-note { text-align: center; font-size: 13px; color: var(--ln-muted); margin-bottom: 18px; }

/* Guarantee */
.ln-guarantee { display: flex; align-items: center; gap: 14px; background: var(--ln-accent-tint); border: 1px solid var(--ln-accent-border); border-radius: var(--ln-r-sm); padding: 14px 16px; margin-bottom: 18px; }
.ln-guarantee-icon { font-size: 34px; flex-shrink: 0; }
.ln-guarantee-text h4 { font-size: 14px; font-weight: 700; margin-bottom: 3px; }
.ln-guarantee-text p { font-size: 13px; color: var(--ln-muted); line-height: 1.5; }

/* Hero review */
.ln-hero-review { background: #fff; border: 1px solid var(--ln-border); border-radius: var(--ln-r-sm); padding: 16px; margin-bottom: 18px; }
.ln-hero-review-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.ln-avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--ln-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; flex-shrink: 0; }
.ln-rev-name { font-weight: 700; font-size: 14px; }
.ln-rev-verified { font-size: 12px; color: #16a34a; font-weight: 500; }
.ln-hero-review blockquote { font-size: 14px; line-height: 1.6; font-style: italic; color: var(--ln-text); }

/* Accordions */
.ln-accordions { margin-top: 4px; }
.ln-acc { border-top: 1px solid var(--ln-border); }
.ln-acc-hd {
  padding: 13px 0; cursor: pointer; display: flex; justify-content: space-between;
  align-items: center; font-size: 14px; font-weight: 600; user-select: none;
}
.ln-acc-hd::after { content: '+'; font-size: 20px; color: var(--ln-accent); font-weight: 300; flex-shrink: 0; margin-left: 8px; }
.ln-acc.open .ln-acc-hd::after { content: '−'; }
.ln-acc-body { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.ln-acc.open .ln-acc-body { max-height: 2000px; }
.ln-acc-inner { padding: 0 0 16px; font-size: 14px; color: var(--ln-muted); line-height: 1.75; }
.ln-acc-inner ul { padding-left: 18px; margin: 8px 0; list-style: disc; }
.ln-acc-inner li { margin-bottom: 5px; }

/* ── SHARED SECTION STYLES ──────────────────── */
.ln-sec { padding: 80px 0; }
.ln-sec-sm { padding: 60px 0; }
.ln-sec-hd { text-align: center; margin-bottom: 48px; }
.ln-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ln-accent); margin-bottom: 10px; }
.ln-h2 { font-size: 36px; font-weight: 800; line-height: 1.2; margin: 0 0 12px; }
.ln-h2-white { color: #fff; }
.ln-desc { font-size: 17px; color: var(--ln-muted); max-width: 580px; margin: 0 auto; line-height: 1.7; }

/* ── PROBLEM ────────────────────────────────── */
.ln-problem { background: var(--ln-text); color: #fff; }
.ln-problem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.ln-problem-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #e8c4c0; margin-bottom: 14px; }
.ln-problem h2 { font-size: 36px; font-weight: 800; line-height: 1.2; color: #fff; margin: 0 0 18px; }
.ln-problem p { font-size: 16px; line-height: 1.8; color: rgba(255,255,255,.8); margin-bottom: 14px; }
.ln-problem-list { margin-top: 20px; }
.ln-problem-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: rgba(255,255,255,.88); margin-bottom: 13px; line-height: 1.5; }
.ln-problem-dot { width: 8px; height: 8px; border-radius: 50%; background: #e8c4c0; flex-shrink: 0; margin-top: 7px; }
.ln-problem-img { width: 100%; border-radius: var(--ln-r); }

/* ── BENEFITS ───────────────────────────────── */
.ln-benefits { background: #fff; }
.ln-benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.ln-benefit-card { background: var(--ln-accent-tint); border: 1px solid var(--ln-accent-border); border-radius: var(--ln-r); padding: 28px 24px; transition: box-shadow .2s; }
.ln-benefit-card:hover { box-shadow: 0 4px 20px rgba(89,14,5,.1); }
.ln-benefit-icon { font-size: 34px; margin-bottom: 12px; }
.ln-benefit-title { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
.ln-benefit-desc { font-size: 14px; color: var(--ln-muted); line-height: 1.7; }

/* ── STATS ──────────────────────────────────── */
.ln-stats { background: var(--ln-accent); color: #fff; }
.ln-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; }
.ln-stat-num { font-size: 52px; font-weight: 900; line-height: 1; margin-bottom: 10px; }
.ln-stat-lbl { font-size: 15px; line-height: 1.6; opacity: .88; }

/* ── HOW ────────────────────────────────────── */
.ln-how { background: var(--ln-bg-alt); }
.ln-how-steps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 800px; margin: 0 auto; }
.ln-how-step { text-align: center; padding: 36px 28px; background: #fff; border-radius: var(--ln-r); border: 1px solid var(--ln-border); }
.ln-step-num { width: 54px; height: 54px; background: var(--ln-accent); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; margin: 0 auto 16px; }
.ln-how-step h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; }
.ln-how-step p { font-size: 14px; color: var(--ln-muted); line-height: 1.7; }

/* ── TRUST ──────────────────────────────────── */
.ln-trust { background: #fff; border-top: 1px solid var(--ln-border); border-bottom: 1px solid var(--ln-border); }
.ln-trust-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
.ln-trust-badge { text-align: center; padding: 16px 8px; }
.ln-trust-svg { width: 44px; height: 44px; margin: 0 auto 10px; color: var(--ln-accent); display: block; }
.ln-trust-lbl { font-size: 12px; font-weight: 600; line-height: 1.4; }

/* ── DOCTOR ─────────────────────────────────── */
.ln-doctor { background: var(--ln-accent-tint); }
.ln-doctor-inner { max-width: 760px; margin: 0 auto; text-align: center; }
.ln-doctor-avatar { width: 88px; height: 88px; border-radius: 50%; border: 3px solid var(--ln-accent); object-fit: cover; margin: 0 auto 20px; }
.ln-doctor-badge { display: inline-flex; align-items: center; gap: 5px; background: #e8f5e9; color: #2e7d32; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 20px; margin-bottom: 16px; }
.ln-doctor-inner blockquote { font-size: 20px; line-height: 1.75; font-style: italic; color: var(--ln-text); margin: 0 0 20px; }
.ln-doctor-name { font-size: 16px; font-weight: 700; color: var(--ln-accent); margin-bottom: 4px; }
.ln-doctor-title { font-size: 13px; color: var(--ln-muted); }

/* ── TIMELINE ───────────────────────────────── */
.ln-timeline { background: #fff; }
.ln-tl-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; position: relative; }
.ln-tl-steps::before { content: ''; position: absolute; top: 26px; left: 12.5%; right: 12.5%; height: 2px; background: var(--ln-accent-border); z-index: 0; }
.ln-tl-step { text-align: center; position: relative; z-index: 1; padding: 0 12px; }
.ln-tl-dot { width: 52px; height: 52px; background: var(--ln-accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; border: 4px solid #fff; box-shadow: 0 0 0 2px var(--ln-accent); }
.ln-tl-dot svg { width: 22px; height: 22px; stroke: #fff; fill: none; }
.ln-tl-period { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--ln-accent); margin-bottom: 6px; }
.ln-tl-step h4 { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
.ln-tl-step p { font-size: 13px; color: var(--ln-muted); line-height: 1.6; }

/* ── COMPARISON ─────────────────────────────── */
.ln-compare { background: var(--ln-bg-alt); }
.ln-compare-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--ln-r); overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,.06); }
.ln-compare-table th { padding: 20px 24px; font-size: 15px; font-weight: 700; text-align: center; border-bottom: 2px solid var(--ln-border); }
.ln-compare-table th:first-child { text-align: left; }
.ln-compare-table th.hi { background: var(--ln-accent); color: #fff; }
.ln-compare-table td { padding: 16px 24px; font-size: 14px; border-bottom: 1px solid var(--ln-border); text-align: center; }
.ln-compare-table td:first-child { text-align: left; font-weight: 600; color: var(--ln-muted); }
.ln-compare-table tr:last-child td { border-bottom: none; }
.ln-compare-table td.hi { background: var(--ln-accent-tint); }
.ico-yes { color: #16a34a; font-size: 18px; font-weight: 700; }
.ico-no { color: #ef4444; font-size: 16px; }
.ico-maybe { color: #f59e0b; font-size: 13px; font-weight: 600; }

/* ── OFFER ──────────────────────────────────── */
.ln-offer { background: var(--ln-text); color: #fff; text-align: center; }
.ln-offer-inner { max-width: 640px; margin: 0 auto; }
.ln-offer h2 { font-size: 36px; font-weight: 800; margin-bottom: 12px; }
.ln-offer p { font-size: 17px; color: rgba(255,255,255,.8); line-height: 1.7; margin-bottom: 40px; }
.ln-offer-btn { background: var(--ln-accent); color: #fff; border: 2px solid rgba(255,255,255,.2); border-radius: 50px; padding: 17px 48px; font-size: 17px; font-weight: 700; cursor: pointer; width: 100%; max-width: 420px; font-family: inherit; transition: background .2s; }
.ln-offer-btn:hover { background: var(--ln-accent-hover); }
.ln-offer-note { margin-top: 14px; font-size: 13px; color: rgba(255,255,255,.5); }

/* ── REVIEWS ────────────────────────────────── */
.ln-reviews { background: #fff; }
.ln-reviews-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.ln-rev-card { background: var(--ln-bg-alt); border: 1px solid var(--ln-border); border-radius: var(--ln-r); padding: 22px; }
.ln-rev-card-top { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.ln-rev-card-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--ln-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; flex-shrink: 0; }
.ln-rev-card-name { font-weight: 700; font-size: 14px; }
.ln-rev-card-loc { font-size: 12px; color: var(--ln-muted); }
.ln-rev-stars { color: #f59e0b; font-size: 14px; margin-bottom: 8px; }
.ln-rev-title { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
.ln-rev-text { font-size: 13px; color: var(--ln-muted); line-height: 1.65; }
.ln-rev-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }
.ln-rev-verified { font-size: 11px; color: #16a34a; font-weight: 600; }
.ln-rev-date { font-size: 11px; color: var(--ln-muted); }

/* ── FAQ ────────────────────────────────────── */
.ln-faq { background: var(--ln-accent-tint); }
.ln-faq-list { max-width: 720px; margin: 0 auto; }
.ln-faq-list .ln-acc { border-top: 1px solid var(--ln-accent-border); }
.ln-faq-list .ln-acc:last-child { border-bottom: 1px solid var(--ln-accent-border); }

/* ── FOOTER CTA ─────────────────────────────── */
.ln-footer-cta { background: var(--ln-accent); color: #fff; text-align: center; }
.ln-footer-cta h2 { font-size: 36px; font-weight: 800; margin-bottom: 12px; }
.ln-footer-cta p { font-size: 17px; color: rgba(255,255,255,.85); line-height: 1.7; margin-bottom: 36px; }
.ln-footer-cta-btn { background: #fff; color: var(--ln-accent); border: none; border-radius: 50px; padding: 17px 52px; font-size: 17px; font-weight: 800; cursor: pointer; font-family: inherit; }
.ln-footer-cta-sub { margin-top: 16px; font-size: 13px; color: rgba(255,255,255,.55); }

/* ── FOOTER ─────────────────────────────────── */
.ln-footer { background: var(--ln-text); padding: 44px 0; font-size: 13px; }
.ln-footer-inner { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
.ln-footer-logo { font-size: 20px; font-weight: 800; color: rgba(255,255,255,.85); }
.ln-footer-links { display: flex; gap: 24px; flex-wrap: wrap; justify-content: center; }
.ln-footer-links a { color: rgba(255,255,255,.5); transition: color .2s; }
.ln-footer-links a:hover { color: rgba(255,255,255,.85); }
.ln-footer-disclaimer { max-width: 700px; font-size: 11px; line-height: 1.7; color: rgba(255,255,255,.3); }
.ln-footer-copy { font-size: 12px; color: rgba(255,255,255,.35); }


/* ── STICKY MOBILE CTA ──────────────────────── */

/* ── OVERLAY + CART DRAWER ──────────────────── */
.ln-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 1090; opacity: 0; pointer-events: none; transition: opacity .3s; }
.ln-overlay.open { opacity: 1; pointer-events: all; }
.ln-drawer { position: fixed; top: 0; right: -440px; width: 420px; max-width: 100vw; height: 100vh; background: #fff; z-index: 1100; display: flex; flex-direction: column; transition: right .35s cubic-bezier(.4,0,.2,1); box-shadow: -4px 0 24px rgba(0,0,0,.12); }
.ln-drawer.open { right: 0; }
.ln-drawer-hd { padding: 18px 20px 14px; border-bottom: 1px solid var(--ln-border); display: flex; align-items: center; justify-content: space-between; }
.ln-drawer-hd h3 { font-size: 18px; font-weight: 700; }
.ln-drawer-close { background: none; border: none; font-size: 26px; cursor: pointer; color: var(--ln-muted); padding: 0; line-height: 1; }
.ln-goal { padding: 11px 20px; background: var(--ln-accent-tint); border-bottom: 1px solid var(--ln-accent-border); }
.ln-goal-text { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.ln-goal-bar { background: var(--ln-border); border-radius: 50px; height: 5px; overflow: hidden; }
.ln-goal-fill { background: var(--ln-accent); height: 5px; border-radius: 50px; transition: width .5s; }
.ln-drawer-body { flex: 1; overflow-y: auto; padding: 14px 20px; }
.ln-cart-empty { text-align: center; padding: 60px 20px; color: var(--ln-muted); }
.ln-cart-empty p { margin-bottom: 16px; font-size: 16px; }
