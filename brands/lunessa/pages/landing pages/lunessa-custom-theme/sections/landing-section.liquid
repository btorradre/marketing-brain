    cur = el.dataset.b;
  };

  // ── ADD TO CART (each bundle = own variant, qty=1) ───────────────────────
  window.lnAddToCart = function(){
    var b = B[cur], btn = document.getElementById('heroBtn');
    if(!b){alert('Please select a bundle'); return;}

    // Optimistic: render cart + open drawer instantly using known bundle data
    var optimisticCart = {
      item_count: 1,
      total_price: Math.round(b.price * 100),
      items: [{
        variant_id: b.id,
        title: PRODUCT_NAME,
        variant_title: b.label,
        quantity: 1,
        final_line_price: Math.round(b.price * 100),
        image: THUMB,
        key: String(b.id) + ':1',
        properties: {'_bundle_label':b.label,'_bottles':b.totalBottles+' Bottles','_supply':b.supply}
      }]
    };
    lnRender(optimisticCart);
    lnOpenCart();
    if(btn){btn.textContent='Add to Cart';btn.disabled=false;}

    // Background: clear + add to Shopify cart, then sync render with real data
    fetch('/cart/clear.js', {method:'POST'})
    .then(function(){
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          items: [{
            id: b.id,
            quantity: 1,
            properties: {
              '_bundle_label': b.label,
              '_bottles':      b.totalBottles + ' Bottles',
              '_supply':       b.supply
            }
          }]
        })
      });
    })
    .then(function(r){ return r.json(); })
    .then(function(){ return fetch('/cart.js').then(function(r){return r.json();}); })
    .then(function(cart){ lnRender(cart); })
    .catch(function(e){ console.error('ATC sync error:', e); });
  };

  // ── CART OPEN / CLOSE ────────────────────────────────────────────────────
  window.lnOpenCart = function(){
    document.getElementById('lnDrawer').classList.add('open');
    document.getElementById('lnOverlay').classList.add('open');
    document.body.style.overflow='hidden';
  };
  window.lnCloseCart = function(){
    document.getElementById('lnDrawer').classList.remove('open');
    document.getElementById('lnOverlay').classList.remove('open');
    document.body.style.overflow='';
  };

  // ── RENDER CART ──────────────────────────────────────────────────────────
  function getBundleFromCart(item) {
    // Match by variant ID to determine which bundle this is
    var vid = item.variant_id;
    var bk = Object.keys(B).find(function(k){ return B[k].id === vid; });
    return bk ? B[bk] : null;
  }

  function lnRender(cart){
    var total = (cart.total_price||0)/100;
    var count = cart.item_count||0;

    document.getElementById('lnCartCount').textContent = count;
    var badge = document.getElementById('lnBadge');
    if(badge) badge.textContent = count>0 ? count+' item'+(count!==1?'s':'') : '';

    var gT=document.getElementById('lnGoalTxt'), gF=document.getElementById('lnGoalFill');
    if(total>=SHIP_FREE){
      gT.innerHTML='🎉 <strong>You qualify for FREE shipping!</strong>';
      gF.style.width='100%'; gF.style.background='#16a34a';
    } else {
      gT.textContent='Add $'+(SHIP_FREE-total).toFixed(2)+' more for FREE shipping!';
      gF.style.width=Math.min(total/SHIP_FREE*100,100)+'%'; gF.style.background='';
    }

    var body=document.getElementById('lnDrawerBody'), ft=document.getElementById('lnDrawerFt');
    if(!cart.items||!cart.items.length){
      body.innerHTML='<div class="ln-cart-empty"><p>Your cart is empty</p><button onclick="lnCloseCart()">Shop Now</button></div>';
      ft.style.display='none'; return;
    }

    var html = cart.items.map(function(item){
      var bundle   = getBundleFromCart(item);
      var label    = (item.properties && item.properties['_bundle_label']) || (bundle ? bundle.label : item.variant_title);
      var supply   = (item.properties && item.properties['_supply'])       || (bundle ? bundle.supply : '');
      var bottles  = (item.properties && item.properties['_bottles'])      || (bundle ? bundle.totalBottles+' Bottles' : '');
      var price    = (item.final_line_price/100).toFixed(2);

      return '<div class="ln-cart-item">'+
        '<img class="ln-cart-item-img" src="'+(item.image||THUMB)+'" alt="">'+
        '<div class="ln-cart-item-info">'+
          '<div class="ln-cart-item-name">Lunessa Red Yeast Rice + CoQ10</div>'+
          '<div class="ln-cart-item-var">'+label+'</div>'+
          '<div class="ln-cart-item-supply">'+bottles+' &nbsp;·&nbsp; '+supply+'</div>'+
          '<div class="ln-cart-item-ctrls">'+
            '<span class="ln-cart-item-remove" onclick="lnQty(\''+item.key+'\',0)">Remove</span>'+
          '</div>'+
        '</div>'+
        '<div class="ln-cart-item-price">$'+price+'</div>'+
      '</div>';
    }).join('');

    // Upsell — suggest next tier up based on variant in cart
    var cartBundle = cart.items.length ? getBundleFromCart(cart.items[0]) : null;
    var upsell = '';
    if(cartBundle && cartBundle.totalBottles === 1){
      upsell='<div class="ln-upsell">'+
        '<div class="ln-upsell-title">💡 Buy 2 Get 1 Free — Save More</div>'+
        '<div class="ln-upsell-desc">Upgrade to 90-day supply for just $59.98 — save $29.99.</div>'+
        '<button class="ln-upsell-btn" onclick="lnUpgrade(\'2\')">Upgrade — $59.98</button>'+
      '</div>';
    } else if(cartBundle && cartBundle.totalBottles === 3){
      upsell='<div class="ln-upsell">'+
        '<div class="ln-upsell-title">💡 Buy 3 Get 2 Free — Best Value</div>'+
        '<div class="ln-upsell-desc">Upgrade to 150-day supply for just $89.97 — save $59.98.</div>'+
        '<button class="ln-upsell-btn" onclick="lnUpgrade(\'3\')">Upgrade — $89.97</button>'+
      '</div>';
    }

    body.innerHTML = html + upsell;
    ft.style.display = 'block';

    // Savings calculation vs compare price
    var compare = cart.items.reduce(function(a,i){
      var b = getBundleFromCart(i);
      return a + (b ? b.compare : i.original_line_price/100);
    },0);
    var sav = compare - total;
    document.getElementById('lnSubtotal').textContent = '$'+total.toFixed(2);
    document.getElementById('lnSavings').textContent = sav>0.01 ? '🎉 You\'re saving $'+sav.toFixed(2)+'!' : '';
  }

  window.lnQty = function(key,qty){
    fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:key,quantity:qty})
    }).then(function(r){return r.json();}).then(lnRender);
  };

  // Upgrade: clear cart and add new bundle variant
  window.lnUpgrade = function(bk){
    var b = B[bk];
    fetch('/cart/clear.js',{method:'POST'})
    .then(function(){
      return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({items:[{id:b.id, quantity:1,
          properties:{'_bundle_label':b.label,'_bottles':b.totalBottles+' Bottles','_supply':b.supply}
        }]})
      });
    })
    .then(function(r){return r.json();})
    .then(function(){return fetch('/cart.js').then(function(r){return r.json();});})
    .then(lnRender);
  };
  window.lnScrollToHero = function(){document.querySelector('.ln-hero').scrollIntoView({behavior:'smooth'});};

  // ── CHECKOUT WITH PIXEL ────────────────────────────────────────────────
  window.lnCheckout = function(){
    fetch('/cart.js').then(function(r){return r.json();}).then(function(cart){
      var total = (cart.total_price||0)/100;
      var ids = cart.items.map(function(i){return String(i.variant_id);});
      var bottles = cart.items.reduce(function(a,i){
        var b = getBundleFromCart(i);
        return a + (b ? b.totalBottles : i.quantity);
      },0);
      window.location.href = '/checkout';
    }).catch(function(){ window.location.href = '/checkout'; });
  };



  // Mobile carousel
  window.lnGoTo = function(idx) {
    var track = document.getElementById('lnMobTrack');
    if (track) track.scrollTo({left: idx * track.offsetWidth, behavior: 'smooth'});
    document.querySelectorAll('.ln-mob-dot').forEach(function(d,i){ d.classList.toggle('active', i===idx); });
  };
  var mobTrack = document.getElementById('lnMobTrack');
  if (mobTrack) {
    mobTrack.addEventListener('scroll', function(){
      var idx = Math.round(mobTrack.scrollLeft / mobTrack.offsetWidth);
      document.querySelectorAll('.ln-mob-dot').forEach(function(d,i){ d.classList.toggle('active', i===idx); });
    });
  }

  // Live viewers
  function tick(){var el=document.getElementById('lnViewers');if(el)el.textContent=Math.floor(Math.random()*141)+180;}
  tick(); setInterval(tick,12000);

  // Init cart count
  fetch('/cart.js').then(function(r){return r.json();}).then(function(c){document.getElementById('lnCartCount').textContent=c.item_count||0;}).catch(function(){});
})();
</script>

