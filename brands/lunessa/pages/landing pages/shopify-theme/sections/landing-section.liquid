{% comment %} Lunessa PDP Landing Page — ln- namespace {% endcomment %}

<style>
/* ===== LUNESSA LANDING PAGE ===== */
:root {
  --ln-accent: #590e05;
  --ln-accent-hover: #7a1507;
  --ln-accent-tint: #fdf5f4;
  --ln-accent-border: #e8c4c0;
  --ln-text: #1a1a1a;
  --ln-text-muted: #6b7280;
  --ln-border: #e5e7eb;
  --ln-white: #ffffff;
  --ln-bg-alt: #f9fafb;
  --ln-radius: 16px;
  --ln-radius-sm: 8px;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; overflow-x: hidden; }
.ln-container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

/* TOP BAR */
.ln-topbar { background: var(--ln-accent); color: #fff; text-align: center; padding: 10px 20px; font-size: 13px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-topbar-items { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; }
.ln-topbar-item { display: flex; align-items: center; gap: 5px; }

/* STICKY HEADER */
.ln-header { position: sticky; top: 0; z-index: 999; background: #fff; border-bottom: 1px solid var(--ln-border); padding: 14px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-header-inner { display: flex; align-items: center; justify-content: space-between; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
.ln-logo { font-size: 22px; font-weight: 800; color: var(--ln-accent); letter-spacing: -0.5px; text-decoration: none; }
.ln-cart-btn { background: var(--ln-accent); color: #fff; border: none; border-radius: 50px; padding: 10px 20px; font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-family: inherit; }
.ln-cart-count { background: #fff; color: var(--ln-accent); border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }

/* SOCIAL PROOF STRIP */
.ln-proof-strip { background: var(--ln-accent-tint); border-bottom: 1px solid var(--ln-accent-border); padding: 10px 0; }
.ln-proof-strip-inner { display: flex; justify-content: center; align-items: center; gap: 28px; flex-wrap: wrap; font-size: 13px; color: var(--ln-text-muted); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-proof-strip-item { display: flex; align-items: center; gap: 5px; }
.ln-stars-gold { color: #f59e0b; }

/* HERO */
.ln-hero { padding: 48px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-hero-grid { display: grid; grid-template-columns: 58% 42%; gap: 40px; align-items: start; max-width: 1280px; margin: 0 auto; padding: 0 24px; }

/* Gallery */
.ln-gallery { position: sticky; top: 90px; }
.ln-gallery-main { width: 100%; border-radius: var(--ln-radius); overflow: hidden; background: #f9f9f9; min-height: 400px; display: flex; align-items: center; justify-content: center; }
.ln-gallery-main img { width: 100%; height: auto; display: block; }
.ln-thumbs { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
.ln-thumb { width: 80px; height: 80px; border-radius: 8px; overflow: hidden; border: 2px solid transparent; cursor: pointer; transition: border-color 0.2s; flex-shrink: 0; }
.ln-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ln-thumb.active, .ln-thumb:hover { border-color: var(--ln-accent); }

/* Hero content */
.ln-badge-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
.ln-rating-badge { display: flex; align-items: center; gap: 6px; background: var(--ln-accent-tint); border: 1px solid var(--ln-accent-border); border-radius: 50px; padding: 5px 14px; font-size: 13px; font-weight: 600; color: var(--ln-accent); }
.ln-viewers { font-size: 12px; color: var(--ln-text-muted); }
.ln-viewers span { color: var(--ln-accent); font-weight: 600; }
.ln-hero-h1 { font-size: 32px; font-weight: 800; line-height: 1.2; color: var(--ln-text); margin: 0 0 14px; }
.ln-hero-subtitle { font-size: 16px; color: var(--ln-text-muted); line-height: 1.7; margin: 0 0 22px; }
.ln-benefits-list { list-style: none; padding: 0; margin: 0 0 26px; }
.ln-benefits-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; color: var(--ln-text); margin-bottom: 10px; line-height: 1.5; }
.ln-check { width: 20px; height: 20px; border-radius: 50%; background: var(--ln-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; flex-shrink: 0; margin-top: 1px; }

/* Bundle selector */
.ln-bundle-label { font-size: 13px; font-weight: 700; color: var(--ln-text); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px; }
.ln-bundle-selector { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
.ln-bundle-option { position: relative; border: 2px solid var(--ln-border); border-radius: var(--ln-radius-sm); padding: 14px 48px 14px 16px; cursor: pointer; transition: all 0.2s; display: block; }
.ln-bundle-option:hover { border-color: var(--ln-accent); }
.ln-bundle-option.ln-selected { border-color: var(--ln-accent); background: var(--ln-accent-tint); }
.ln-bundle-option input[type="radio"] { position: absolute; opacity: 0; width: 0; height: 0; }
.ln-bundle-top-row { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
.ln-bundle-name { font-size: 15px; font-weight: 700; color: var(--ln-text); }
.ln-bundle-badge { border-radius: 50px; padding: 2px 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #fff; }
.ln-bundle-badge-popular { background: var(--ln-accent); }
.ln-bundle-badge-value { background: #16a34a; }
.ln-bundle-supply { font-size: 13px; color: var(--ln-text-muted); margin-bottom: 6px; }
.ln-bundle-price-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.ln-bundle-current-price { font-size: 20px; font-weight: 800; color: var(--ln-accent); }
.ln-bundle-compare-price { font-size: 14px; color: var(--ln-text-muted); text-decoration: line-through; }
.ln-bundle-save-tag { background: #dcfce7; color: #16a34a; border-radius: 50px; padding: 2px 8px; font-size: 12px; font-weight: 700; }
.ln-bundle-per-unit { font-size: 12px; color: var(--ln-text-muted); margin-top: 4px; }
.ln-bundle-radio-circle { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--ln-border); transition: all 0.2s; flex-shrink: 0; }
.ln-bundle-option.ln-selected .ln-bundle-radio-circle { border-color: var(--ln-accent); background: var(--ln-accent); box-shadow: inset 0 0 0 4px #fff; }

/* CTA */
.ln-cta-btn { width: 100%; background: var(--ln-accent); color: #fff; border: none; border-radius: 50px; padding: 18px 24px; font-size: 17px; font-weight: 700; cursor: pointer; margin-bottom: 10px; transition: background 0.2s, transform 0.1s; font-family: inherit; letter-spacing: 0.2px; }
.ln-cta-btn:hover { background: var(--ln-accent-hover); }
.ln-cta-btn:active { transform: scale(0.98); }
.ln-ship-note { text-align: center; font-size: 13px; color: var(--ln-text-muted); margin-bottom: 18px; }

/* Guarantee box */
.ln-guarantee-box { display: flex; align-items: center; gap: 14px; background: var(--ln-accent-tint); border: 1px solid var(--ln-accent-border); border-radius: var(--ln-radius-sm); padding: 14px 16px; margin-bottom: 20px; }
.ln-guarantee-icon { font-size: 36px; flex-shrink: 0; }
.ln-guarantee-text h4 { font-size: 14px; font-weight: 700; color: var(--ln-text); margin: 0 0 3px; }
.ln-guarantee-text p { font-size: 13px; color: var(--ln-text-muted); margin: 0; line-height: 1.5; }

/* Hero review card */
.ln-hero-review { background: #fff; border: 1px solid var(--ln-border); border-radius: var(--ln-radius-sm); padding: 16px; margin-bottom: 20px; }
.ln-hero-review-top { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.ln-review-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--ln-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; flex-shrink: 0; }
.ln-review-name { font-weight: 700; font-size: 14px; color: var(--ln-text); }
.ln-review-verified { font-size: 12px; color: #16a34a; font-weight: 500; }
.ln-hero-review-text { font-size: 14px; color: var(--ln-text); line-height: 1.6; font-style: italic; }

/* Accordions */
.ln-hero-accordions { margin-top: 4px; }
.ln-accordion-item { border-top: 1px solid var(--ln-border); }
.ln-accordion-header { padding: 14px 0; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--ln-text); display: flex; justify-content: space-between; align-items: center; user-select: none; }
.ln-accordion-header::after { content: "+"; font-size: 20px; color: var(--ln-accent); font-weight: 300; flex-shrink: 0; margin-left: 8px; }
.ln-accordion-item.open .ln-accordion-header::after { content: "\2212"; }
.ln-accordion-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
.ln-accordion-item.open .ln-accordion-body { max-height: 2000px; }
.ln-accordion-body-inner { padding: 0 0 16px; font-size: 14px; color: var(--ln-text-muted); line-height: 1.7; }
.ln-accordion-body-inner ul { margin: 8px 0; padding-left: 18px; }
.ln-accordion-body-inner li { margin-bottom: 6px; }

/* SECTIONS SHARED */
.ln-section { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-section-header { text-align: center; margin-bottom: 48px; }
.ln-section-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ln-accent); margin-bottom: 12px; }
.ln-section-h2 { font-size: 36px; font-weight: 800; line-height: 1.2; color: var(--ln-text); margin: 0 0 14px; }
.ln-section-sub { font-size: 17px; color: var(--ln-text-muted); max-width: 580px; margin: 0 auto; line-height: 1.7; }

/* PROBLEM SECTION */
.ln-problem { padding: 80px 0; background: var(--ln-text); color: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-problem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.ln-problem-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #e8c4c0; margin-bottom: 16px; }
.ln-problem-h2 { font-size: 36px; font-weight: 800; line-height: 1.2; margin: 0 0 20px; color: #fff; }
.ln-problem-text { font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.8); margin: 0 0 16px; }
.ln-problem-img { width: 100%; border-radius: var(--ln-radius); display: block; }
.ln-problem-list { list-style: none; padding: 0; margin: 24px 0 0; }
.ln-problem-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: rgba(255,255,255,0.88); margin-bottom: 14px; line-height: 1.5; }
.ln-problem-dot { width: 8px; height: 8px; border-radius: 50%; background: #e8c4c0; flex-shrink: 0; margin-top: 7px; }

/* BENEFITS */
.ln-benefits { padding: 80px 0; background: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.ln-benefit-card { background: var(--ln-accent-tint); border: 1px solid var(--ln-accent-border); border-radius: var(--ln-radius); padding: 28px 24px; transition: box-shadow 0.2s; }
.ln-benefit-card:hover { box-shadow: 0 4px 20px rgba(89,14,5,0.1); }
.ln-benefit-icon { font-size: 36px; margin-bottom: 14px; }
.ln-benefit-title { font-size: 16px; font-weight: 700; color: var(--ln-text); margin-bottom: 8px; }
.ln-benefit-desc { font-size: 14px; color: var(--ln-text-muted); line-height: 1.7; }

/* STATS */
.ln-stats { padding: 70px 0; background: var(--ln-accent); color: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; }
.ln-stat-number { font-size: 52px; font-weight: 900; line-height: 1; margin-bottom: 10px; }
.ln-stat-label { font-size: 15px; line-height: 1.6; opacity: 0.88; }

/* HOW IT WORKS */
.ln-how { padding: 80px 0; background: var(--ln-bg-alt); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-how-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.ln-how-step { text-align: center; padding: 36px 28px; background: #fff; border-radius: var(--ln-radius); border: 1px solid var(--ln-border); }
.ln-how-num { width: 54px; height: 54px; background: var(--ln-accent); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; margin: 0 auto 18px; font-family: inherit; }
.ln-how-title { font-size: 18px; font-weight: 700; color: var(--ln-text); margin-bottom: 12px; }
.ln-how-desc { font-size: 14px; color: var(--ln-text-muted); line-height: 1.7; }

/* TRUST BADGES */
.ln-trust { padding: 60px 0; background: #fff; border-top: 1px solid var(--ln-border); border-bottom: 1px solid var(--ln-border); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-trust-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
.ln-trust-badge { text-align: center; padding: 16px 8px; }
.ln-trust-svg { width: 44px; height: 44px; margin: 0 auto 10px; color: var(--ln-accent); display: block; }
.ln-trust-label { font-size: 12px; font-weight: 600; color: var(--ln-text); line-height: 1.4; }

/* DOCTOR QUOTE */
.ln-doctor { padding: 80px 0; background: var(--ln-accent-tint); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-doctor-inner { max-width: 760px; margin: 0 auto; text-align: center; }
.ln-doctor-avatar { width: 88px; height: 88px; border-radius: 50%; border: 3px solid var(--ln-accent); margin: 0 auto 22px; background: var(--ln-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 800; }
.ln-doctor-quote { font-size: 20px; line-height: 1.75; color: var(--ln-text); font-style: italic; margin: 0 0 22px; }
.ln-doctor-name { font-size: 16px; font-weight: 700; color: var(--ln-accent); margin-bottom: 4px; }
.ln-doctor-title { font-size: 13px; color: var(--ln-text-muted); }

/* TIMELINE */
.ln-timeline { padding: 80px 0; background: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-timeline-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; position: relative; }
.ln-timeline-steps::before { content: ''; position: absolute; top: 26px; left: 12.5%; right: 12.5%; height: 2px; background: var(--ln-accent-border); z-index: 0; }
.ln-timeline-step { text-align: center; position: relative; z-index: 1; padding: 0 14px; }
.ln-timeline-dot { width: 52px; height: 52px; background: var(--ln-accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; border: 4px solid #fff; box-shadow: 0 0 0 2px var(--ln-accent); }
.ln-timeline-dot svg { width: 22px; height: 22px; stroke: #fff; }
.ln-timeline-period { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--ln-accent); margin-bottom: 8px; }
.ln-timeline-title { font-size: 15px; font-weight: 700; color: var(--ln-text); margin-bottom: 8px; }
.ln-timeline-desc { font-size: 13px; color: var(--ln-text-muted); line-height: 1.6; }

/* COMPARISON */
.ln-comparison { padding: 80px 0; background: var(--ln-bg-alt); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-comparison-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--ln-radius); overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
.ln-comparison-table th { padding: 20px 24px; font-size: 15px; font-weight: 700; text-align: center; border-bottom: 2px solid var(--ln-border); }
.ln-comparison-table th:first-child { text-align: left; }
.ln-comparison-table th.ln-col-hi { background: var(--ln-accent); color: #fff; }
.ln-comparison-table td { padding: 16px 24px; font-size: 14px; color: var(--ln-text); border-bottom: 1px solid var(--ln-border); text-align: center; }
.ln-comparison-table td:first-child { text-align: left; font-weight: 600; color: var(--ln-text-muted); }
.ln-comparison-table tr:last-child td { border-bottom: none; }
.ln-comparison-table .ln-col-hi { background: var(--ln-accent-tint); }
.ln-yes { color: #16a34a; font-size: 18px; font-weight: 700; }
.ln-no { color: #ef4444; font-size: 16px; }
.ln-sometimes { color: #f59e0b; font-size: 13px; font-weight: 600; }

/* OFFER */
.ln-offer { padding: 80px 0; background: var(--ln-text); color: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-offer-inner { text-align: center; max-width: 640px; margin: 0 auto; }
.ln-offer h2 { font-size: 36px; font-weight: 800; margin: 0 0 14px; }
.ln-offer-sub { font-size: 17px; color: rgba(255,255,255,0.8); margin: 0 0 40px; line-height: 1.7; }
.ln-offer-btn { background: var(--ln-accent); color: #fff; border: 2px solid rgba(255,255,255,0.2); border-radius: 50px; padding: 18px 48px; font-size: 17px; font-weight: 700; cursor: pointer; width: 100%; max-width: 420px; font-family: inherit; transition: background 0.2s; }
.ln-offer-btn:hover { background: var(--ln-accent-hover); }
.ln-offer-guarantee { margin-top: 16px; font-size: 13px; color: rgba(255,255,255,0.55); }

/* REVIEWS */
.ln-reviews { padding: 80px 0; background: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-reviews-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.ln-review-card { background: var(--ln-bg-alt); border: 1px solid var(--ln-border); border-radius: var(--ln-radius); padding: 24px; }
.ln-review-card-top { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.ln-review-card-avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--ln-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; flex-shrink: 0; }
.ln-review-card-name { font-weight: 700; font-size: 14px; color: var(--ln-text); }
.ln-review-card-loc { font-size: 12px; color: var(--ln-text-muted); }
.ln-review-stars { color: #f59e0b; font-size: 14px; margin-bottom: 10px; }
.ln-review-title { font-size: 14px; font-weight: 700; color: var(--ln-text); margin-bottom: 8px; }
.ln-review-text { font-size: 13px; color: var(--ln-text-muted); line-height: 1.65; }
.ln-review-verified { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #16a34a; margin-top: 12px; font-weight: 600; }
.ln-review-date { font-size: 11px; color: var(--ln-text-muted); margin-top: 3px; }

/* FAQ */
.ln-faq { padding: 80px 0; background: var(--ln-accent-tint); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-faq-list { max-width: 720px; margin: 0 auto; }
.ln-faq-list .ln-accordion-item { border-top: 1px solid var(--ln-accent-border); }
.ln-faq-list .ln-accordion-item:last-child { border-bottom: 1px solid var(--ln-accent-border); }

/* FOOTER CTA */
.ln-footer-cta { padding: 80px 0; background: var(--ln-accent); color: #fff; text-align: center; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-footer-cta h2 { font-size: 36px; font-weight: 800; margin: 0 0 14px; }
.ln-footer-cta p { font-size: 17px; color: rgba(255,255,255,0.85); margin: 0 0 36px; line-height: 1.7; }
.ln-footer-cta-btn { display: inline-block; background: #fff; color: var(--ln-accent); border: none; border-radius: 50px; padding: 18px 52px; font-size: 17px; font-weight: 800; cursor: pointer; font-family: inherit; transition: opacity 0.2s; }
.ln-footer-cta-btn:hover { opacity: 0.92; }
.ln-footer-cta-sub { margin-top: 18px; font-size: 13px; color: rgba(255,255,255,0.6); }

/* FOOTER */
.ln-footer { background: var(--ln-text); color: rgba(255,255,255,0.5); padding: 44px 0; font-size: 13px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.ln-footer-inner { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
.ln-footer-logo { font-size: 20px; font-weight: 800; color: rgba(255,255,255,0.85); }
.ln-footer-links { display: flex; gap: 24px; flex-wrap: wrap; justify-content: center; }
.ln-footer-links a { color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s; }
.ln-footer-links a:hover { color: rgba(255,255,255,0.85); }
.ln-footer-disclaimer { max-width: 700px; font-size: 11px; line-height: 1.7; color: rgba(255,255,255,0.3); }

/* STICKY MOBILE CTA */
.ln-sticky-cta { position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000; background: #fff; border-top: 2px solid var(--ln-accent); padding: 12px 16px; display: none; align-items: center; gap: 12px; justify-content: space-between; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; box-shadow: 0 -4px 16px rgba(0,0,0,0.1); }
.ln-sticky-cta.ln-visible { display: flex; }
