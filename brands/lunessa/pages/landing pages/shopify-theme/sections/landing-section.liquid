      <div>© 2026 Lunessa. All rights reserved.</div>
    </div>
  </div>
</footer>

<!-- STICKY MOBILE CTA -->
<div class="ln-sticky-cta" id="lnStickyCta">
  <div>
    <div class="ln-sticky-info">Lunessa Gummies</div>
    <div class="ln-sticky-price">From $24.99/bottle · Save up to 50%</div>
  </div>
  <button class="ln-sticky-btn" onclick="lnAddToCart()">Add to Cart</button>
</div>

<!-- OVERLAY -->
<div class="ln-overlay" id="lnOverlay" onclick="lnCloseCart()"></div>

<!-- CART DRAWER -->
<div class="ln-cart-drawer" id="lnCartDrawer">
  <div class="ln-cart-header">
    <h3>Your Cart <span id="lnCartBadge" style="background:var(--ln-accent);color:#fff;border-radius:50px;padding:2px 9px;font-size:13px;margin-left:4px;"></span></h3>
    <button class="ln-cart-close" onclick="lnCloseCart()">×</button>
  </div>
  <div class="ln-cart-goal">
    <div class="ln-cart-goal-text" id="lnGoalText">Add more for FREE shipping!</div>
    <div class="ln-cart-goal-bar"><div class="ln-cart-goal-fill" id="lnGoalFill" style="width:0%"></div></div>
  </div>
  <div class="ln-cart-body" id="lnCartBody">
    <div class="ln-cart-empty">
      <p>Your cart is empty</p>
      <button onclick="lnCloseCart()">Shop Now</button>
    </div>
  </div>
  <div class="ln-cart-footer" id="lnCartFooter" style="display:none;">
    <div class="ln-cart-subtotal">
      <span>Subtotal</span>
      <span id="lnSubtotal">$0.00</span>
    </div>
    <div class="ln-cart-savings" id="lnCartSavings"></div>
    <button class="ln-cart-checkout" onclick="window.location.href='/checkout'">Checkout — Secure & Safe 🔒</button>
    <span class="ln-cart-continue" onclick="lnCloseCart()">Continue Shopping</span>
    <div class="ln-cart-secure">🔒 SSL Encrypted &nbsp;·&nbsp; Safe & Secure Checkout</div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var LN_BUNDLES = {
    '1': { variantId: 47459960094978, price: 34.99, compare: 49.99, per: 34.99, bottles: 1, label: '1 Bottle — Starter', supply: '30-Day Supply' },
    '3': { variantId: 47459960127746, price: 89.97, compare: 149.97, per: 29.99, bottles: 3, label: '3 Bottles — Most Popular', supply: '90-Day Supply' },
    '6': { variantId: 47459960160514, price: 149.94, compare: 299.94, per: 24.99, bottles: 6, label: '6 Bottles — Best Value', supply: '180-Day Supply' }
  };

  var lnCurrentBundle = '3';
  var FREE_SHIP_THRESHOLD = 89.97;
  var PRODUCT_IMG = 'https://cdn.shopify.com/s/files/1/0808/3885/2866/files/product_image_1.jpg?v=1773239617';

  // Image gallery
  window.lnSwapImg = function(el, src) {
    document.getElementById('lnMainImg').src = src;
    document.querySelectorAll('.ln-thumb').forEach(function(t) { t.classList.remove('active'); });
    el.classList.add('active');
  };

  // Bundle selection
  window.lnSelectBundle = function(el) {
    document.querySelectorAll('.ln-bundle-option').forEach(function(o) { o.classList.remove('ln-selected'); });
    el.classList.add('ln-selected');
    el.querySelector('input[type="radio"]').checked = true;
    lnCurrentBundle = el.dataset.bundle;
  };

  // Add to cart
  window.lnAddToCart = function() {
    var bundle = LN_BUNDLES[lnCurrentBundle];
    var btn = document.getElementById('heroAddToCart');
    if (btn) { btn.textContent = 'Adding...'; btn.disabled = true; }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: bundle.variantId, quantity: 1 }] })
    })
    .then(function(r) { return r.json(); })
    .then(function() { return fetch('/cart.js').then(function(r) { return r.json(); }); })
    .then(function(cart) {
      lnRenderCart(cart);
      lnOpenCart();
      if (btn) { btn.textContent = 'Add to Cart — Get Started Today'; btn.disabled = false; }
    })
    .catch(function() {
      if (btn) { btn.textContent = 'Add to Cart — Get Started Today'; btn.disabled = false; }
    });
  };

  // Cart drawer
  window.lnOpenCart = function() {
    document.getElementById('lnCartDrawer').classList.add('open');
    document.getElementById('lnOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    fetch('/cart.js').then(function(r) { return r.json(); }).then(lnRenderCart).catch(function(){});
  };

  window.lnCloseCart = function() {
    document.getElementById('lnCartDrawer').classList.remove('open');
    document.getElementById('lnOverlay').classList.remove('open');
    document.body.style.overflow = '';
  };

  function lnRenderCart(cart) {
    var count = cart.item_count || 0;
    var total = (cart.total_price || 0) / 100;

    // Count badge
    document.getElementById('lnCartCount').textContent = count;
    var badge = document.getElementById('lnCartBadge');
    if (badge) badge.textContent = count > 0 ? count + ' item' + (count !== 1 ? 's' : '') : '';

    // Shipping goal
    var goalText = document.getElementById('lnGoalText');
    var goalFill = document.getElementById('lnGoalFill');
    if (total >= FREE_SHIP_THRESHOLD) {
      goalText.innerHTML = '🎉 <strong>You qualify for FREE shipping!</strong>';
      goalFill.style.width = '100%';
      goalFill.style.background = '#16a34a';
    } else {
      var rem = (FREE_SHIP_THRESHOLD - total).toFixed(2);
      goalText.textContent = 'Add $' + rem + ' more for FREE shipping!';
      goalFill.style.width = Math.min((total / FREE_SHIP_THRESHOLD) * 100, 100) + '%';
      goalFill.style.background = '';
    }

    var body = document.getElementById('lnCartBody');
    var footer = document.getElementById('lnCartFooter');

    if (!cart.items || cart.items.length === 0) {
      body.innerHTML = '<div class="ln-cart-empty"><p>Your cart is empty</p><button onclick="lnCloseCart()">Shop Now</button></div>';
      footer.style.display = 'none';
      return;
    }

    var itemsHtml = cart.items.map(function(item) {
      var price = (item.final_line_price / 100).toFixed(2);
      var bKey = Object.keys(LN_BUNDLES).find(function(k) { return LN_BUNDLES[k].variantId == item.variant_id; });
      var supply = bKey ? LN_BUNDLES[bKey].supply : (item.variant_title || '');
      return [
        '<div class="ln-cart-item">',
          '<img class="ln-cart-item-img" src="' + (item.image || PRODUCT_IMG) + '" alt="' + item.product_title + '">',
          '<div class="ln-cart-item-info">',
            '<div class="ln-cart-item-name">' + item.product_title + '</div>',
            '<div class="ln-cart-item-variant">' + item.variant_title + '</div>',
            '<div class="ln-cart-item-supply">' + supply + '</div>',
            '<div class="ln-cart-item-controls">',
              '<button class="ln-qty-btn" onclick="lnChangeQty(\'' + item.key + '\',' + (item.quantity-1) + ')">−</button>',
              '<span class="ln-qty-val">' + item.quantity + '</span>',
              '<button class="ln-qty-btn" onclick="lnChangeQty(\'' + item.key + '\',' + (item.quantity+1) + ')">+</button>',
              '<span class="ln-cart-item-remove" onclick="lnChangeQty(\'' + item.key + '\',0)">Remove</span>',
            '</div>',
          '</div>',
          '<div class="ln-cart-item-price">$' + price + '</div>',
        '</div>'
      ].join('');
    }).join('');

    // Upsell
    var upsell = '';
    var has1 = cart.items.some(function(i) { return i.variant_id == LN_BUNDLES['1'].variantId; });
    var has3 = cart.items.some(function(i) { return i.variant_id == LN_BUNDLES['3'].variantId; });
    if (has1) {
      upsell = '<div class="ln-cart-upsell"><div class="ln-cart-upsell-title">💡 Save more with the 3-Bottle Bundle</div><div class="ln-cart-upsell-desc">Upgrade to a 90-day supply and save 40% vs. the single bottle. Most popular for a reason.</div><button class="ln-cart-upsell-btn" onclick="lnUpgrade(\'3\')">Upgrade to 3 Bottles — $89.97</button></div>';
    } else if (has3) {
      upsell = '<div class="ln-cart-upsell"><div class="ln-cart-upsell-title">💡 Best value: 6-Bottle Bundle</div><div class="ln-cart-upsell-desc">Upgrade to 180 days and save 50%. Perfect if you\'ve seen results and want to keep going.</div><button class="ln-cart-upsell-btn" onclick="lnUpgrade(\'6\')">Upgrade to 6 Bottles — $149.94</button></div>';
    }

    body.innerHTML = itemsHtml + upsell;
    footer.style.display = 'block';

    // Subtotal + savings
    var origTotal = cart.items.reduce(function(acc, item) {
      var bKey = Object.keys(LN_BUNDLES).find(function(k) { return LN_BUNDLES[k].variantId == item.variant_id; });
      return acc + (bKey ? LN_BUNDLES[bKey].compare * item.quantity : item.original_line_price / 100);
    }, 0);
    var savings = origTotal - total;
    document.getElementById('lnSubtotal').textContent = '$' + total.toFixed(2);
    var savEl = document.getElementById('lnCartSavings');
    savEl.textContent = savings > 0.01 ? '🎉 You\'re saving $' + savings.toFixed(2) + '!' : '';
  }

  window.lnChangeQty = function(key, qty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(function(r) { return r.json(); })
    .then(lnRenderCart);
  };

  window.lnUpgrade = function(bundleKey) {
    var bundle = LN_BUNDLES[bundleKey];
    fetch('/cart/clear.js', { method: 'POST' })
    .then(function() {
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: bundle.variantId, quantity: 1 }] })
      });
    })
    .then(function(r) { return r.json(); })
    .then(function() { return fetch('/cart.js').then(function(r) { return r.json(); }); })
    .then(lnRenderCart);
  };

  // Scroll to hero
  window.lnScrollToHero = function() {
    var hero = document.querySelector('.ln-hero');
    if (hero) hero.scrollIntoView({ behavior: 'smooth' });
  };

  // Sticky CTA
  var heroBtn = document.getElementById('heroAddToCart');
  if (heroBtn && window.IntersectionObserver) {
    new IntersectionObserver(function(entries) {
      var sticky = document.getElementById('lnStickyCta');
      if (!sticky) return;
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          sticky.classList.remove('ln-visible');
          document.body.classList.remove('ln-has-sticky');
        } else {
          sticky.classList.add('ln-visible');
          document.body.classList.add('ln-has-sticky');
        }
      });
    }, { threshold: 0 }).observe(heroBtn);
  }

  // Live viewer count
  function updateViewers() {
    var el = document.getElementById('lnViewers');
    if (el) el.textContent = Math.floor(Math.random() * 141) + 180;
  }
  updateViewers();
  setInterval(updateViewers, 12000);

  // Init cart count on load
  fetch('/cart.js')
    .then(function(r) { return r.json(); })
    .then(function(cart) {
      document.getElementById('lnCartCount').textContent = cart.item_count || 0;
    })
    .catch(function(){});

})();
</script>

