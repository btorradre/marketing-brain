{% doc %}
Renders a product card with studio imagery and variant links.
@param {product} product - Product to render
@param {boolean} [eager] - Whether to load the primary image eagerly
@param {boolean} [show_swatches] - Show color thumbnails
{% enddoc %}
{%- liquid
  assign card_image = product.featured_image
  assign card_title = product.title
  case product.handle
    when 'velantra-vivienne'
      assign card_title = 'Vivienne'
    when 'velantra-juliette'
      assign card_title = 'Juliette'
    when 'velantra-delphine'
      assign card_title = 'Delphine'
    when 'the-colette-wool-tote'
      assign card_title = 'Colette'
    when 'velantra-weekender', 'the-eleanor-weekender'
      assign card_title = 'Eleanor'
    when 'velantra-margot-tote'
      assign card_title = 'Meridian'
    when 'velantra-boat-tote-2'
      assign card_title = 'Camille'
  endcase
  assign card_loading = 'lazy'
  if eager
    assign card_loading = 'eager'
  endif
-%}
{%- capture card_studio -%}{%- render 'studio-image-url', image: card_image, product: product -%}{%- endcapture -%}
{%- assign card_studio = card_studio | strip -%}
<article class="product-card" data-product-id="{{ product.id }}">
  <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if card_studio != blank -%}
      <img src="{{ card_studio }}" alt="{{ product.title | escape }}" width="1200" height="1500" loading="{{ card_loading }}">
    {%- elsif card_image -%}
      {{ card_image | image_url: width: 1200 | image_tag: loading: card_loading, widths: '360,540,720,960,1200', sizes: '(min-width: 1000px) 25vw, 50vw', alt: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
    {%- endif -%}
    {%- unless product.available -%}<span class="product-card__badge eyebrow">{{ 'commerce.product.sold_out' | t }}</span>{%- endunless -%}
  </a>
  <div class="product-card__info">
    <div class="product-card__heading">
      <h3><a href="{{ product.url }}" aria-label="{{ product.title | escape }}">{{ card_title | escape }}</a></h3>
      <p class="product-card__price{% if product.price == 0 %} product-card__price--availability{% endif %}">
        {%- render 'product-price', product: product -%}
      </p>
    </div>
    {%- if show_swatches != false and product.has_only_default_variant == false -%}
      <div class="product-card__swatches">
        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- if option_name == 'color' or option_name == 'colour' -%}
            {%- assign option_index = option.position | minus: 1 -%}
            {%- for value in option.values limit: 6 -%}
              {%- assign value_name = value.name | default: value -%}
              {%- assign swatch_variant = nil -%}
              {%- for variant in product.variants -%}{%- if variant.options[option_index] == value_name -%}{%- assign swatch_variant = variant -%}{%- break -%}{%- endif -%}{%- endfor -%}
              {%- if swatch_variant.featured_image -%}
                {%- capture swatch_studio -%}{%- render 'studio-image-url', image: swatch_variant.featured_image, product: product -%}{%- endcapture -%}
                {%- assign swatch_studio = swatch_studio | strip -%}
                <a href="{{ product.url }}?variant={{ swatch_variant.id }}" aria-label="{{ product.title | escape }} — {{ value | escape }}" title="{{ value | escape }}">
                  {%- if swatch_studio != blank -%}<img src="{{ swatch_studio }}" alt="{{ value | escape }}" width="72" height="90" loading="lazy">
                  {%- else -%}{{ swatch_variant.featured_image | image_url: width: 90 | image_tag: loading: 'lazy', alt: value }}{%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
            {%- if option.values.size > 6 -%}<a class="product-card__more" href="{{ product.url }}">+{{ option.values.size | minus: 6 }}</a>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>
