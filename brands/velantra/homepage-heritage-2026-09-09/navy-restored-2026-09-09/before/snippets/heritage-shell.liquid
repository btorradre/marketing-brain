{% doc %}
Shared heritage header, service strip and footer treatment.
{% enddoc %}
<div class="heritage-service"><a href="{{ shop.shipping_policy.url }}">{{ 'heritage.shipping' | t }}</a><span>{{ 'heritage.signature' | t }}</span><button type="button" data-dialog-open="LocaleDialog">{{ localization.country.iso_code }} / {{ localization.language.iso_code | upcase }}</button></div>
<style>
body.heritage-site{--heritage-navy:#000000;--heritage-cream:#f7f5ef;background:var(--heritage-cream)}.heritage-site .heritage-service{height:32px;background:var(--heritage-navy);color:#fff;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 28px;gap:20px;font-size:10px;line-height:1.5;letter-spacing:.04em}.heritage-service>a{justify-self:start;text-decoration:underline;text-underline-offset:3px}.heritage-service>span{font-size:10px;letter-spacing:.13em;text-transform:uppercase}.heritage-service>button{justify-self:end;min-width:44px;height:32px}.heritage-site .site-header{position:absolute;top:32px;left:0;right:0;background:transparent;color:#fff;height:92px;padding:0 28px;grid-template-columns:230px 1fr 230px;gap:24px;z-index:30;border-bottom:1px solid rgba(255,255,255,.18)}.heritage-site .header-left{grid-column:2;grid-row:1;justify-self:center}.heritage-site .site-header>.wordmark{grid-column:1;grid-row:1;justify-self:start;font-size:34px;letter-spacing:.17em}.heritage-site .header-right{grid-column:3;grid-row:1;gap:24px}.heritage-site .desktop-nav{gap:28px}.heritage-site .site-header .micro{font-size:10px;letter-spacing:.1em}.heritage-site .site-header.is-heritage-scrolled{position:sticky;top:0;background:var(--heritage-cream);color:var(--heritage-navy);height:72px;border-color:#e1ddd5;box-shadow:0 1px 6px #00000008}.heritage-site .site-header:hover{background:var(--heritage-cream);color:var(--heritage-navy)}.heritage-site #MainContent{margin:0;padding:0}.heritage-site .service-promises{background:var(--heritage-cream);border-top:1px solid #dedad0;color:var(--heritage-navy);padding-top:38px;padding-bottom:38px}.heritage-site .service-promises .promise-number{display:none}.heritage-site .service-promises h3{font-size:12px;letter-spacing:.08em}.heritage-site .service-promises p{font-size:12px}.heritage-site .newsletter{max-width:none;background:var(--heritage-cream);padding:54px 24px 64px;border-top:1px solid #dedad0;color:var(--heritage-navy)}.heritage-site .newsletter h2{font-size:36px}.heritage-site .newsletter>div{font-size:13px}.heritage-site .newsletter form{max-width:510px;margin:auto}.heritage-site .newsletter-input input{font-size:16px;min-height:48px}.heritage-site .newsletter-input button{font-size:11px;min-height:48px}.heritage-site .newsletter-consent{font-size:11px}.heritage-site .site-footer{background:var(--heritage-navy);color:#fff;border-color:#ffffff30}.heritage-site .site-footer .footer-bottom{border-color:#ffffff30}.heritage-site .site-footer .footer-column a{font-size:12px;line-height:1.6;min-height:32px;display:flex;align-items:center}.heritage-site .site-footer .footer-column h2{font-size:12px}.heritage-site .site-footer .footer-brand .rte{font-size:13px;line-height:1.7}.heritage-site .site-footer .footer-email{font-size:12px}.heritage-site .site-footer .wordmark{font-size:38px}.heritage-site .site-footer .payment-icons{opacity:.8}.heritage-site .skip-link{z-index:1000}.heritage-site a:focus-visible,.heritage-site button:focus-visible{outline:2px solid currentColor;outline-offset:4px}
@media(max-width:1100px){.heritage-site .site-header{grid-template-columns:1fr auto 1fr;padding:0 22px;gap:16px}.heritage-site .header-left{grid-column:1;justify-self:start}.heritage-site .site-header>.wordmark{grid-column:2;justify-self:center}.heritage-site .header-right{grid-column:3;justify-self:end}.heritage-site .site-header .mobile-menu{min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center}}
@media(max-width:767px){.heritage-site .heritage-service{display:flex;justify-content:center;padding:0 10px;height:32px;font-size:10px}.heritage-service>span,.heritage-service>button{display:none}.heritage-site .site-header{height:70px;padding:0 14px;gap:6px}.heritage-site .site-header>.wordmark{font-size:28px;letter-spacing:.16em}.heritage-site .site-header .micro{font-size:9px}.heritage-site .header-right{gap:0}.heritage-site .site-header.is-heritage-scrolled{height:64px}.heritage-site .site-header:hover{background:transparent;color:#fff}.heritage-site .site-header.is-heritage-scrolled:hover{background:var(--heritage-cream);color:var(--heritage-navy)}.heritage-site .service-promises{padding:32px 24px;gap:28px 18px}.heritage-site .newsletter{padding:44px 24px}.heritage-site .newsletter h2{font-size:31px}.heritage-site .site-footer .footer-column a{min-height:40px}.heritage-site .site-footer .wordmark{font-size:32px}}
@media(prefers-reduced-motion:reduce){.heritage-site .site-header{transition:none}}
.heritage-site .site-header:not(.is-heritage-scrolled){position:sticky;top:0;background:var(--heritage-cream);color:var(--heritage-navy)}
</style>
<script>
(() => {
  function initializeHeritageHeader() {
    const header = document.querySelector('[data-site-header]');
    if (!header || header.dataset.heritageReady) return;
    header.dataset.heritageReady = 'true';
    let scheduled = false;
    const update = () => { header.classList.toggle('is-heritage-scrolled', window.scrollY > 130); scheduled = false; };
    window.addEventListener('scroll', () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } }, {passive:true});
    update();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHeritageHeader);
  else initializeHeritageHeader();
  document.addEventListener('shopify:section:load', initializeHeritageHeader);
})();
</script>
