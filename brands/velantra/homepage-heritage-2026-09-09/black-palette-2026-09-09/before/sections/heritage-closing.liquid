<section class="heritage-closing" aria-labelledby="HeritageClosing-{{ section.id }}"><p class="heritage-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="HeritageClosing-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="heritage-closing__copy">{{ section.settings.copy }}</div><div class="heritage-links"><a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a></div></section>
{% stylesheet %}
.heritage-closing{background:#f7f5ef;color:#132039;text-align:center;padding:86px 24px 82px}.heritage-closing h2{font-family:var(--font-serif);font-size:52px;font-weight:400;line-height:1.08;margin:0 0 24px;letter-spacing:-.02em}.heritage-closing__copy{font-size:15px;line-height:1.85;max-width:550px;margin:auto}.heritage-closing__copy p{margin:0}.heritage-closing .heritage-links{margin-top:20px}@media(max-width:767px){.heritage-closing{padding:62px 24px}.heritage-closing h2{font-size:39px}.heritage-closing__copy{font-size:14px}}
{% endstylesheet %}
{% schema %}
{"name":"Heritage closing","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"VELANTRA"},{"type":"text","id":"heading","label":"Heading","default":"Collected for the Everyday"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>A favorite bag becomes part of your days. The morning you linger over. The weekend you look forward to. The places that feel like you.</p>"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Explore the Collection"}],"presets":[{"name":"Heritage closing"}]}
{% endschema %}
