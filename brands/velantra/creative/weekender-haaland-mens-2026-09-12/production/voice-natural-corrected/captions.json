  },
  {
    "text": "A BIRKIN,",
    "start": 107,
    "end": 128,
    "scene": "S03"
  },
  {
    "text": "AND THE BAG IS THE",
    "start": 128,
    "end": 158,
    "scene": "S03"
  },
  {
    "text": "FIRST THING YOU NOTICE.",
    "start": 158,
    "end": 198,
    "scene": "S03"
  },
  {
    "text": "IF YOU WANT A TRAVEL",
    "start": 198,
    "end": 232,
    "scene": "S04"
  },
  {
    "text": "BAG WITH THAT KIND OF",
    "start": 232,
    "end": 259,
    "scene": "S04"
  },
  {
    "text": "PRESENCE,",
    "start": 259,
    "end": 279,
    "scene": "S04"
  },
  {
    "text": "TAKE A LOOK AT THE",
    "start": 279,
    "end": 298,
    "scene": "S04"
  },
  {
    "text": "VELANTRA WEEKENDER.",
    "start": 298,
    "end": 349,
    "scene": "S04"
  },
  {
    "text": "IT\u2019S GOT A BROAD,",
    "start": 349,
    "end": 381,
    "scene": "S05"
  },
  {
    "text": "RECTANGULAR SHAPE,",
    "start": 381,
    "end": 422,
    "scene": "S05"
  },
  {
    "text": "ROLLED LEATHER HANDLES,",
    "start": 422,
    "end": 466,
    "scene": "S05"
  },
  {
    "text": "AND A LEATHER FLAP OVER CANVAS.",
    "start": 466,
    "end": 526,
    "scene": "S05"
  },
  {
    "text": "SO EVEN WITH A PLAIN",
    "start": 526,
    "end": 568,
    "scene": "S06"
  },
  {
    "text": "T-SHIRT AND JEANS,",
    "start": 568,
    "end": 597,
    "scene": "S06"
  },
  {
    "text": "IT GIVES YOU A SHARPER LOOK.",
    "start": 597,
    "end": 650,
    "scene": "S06"
  },
  {
    "text": "THE COGNAC VERSION HAS BROWN",
    "start": 650,
    "end": 702,
    "scene": "S07"
  },
  {
    "text": "LEATHER AGAINST A LIGHTER CANVAS BODY,",
    "start": 702,
    "end": 762,
    "scene": "S07"
  },
  {
    "text": "WITH GOLD-TONE HARDWARE.",
    "start": 762,
    "end": 805,
    "scene": "S07"
  },
  {
    "text": "EASY TO WEAR WITH A",
    "start": 805,
    "end": 844,
    "scene": "S08"
  },
  {
    "text": "NAVY JACKET,",
    "start": 844,
    "end": 873,
    "scene": "S08"
  },
  {
    "text": "DENIM,",
    "start": 873,
    "end": 893,
    "scene": "S09"
  },
  {
    "text": "OR A BLACK COAT.",
    "start": 893,
    "end": 941,
    "scene": "S10"
  },
  {
    "text": "INSIDE,",
    "start": 941,
    "end": 961,
    "scene": "S11"
  },
  {
    "text": "THERE\u2019S A WIDE SLIP POCKET",
    "start": 961,
    "end": 1002,
    "scene": "S11"
  },
  {
    "text": "TO KEEP SMALLER THINGS SEPARATE",
    "start": 1002,
    "end": 1045,
    "scene": "S11"
  },
  {
    "text": "FROM THE MAIN COMPARTMENT.",
    "start": 1045,
    "end": 1086,
    "scene": "S11"
  },
