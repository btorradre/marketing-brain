[
  {
    "text": "NOBODY DOES IT",
    "start": 0,
    "end": 28,
    "scene": "S01"
  },
  {
    "text": "LIKE ERLING HAALAND.",
    "start": 28,
    "end": 73,
    "scene": "S02"
  },
  {
    "text": "THE GUY TURNS UP CARRYING",
    "start": 73,
    "end": 124,
    "scene": "S03"
  },
  {
    "text": "A BIRKIN,",
    "start": 124,
    "end": 149,
    "scene": "S03"
  },
  {
    "text": "AND THE BAG IS THE",
    "start": 149,
    "end": 174,
    "scene": "S03"
  },
  {
    "text": "FIRST THING YOU NOTICE.",
    "start": 174,
    "end": 217,
    "scene": "S03"
  },
  {
    "text": "IF YOU WANT A TRAVEL",
    "start": 217,
    "end": 254,
    "scene": "S04"
  },
  {
    "text": "BAG WITH THAT KIND OF",
    "start": 254,
    "end": 280,
    "scene": "S04"
  },
  {
    "text": "PRESENCE,",
    "start": 280,
    "end": 308,
    "scene": "S04"
  },
  {
    "text": "TAKE A LOOK AT THE",
    "start": 308,
    "end": 328,
    "scene": "S04"
  },
  {
    "text": "VELANTRA WEEKENDER.",
    "start": 328,
    "end": 383,
    "scene": "S04"
  },
  {
    "text": "IT\u2019S GOT A BROAD,",
    "start": 383,
    "end": 414,
    "scene": "S05"
  },
  {
    "text": "RECTANGULAR SHAPE,",
    "start": 414,
    "end": 455,
    "scene": "S05"
  },
  {
    "text": "ROLLED LEATHER HANDLES,",
    "start": 455,
    "end": 500,
    "scene": "S05"
  },
  {
    "text": "AND A LEATHER FLAP OVER CANVAS.",
    "start": 500,
    "end": 563,
    "scene": "S05"
  },
  {
    "text": "SO EVEN WITH A PLAIN",
    "start": 563,
    "end": 606,
    "scene": "S06"
  },
  {
    "text": "T-SHIRT AND JEANS,",
    "start": 606,
    "end": 642,
    "scene": "S06"
  },
  {
    "text": "IT GIVES YOU A SHARPER LOOK.",
    "start": 642,
    "end": 691,
    "scene": "S06"
  },
  {
    "text": "THE COGNAC VERSION HAS BROWN",
    "start": 691,
    "end": 758,
    "scene": "S07"
  },
  {
    "text": "LEATHER AGAINST A LIGHTER CANVAS BODY,",
    "start": 758,
    "end": 824,
    "scene": "S07"
  },
  {
    "text": "WITH GOLD-TONE HARDWARE.",
    "start": 824,
    "end": 871,
    "scene": "S07"
  },
  {
    "text": "EASY TO WEAR WITH A",
    "start": 871,
    "end": 914,
    "scene": "S08"
  },
  {
    "text": "NAVY JACKET,",
    "start": 914,
    "end": 948,
    "scene": "S08"
  },
  {
    "text": "DENIM,",
    "start": 948,
    "end": 966,
    "scene": "S09"
  },
  {
    "text": "OR A BLACK COAT.",
    "start": 966,
    "end": 1020,
    "scene": "S10"
  },
  {
    "text": "INSIDE,",
    "start": 1020,
    "end": 1047,
    "scene": "S11"
  },
  {
    "text": "THERE\u2019S A WIDE SLIP POCKET",
    "start": 1047,
    "end": 1089,
    "scene": "S11"
  },
  {
    "text": "TO KEEP SMALLER THINGS SEPARATE",
    "start": 1089,
    "end": 1136,
    "scene": "S11"
  },
  {
    "text": "FROM THE MAIN COMPARTMENT.",
    "start": 1136,
    "end": 1190,
    "scene": "S11"
  },
  {
    "text": "SO YOU\u2019VE GOT A BAG",
    "start": 1190,
    "end": 1220,
    "scene": "S12"
  },
  {
    "text": "FOR THE WEEKEND THAT LOOKS",
    "start": 1220,
    "end": 1250,
    "scene": "S12"
  },
  {
    "text": "RIGHT WHEN YOU WALK INTO",
    "start": 1250,
