[
  {
    "text": "NOBODY DOES IT",
    "start": 4,
    "end": 35,
    "scene": "S01"
  },
  {
    "text": "LIKE ERLING HAALAND.",
    "start": 35,
    "end": 92,
    "scene": "S02"
  },
  {
    "text": "THE GUY TURNS UP CARRYING",
    "start": 92,
    "end": 127,
    "scene": "S03"
  },
  {
    "text": "A BIRKIN,",
    "start": 127,
    "end": 152,
    "scene": "S03"
  },
  {
    "text": "AND THE BAG IS THE",
    "start": 152,
    "end": 178,
    "scene": "S03"
  },
  {
    "text": "FIRST THING YOU NOTICE.",
    "start": 178,
    "end": 235,
    "scene": "S03"
  },
  {
    "text": "IF YOU WANT A TRAVEL",
    "start": 235,
    "end": 257,
    "scene": "S04"
  },
  {
    "text": "BAG WITH THAT KIND OF",
    "start": 257,
    "end": 284,
    "scene": "S04"
  },
  {
    "text": "PRESENCE,",
    "start": 284,
    "end": 313,
    "scene": "S04"
  },
  {
    "text": "TAKE A LOOK AT THE",
    "start": 313,
    "end": 331,
    "scene": "S04"
  },
  {
    "text": "VELANTRA WEEKENDER.",
    "start": 331,
    "end": 392,
    "scene": "S04"
  },
  {
    "text": "IT\u2019S GOT A BROAD,",
    "start": 392,
    "end": 416,
    "scene": "S05"
  },
  {
    "text": "RECTANGULAR SHAPE,",
    "start": 416,
    "end": 459,
    "scene": "S05"
  },
  {
    "text": "ROLLED LEATHER HANDLES,",
    "start": 459,
    "end": 503,
    "scene": "S05"
  },
  {
    "text": "AND A LEATHER FLAP OVER CANVAS.",
    "start": 503,
    "end": 581,
    "scene": "S05"
  },
  {
    "text": "SO EVEN WITH A PLAIN",
    "start": 581,
    "end": 609,
    "scene": "S06"
  },
  {
    "text": "T-SHIRT AND JEANS,",
    "start": 609,
    "end": 645,
    "scene": "S06"
  },
  {
    "text": "IT GIVES YOU A SHARPER LOOK.",
    "start": 645,
    "end": 718,
    "scene": "S06"
  },
  {
    "text": "THE COGNAC VERSION HAS BROWN",
    "start": 718,
    "end": 761,
    "scene": "S07"
  },
  {
    "text": "LEATHER AGAINST A LIGHTER CANVAS BODY,",
    "start": 761,
    "end": 827,
    "scene": "S07"
  },
  {
    "text": "WITH GOLD-TONE HARDWARE.",
    "start": 827,
    "end": 895,
    "scene": "S07"
  },
  {
    "text": "EASY TO WEAR WITH A",
    "start": 895,
    "end": 917,
    "scene": "S08"
  },
  {
    "text": "NAVY JACKET,",
    "start": 917,
    "end": 950,
    "scene": "S08"
  },
  {
    "text": "DENIM,",
    "start": 950,
    "end": 970,
    "scene": "S09"
  },
  {
    "text": "OR A BLACK COAT.",
    "start": 970,
    "end": 1030,
    "scene": "S10"
  },
  {
    "text": "INSIDE,",
    "start": 1030,
    "end": 1051,
    "scene": "S11"
  },
  {
    "text": "THERE\u2019S A WIDE SLIP POCKET",
    "start": 1051,
    "end": 1094,
    "scene": "S11"
  },
  {
    "text": "TO KEEP SMALLER THINGS SEPARATE",
    "start": 1094,
    "end": 1139,
    "scene": "S11"
  },
  {
    "text": "FROM THE MAIN COMPARTMENT.",
    "start": 1139,
    "end": 1200,
    "scene": "S11"
  },
  {
    "text": "SO YOU\u2019VE GOT A BAG",
    "start": 1200,
    "end": 1223,
    "scene": "S12"
  },
  {
    "text": "FOR THE WEEKEND THAT LOOKS",
    "start": 1223,
    "end": 1255,
    "scene": "S12"
  },
  {
    "text": "RIGHT WHEN YOU WALK INTO",
    "start": 1255,
    "end": 1282,
    "scene": "S12"
