[
  {
    "text": "NOBODY DOES IT",
    "start": 0,
    "end": 21,
    "scene": "S01"
  },
  {
    "text": "LIKE ERLING HAALAND.",
    "start": 21,
    "end": 69,
    "scene": "S02"
  },
  {
    "text": "THE GUY TURNS UP CARRYING",
    "start": 69,
    "end": 109,
    "scene": "S03"
  },
  {
    "text": "A BIRKIN,",
    "start": 109,
    "end": 133,
    "scene": "S03"
  },
  {
    "text": "AND THE BAG IS THE",
    "start": 133,
    "end": 155,
    "scene": "S03"
  },
  {
    "text": "FIRST THING YOU NOTICE.",
    "start": 155,
    "end": 198,
    "scene": "S03"
  },
  {
    "text": "IF YOU WANT A TRAVEL",
    "start": 198,
    "end": 235,
    "scene": "S04"
  },
  {
    "text": "BAG WITH THAT KIND OF",
    "start": 235,
    "end": 261,
    "scene": "S04"
  },
  {
    "text": "PRESENCE,",
    "start": 261,
    "end": 284,
    "scene": "S04"
  },
  {
    "text": "TAKE A LOOK AT THE",
    "start": 284,
    "end": 304,
    "scene": "S04"
  },
  {
    "text": "VELANTRA WEEKENDER.",
    "start": 304,
    "end": 365,
    "scene": "S04"
  },
  {
    "text": "IT\u2019S GOT A BROAD,",
    "start": 365,
    "end": 395,
    "scene": "S05"
  },
  {
    "text": "RECTANGULAR SHAPE,",
    "start": 395,
    "end": 434,
    "scene": "S05"
  },
  {
    "text": "ROLLED LEATHER HANDLES,",
    "start": 434,
    "end": 472,
    "scene": "S05"
  },
  {
    "text": "AND A LEATHER FLAP OVER CANVAS.",
    "start": 472,
    "end": 537,
    "scene": "S05"
  },
  {
    "text": "SO EVEN WITH A PLAIN",
    "start": 537,
    "end": 565,
    "scene": "S06"
  },
  {
    "text": "T-SHIRT AND JEANS,",
    "start": 565,
    "end": 602,
    "scene": "S06"
  },
  {
    "text": "IT GIVES YOU A SHARPER LOOK.",
    "start": 602,
    "end": 660,
    "scene": "S06"
  },
  {
    "text": "THE COGNAC VERSION HAS BROWN",
    "start": 660,
    "end": 709,
    "scene": "S07"
  },
  {
    "text": "LEATHER AGAINST A LIGHTER CANVAS BODY,",
    "start": 709,
    "end": 781,
    "scene": "S07"
  },
  {
    "text": "WITH GOLD-TONE HARDWARE.",
    "start": 781,
    "end": 827,
    "scene": "S07"
  },
  {
    "text": "EASY TO WEAR WITH A",
    "start": 827,
    "end": 868,
    "scene": "S08"
  },
  {
    "text": "NAVY JACKET,",
    "start": 868,
    "end": 900,
    "scene": "S08"
  },
  {
    "text": "DENIM,",
    "start": 900,
    "end": 915,
    "scene": "S09"
  },
  {
    "text": "OR A BLACK COAT.",
    "start": 915,
    "end": 965,
    "scene": "S10"
  },
  {
    "text": "INSIDE,",
    "start": 965,
    "end": 984,
    "scene": "S11"
  },
  {
    "text": "THERE\u2019S A WIDE SLIP POCKET",
    "start": 984,
    "end": 1024,
    "scene": "S11"
  },
  {
    "text": "TO KEEP SMALLER THINGS SEPARATE",
    "start": 1024,
    "end": 1071,
    "scene": "S11"
  },
  {
    "text": "FROM THE MAIN COMPARTMENT.",
    "start": 1071,
    "end": 1123,
    "scene": "S11"
  },
  {
    "text": "SO YOU\u2019VE GOT A BAG",
    "start": 1123,
    "end": 1151,
    "scene": "S12"
  },
  {
    "text": "FOR THE WEEKEND THAT LOOKS",
    "start": 1151,
    "end": 1182,
    "scene": "S12"
  },
  {
    "text": "RIGHT WHEN YOU WALK INTO",
    "start": 1182,
    "end": 1213,
