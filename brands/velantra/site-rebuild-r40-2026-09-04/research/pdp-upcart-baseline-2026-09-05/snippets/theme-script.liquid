{% doc %}Shared navigation, dialogs, video and Shopify cart behaviors.{% enddoc %}
<script>
(()=>{
const rawRoot=window.Shopify?.routes?.root || {{ routes.root_url | json }};const root=rawRoot.endsWith('/')?rawRoot:rawRoot+'/';const labels={empty:{{ 'cart.empty' | t | json }},shop:{{ 'general.view_collection' | t | json }},remove:{{ 'cart.remove' | t | json }},less:{{ 'cart.decrease' | t | json }},more:{{ 'cart.increase' | t | json }},error:{{ 'cart.error' | t | json }},pause:{{ 'general.pause' | t | json }},play:{{ 'general.play' | t | json }},preorderOctober:{{ settings.vivienne_preorder_message | json }},preorderEarlyOctober:{{ settings.colette_preorder_message | json }},preorderSeptember:{{ settings.weekender_black_preorder_message | json }}};
const money=v=>new Intl.NumberFormat({{ request.locale.iso_code | json }},{style:'currency',currency:{{ cart.currency.iso_code | default: shop.currency | json }}}).format(v/100);
const studioVariantImages={% render 'studio-variant-map' %};const cartImage=i=>studioVariantImages[String(i.variant_id)]||i.image;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let lastFocus;const open=id=>{const d=document.getElementById(id);if(!d)return;if(!document.querySelector('dialog[open]'))lastFocus=document.activeElement;document.querySelectorAll('dialog[open]').forEach(other=>{if(other!==d)other.close()});if(!d.open)d.showModal();if(id==='CartDrawer')refresh();};const close=d=>{d.close();lastFocus?.focus();};
document.addEventListener('click',e=>{const o=e.target.closest('[data-dialog-open]');if(o){e.preventDefault();open(o.dataset.dialogOpen)}const c=e.target.closest('[data-dialog-close]');if(c)close(c.closest('dialog'));if(e.target.matches('dialog[open]')){const r=e.target.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)close(e.target)}if(!e.target.closest('.nav-dropdown'))document.querySelectorAll('.nav-dropdown[open]').forEach(d=>d.open=false)});
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;const d=document.querySelector('#NavigationDrawer[open],#SearchDialog[open],#LocaleDialog[open],#CartDrawer[open]');if(d){e.preventDefault();e.stopPropagation();close(d)}else{document.querySelectorAll('.nav-dropdown[open]').forEach(n=>{n.open=false;n.querySelector('summary')?.focus()})}},true);
document.addEventListener('cart:open',()=>open('CartDrawer'));
function preorderNote(i){if({{ settings.vivienne_preorder | json }}&&i.handle==='velantra-vivienne')return labels.preorderOctober;if({{ settings.colette_preorder | json }}&&i.handle==='the-colette-wool-tote')return labels.preorderEarlyOctober;if({{ settings.weekender_black_preorder | json }}&&['velantra-weekender','the-eleanor-weekender'].includes(i.handle)&&i.variant_title==='Black')return labels.preorderSeptember;return '';}
let cartPending=0;let cartHasItems=false;
function checkoutState(){document.querySelectorAll('[data-cart-checkout]').forEach(button=>{button.disabled=cartPending>0||!cartHasItems;});}
function renderCart(cart){cartHasItems=cart.items.length>0;checkoutState();document.querySelectorAll('[data-cart-count]').forEach(n=>n.textContent=cart.item_count);const host=document.querySelector('[data-drawer-items]');if(!host)return;host.innerHTML=cart.items.length?cart.items.map(i=>`<article class="drawer-line">${cartImage(i)?`<img src="${esc(cartImage(i))}" width="100" height="125" alt="${esc(i.product_title)}">`:''}<div><h3><a href="${esc(i.url)}">${esc(i.product_title)}</a></h3><p>${i.variant_title?esc(i.variant_title):''}</p><p>${money(i.final_line_price)}</p>${preorderNote(i)?`<p class="drawer-preorder">${esc(preorderNote(i))}</p>`:''}<div class="drawer-quantity"><button data-cart-key="${esc(i.key)}" data-quantity="${i.quantity-1}" aria-label="${esc(labels.less)}">−</button><span>${i.quantity}</span><button data-cart-key="${esc(i.key)}" data-quantity="${i.quantity+1}" aria-label="${esc(labels.more)}">+</button><button class="drawer-remove" data-cart-key="${esc(i.key)}" data-quantity="0">${esc(labels.remove)}</button></div></div></article>`).join(''):`<div class="empty-state"><p>${esc(labels.empty)}</p><a href="${root}collections/all" class="text-link">${esc(labels.shop)}</a></div>`;document.querySelector('[data-drawer-total]').textContent=money(cart.total_price);document.querySelector('.cart-drawer-bottom').hidden=!cart.items.length;}
async function refresh(){cartPending++;checkoutState();try{const r=await fetch(root+'cart.js',{headers:{Accept:'application/json'},cache:'no-store'});if(!r.ok)throw Error();const cart=await r.json();renderCart(cart);document.querySelector('[data-cart-error]').textContent='';return cart}catch(e){cartHasItems=false;document.querySelector('[data-cart-error]').textContent=labels.error}finally{cartPending--;checkoutState()}}
document.addEventListener('cart:updated',e=>{if(e.detail?.items)renderCart(e.detail);else refresh()});
document.addEventListener('click',async e=>{const b=e.target.closest('[data-cart-key]');if(!b||cartPending)return;cartPending++;checkoutState();const error=document.querySelector('[data-cart-error]');error.textContent='';document.querySelectorAll('[data-cart-key]').forEach(n=>n.disabled=true);try{const r=await fetch(root+'cart/change.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({id:b.dataset.cartKey,quantity:Number(b.dataset.quantity)})});const data=await r.json();if(!r.ok)throw Error(data.description||labels.error);renderCart(data);const nextButtons=[...document.querySelectorAll('[data-cart-key]')];const nextFocus=nextButtons.find(n=>n.dataset.cartKey===b.dataset.cartKey&&n.className===b.className&&n.getAttribute('aria-label')===b.getAttribute('aria-label'))||document.querySelector('#CartDrawer [data-dialog-close]');document.dispatchEvent(new CustomEvent('cart:updated',{detail:data}));const finalFocus=[...document.querySelectorAll('[data-cart-key]')].find(n=>n.dataset.cartKey===b.dataset.cartKey&&n.className===b.className&&n.getAttribute('aria-label')===b.getAttribute('aria-label'))||document.querySelector('#CartDrawer [data-dialog-close]');finalFocus?.focus()}catch(err){error.textContent=err.message}finally{cartPending--;checkoutState();document.querySelectorAll('[data-cart-key]').forEach(n=>n.disabled=false)}});
function videos(scope=document){scope.querySelectorAll('.hero-video,.detail-video').forEach(v=>{if(v.dataset.initialized)return;v.dataset.initialized='true';if(v.dataset.mobileSrc&&matchMedia('(max-width:767px)').matches){v.src=v.dataset.mobileSrc;v.poster={{ 'vivienne-hero-mobile.jpg' | asset_url | json }};v.load()}const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;if(reduce){v.autoplay=false;v.pause()}else v.play().catch(()=>{});const button=v.closest('.hero-film')?.querySelector('[data-video-toggle]');if(button){button.textContent=v.paused?labels.play:labels.pause;button.addEventListener('click',()=>{if(v.paused){v.play().catch(()=>{});button.textContent=labels.pause;button.setAttribute('aria-label',labels.pause)}else{v.pause();button.textContent=labels.play;button.setAttribute('aria-label',labels.play)}})}})}
videos();document.addEventListener('shopify:section:load',e=>videos(e.target));document.addEventListener('visibilitychange',()=>{if(document.hidden)document.querySelectorAll('.hero-video,.detail-video').forEach(v=>v.pause())});
})();
</script>
