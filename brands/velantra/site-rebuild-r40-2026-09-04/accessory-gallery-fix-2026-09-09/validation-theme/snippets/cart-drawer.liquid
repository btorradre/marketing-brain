{% doc %}Accessible live cart drawer, updated from Shopify Ajax Cart.{% enddoc %}
<dialog class="drawer cart-drawer" id="CartDrawer" aria-label="{{ 'cart.selection' | t }}"><div class="dialog-top"><h2>{{ 'cart.selection' | t }}</h2><button class="icon-close" data-dialog-close aria-label="{{ 'general.close' | t }}">×</button></div><div data-drawer-items class="cart-drawer-items"><p>{{ 'cart.loading' | t }}</p></div><p class="drawer-error error" data-cart-error role="alert"></p><div class="cart-drawer-bottom"><div class="drawer-subtotal"><span>{{ 'cart.subtotal' | t }}</span><span data-drawer-total>{{ cart.total_price | money }}</span></div><p>{{ 'cart.shipping_note' | t }}</p><form action="{{ routes.cart_url }}" method="post"{% if request.design_mode %} target="_blank" rel="noopener"{% endif %}><button type="submit" name="checkout" value="checkout" class="button" data-cart-checkout disabled>{{ 'cart.checkout' | t }}</button></form><a class="text-link" href="{{ routes.cart_url }}">{{ 'cart.view' | t }}</a></div></dialog>
<style>.cart-drawer{display:none;flex-direction:column}.cart-drawer[open]{display:flex}.cart-drawer-items{flex:1;min-height:0;overflow:auto;padding:24px}.cart-drawer-bottom{border-top:1px solid var(--color-line);padding:24px}.drawer-subtotal{display:flex;justify-content:space-between;font-size:14px}.cart-drawer-bottom p{font-size:10px;margin:12px 0 20px}.cart-drawer-bottom .button{width:100%}.cart-drawer-bottom>.text-link{display:table;margin:20px auto 0}.drawer-line{display:grid;grid-template-columns:100px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid var(--color-line)}.drawer-line>img{width:100px;aspect-ratio:4/5;object-fit:contain;background:var(--studio-bg)}.drawer-line h3{font-size:21px;margin:0 0 10px}.drawer-line p{font-size:11px;margin-bottom:10px}.drawer-quantity{display:flex;align-items:center;gap:14px;font-size:11px}.drawer-quantity button{border:1px solid var(--color-line);width:30px;height:30px}.drawer-quantity .drawer-remove{border:0;width:auto;font-size:9px;text-decoration:underline;margin-left:auto}.drawer-error{padding:0 24px;margin:0;font-size:12px}</style>
