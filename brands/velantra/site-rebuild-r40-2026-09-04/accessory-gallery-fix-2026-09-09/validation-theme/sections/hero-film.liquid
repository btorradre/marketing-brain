<section class="hero-film" style="--hero-height:{{ section.settings.height }}svh;--hero-text:{{ section.settings.text_color }};--hero-overlay:{{ section.settings.overlay | divided_by: 100.0 }};--hero-position:{{ section.settings.position }}" aria-label="{{ section.settings.accessibility | escape }}">
<div class="hero-media">{% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2000x', class: 'hero-video', preload: 'metadata' }}{% elsif section.settings.video_url != blank %}<video class="hero-video" autoplay muted loop playsinline preload="metadata"{% if section.settings.poster != blank %} poster="{{ section.settings.poster | image_url: width: 2000 }}"{% endif %}><source src="{{ section.settings.video_url }}" type="video/mp4"></video>{% elsif section.settings.use_default_media %}<video class="hero-video" data-desktop-src="{{ 'vivienne-hero-desktop.mp4' | asset_url }}" data-mobile-src="{{ 'vivienne-hero-mobile.mp4' | asset_url }}" autoplay muted loop playsinline preload="metadata" poster="{{ 'vivienne-hero-desktop.jpg' | asset_url }}"><source src="{{ 'vivienne-hero-desktop.mp4' | asset_url }}" type="video/mp4"></video>{% elsif section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero-poster' }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag: 'hero-poster' }}{% endif %}</div>
<div class="hero-copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h1>{{ section.settings.heading | escape }}</h1>{% else %}<h1 class="visually-hidden">{{ shop.name | escape }} — {{ 'general.luxury' | t }}</h1>{% endif %}{% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}{% if section.settings.label != blank %}<a class="text-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.label | escape }}</a>{% endif %}</div><button class="film-toggle micro" data-video-toggle aria-label="{{ 'general.pause_video' | t }}">{{ 'general.pause' | t }}</button>
</section>
{% stylesheet %}.hero-film{position:relative;height:var(--hero-height);min-height:480px;max-height:1200px;color:var(--hero-text);isolation:isolate}.hero-media,.hero-media:after{position:absolute;inset:0;z-index:-1}.hero-media{background:#d6d3cf}.hero-media:after{content:'';background:#000;opacity:var(--hero-overlay);z-index:1}.hero-video,.hero-poster{width:100%;height:100%;object-fit:cover;object-position:var(--hero-position)}.hero-copy{position:absolute;bottom:48px;left:24px;right:24px;text-align:center}.hero-copy h1:not(.visually-hidden){font-size:clamp(35px,4vw,64px);margin-bottom:20px}.hero-copy>div{margin-bottom:25px}.hero-copy .eyebrow{margin-bottom:16px}.film-toggle{position:absolute;bottom:28px;right:24px;border-bottom:1px solid currentColor;padding:2px 0;font-size:9px}@media(max-width:767px){.hero-film{height:88svh;min-height:540px;max-height:1000px}.hero-copy{bottom:50px}.film-toggle{right:16px;bottom:20px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Hero film",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "MP4 video URL"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster / fallback image"
    },
    {
      "type": "checkbox",
      "id": "use_default_media",
      "label": "Use included Vivienne film",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Link label",
      "default": "Discover The Vivienne"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "position",
      "label": "Video focal point",
      "default": "center center"
    },
    {
      "type": "text",
      "id": "accessibility",
      "label": "Video description",
      "default": "The Vivienne, in motion"
    }
  ],
  "presets": [
    {
      "name": "Hero film"
    }
  ]
}
{% endschema %}
