<section class="featured-products section-space"><div class="featured-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.show_link %}<a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'general.view_collection' | t }}</a>{% endif %}</div><div class="featured-grid" style="--featured-columns:{{ section.settings.columns }}">{% if section.settings.products != blank %}{% for item in section.settings.products limit: section.settings.limit %}{% render 'product-card', product: item %}{% endfor %}{% elsif section.settings.collection != blank %}{% for item in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: item %}{% endfor %}{% else %}{% assign handles = 'velantra-vivienne,velantra-weekender,velantra-delphine,the-colette-wool-tote' | split: ',' %}{% for item_handle in handles limit: section.settings.limit %}{% assign item = all_products[item_handle] %}{% if item != blank %}{% render 'product-card', product: item %}{% endif %}{% endfor %}{% endif %}</div></section>
{% stylesheet %}.featured-products{padding-top:64px;padding-bottom:64px}.featured-heading{display:flex;justify-content:space-between;align-items:end;margin:0 12px 40px}.featured-heading .eyebrow{margin-bottom:14px}.featured-grid{display:grid;grid-template-columns:repeat(var(--featured-columns),minmax(0,1fr));gap:12px}@media(max-width:767px){.featured-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 8px}.featured-products{padding-left:6px;padding-right:6px}.featured-heading{align-items:start;gap:25px}.featured-heading>.text-link{font-size:9px;text-align:right}}
{% endstylesheet %}
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CONSIDERED FOR EVERY DAY"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Curated products",
      "limit": 12
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product count",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show collection link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
