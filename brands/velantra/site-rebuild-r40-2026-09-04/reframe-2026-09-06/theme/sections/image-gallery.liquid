<section class="editorial-gallery" style="--columns:{{ section.settings.columns }};--image-ratio:{{ section.settings.ratio }};--gallery-gap:{{ section.settings.gap }}px;--gallery-padding:{{ section.settings.padding }}px" aria-label="{{ section.settings.label | escape }}">{% for block in section.blocks %}<figure {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1600', sizes: '(min-width: 768px) 50vw, 100vw' }}{% elsif block.settings.default_asset != blank %}<img src="{{ block.settings.default_asset | asset_url }}" width="1200" height="1500" loading="lazy" alt="{{ block.settings.alt | escape }}">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}{% if block.settings.link != blank %}</a>{% endif %}{% if block.settings.caption != blank %}<figcaption><h3>{{ block.settings.caption | escape }}</h3>{% if block.settings.subtext != blank %}<p>{{ block.settings.subtext | escape }}</p>{% endif %}</figcaption>{% endif %}</figure>{% endfor %}</section>
{% stylesheet %}.editorial-gallery{display:grid;grid-template-columns:repeat(var(--columns),minmax(0,1fr));gap:var(--gallery-gap);padding:0 var(--gallery-padding)}.editorial-gallery figure{margin:0;min-width:0}.editorial-gallery img,.editorial-gallery svg{width:100%;aspect-ratio:var(--image-ratio);height:auto;object-fit:cover;background:var(--studio-bg)}.editorial-gallery figcaption{padding:24px 20px 32px}.editorial-gallery figcaption p{font-size:11px;color:var(--color-muted);margin:8px 0 0}@media(max-width:767px){.editorial-gallery{gap:6px;padding:0 6px}.editorial-gallery[style*="--columns:2"]{grid-template-columns:1fr 1fr}.editorial-gallery figcaption{padding:15px 8px 24px}.editorial-gallery h3{font-size:20px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Editorial image gallery",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "The Velantra edit"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "4/5",
          "label": "Portrait"
        },
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "16/9",
          "label": "Landscape"
        },
        {
          "value": "21/9",
          "label": "Cinematic"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Side margin",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Included image filename"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Supporting text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial image gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
