{% doc %}Global design tokens and the Velantra layout system.{% enddoc %}
<style>
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'cormorant-400.ttf' | asset_url }}) format('truetype')}
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'cormorant-500.ttf' | asset_url }}) format('truetype')}
@font-face{font-family:Montserrat;font-style:normal;font-weight:400;font-display:swap;src:url({{ 'montserrat-400.ttf' | asset_url }}) format('truetype')}
@font-face{font-family:Montserrat;font-style:normal;font-weight:500;font-display:swap;src:url({{ 'montserrat-500.ttf' | asset_url }}) format('truetype')}
@font-face{font-family:Montserrat;font-style:normal;font-weight:700;font-display:swap;src:url({{ 'montserrat-700.ttf' | asset_url }}) format('truetype')}
{% if settings.custom_fonts %}{% if settings.body_font != blank %}{{ settings.body_font | font_face: font_display: 'swap' }}{% endif %}{% if settings.heading_font != blank %}{{ settings.heading_font | font_face: font_display: 'swap' }}{% endif %}{% endif %}
:root{--font-serif:{% if settings.custom_fonts %}{{ settings.heading_font.family }},{{ settings.heading_font.fallback_families }}{% else %}'Cormorant Garamond',Georgia,serif{% endif %};--font-sans:{% if settings.custom_fonts %}{{ settings.body_font.family }},{{ settings.body_font.fallback_families }}{% else %}Montserrat,Arial,sans-serif{% endif %};--color-bg:{{ settings.color_background }};--color-text:{{ settings.color_text }};--color-line:{{ settings.color_line }};--color-muted:{{ settings.color_muted }};--studio-bg:{{ settings.studio_background }};--header-height:80px;--page-margin:12px;--space-section:{{ settings.section_spacing }}px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:var(--header-height)}body{margin:0;background:var(--color-bg);color:var(--color-text);font-family:var(--font-sans);font-size:13px;font-weight:400;line-height:1.65}body:has(dialog[open]){overflow:hidden}button,input,select,textarea{font:inherit;color:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.55}a{color:inherit;text-decoration:none}a:hover{text-decoration-color:currentColor}button{border:0;border-radius:0;background:none}input,textarea,select{border:1px solid var(--color-line);border-radius:0;background:transparent;padding:13px}input:focus,textarea:focus,select:focus{outline:1px solid var(--color-text);outline-offset:3px}a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid currentColor;outline-offset:5px}img,video{max-width:100%;display:block}img{height:auto}h1,h2,h3,h4{font-family:var(--font-serif);font-weight:400;line-height:1.2;margin:0}h1,h2{font-size:clamp(26px,2.2vw,38px)}h3{font-size:25px}p{margin:0 0 18px}ul{padding-left:20px}summary{cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}[hidden]{display:none!important}.visually-hidden{position:absolute!important;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip-link{position:fixed;top:-100px;left:12px;z-index:1000;background:var(--color-text);color:var(--color-bg);padding:12px}.skip-link:focus{top:12px}.eyebrow,.micro{font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:1px;line-height:1.5}.eyebrow{margin-bottom:28px}.muted{color:var(--color-muted)}.page-width{max-width:{{ settings.page_width }}px;margin:auto;padding:0 var(--page-margin)}.button{display:inline-flex;justify-content:center;align-items:center;min-height:46px;padding:15px 32px;background:var(--color-text);color:var(--color-bg);border:1px solid var(--color-text);font-size:10px;font-weight:500;letter-spacing:1px;text-transform:uppercase;line-height:1.4;transition:background .2s,color .2s}.button:hover{background:var(--color-bg);color:var(--color-text)}.button--outline{background:transparent;color:var(--color-text)}.text-link{font-size:10px;text-transform:uppercase;letter-spacing:1px;padding-bottom:5px;border-bottom:1px solid currentColor}.rte p{margin-bottom:18px}.rte a{text-decoration:underline;text-underline-offset:4px}.rte h2,.rte h3{margin:32px 0 18px}.rte table{width:100%;border-collapse:collapse}.rte td,.rte th{padding:12px;border-bottom:1px solid var(--color-line)}.rte img{height:auto}.section-space{padding:var(--space-section) var(--page-margin)}.error{color:#963d35}.form-message{margin:14px 0;font-size:12px}dialog{border:0;margin:0;padding:0;background:var(--color-bg);color:var(--color-text);max-height:100dvh}dialog::backdrop{background:#0005}.dialog-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--color-line);padding:24px}.dialog-top h2{font-size:28px}.icon-close{font:300 28px/1 Arial;width:36px;height:36px;display:grid;place-items:center}.drawer{inset:0 0 0 auto;height:100dvh;width:min(500px,100%);max-width:100%}.drawer-body{padding:24px}.newsletter-input{display:flex;border-bottom:1px solid var(--color-line)}.newsletter-input input{flex:1;min-width:0;border:0;padding:16px 0}.newsletter-input button{padding:16px 0 16px 20px}.newsletter-consent{display:flex;gap:9px;text-align:left;font-size:10px;margin-top:18px}.newsletter-consent input{margin:3px 0 0}.newsletter-consent a{text-decoration:underline}.shopify-policy__container{max-width:760px!important;padding:64px 24px 100px!important}.shopify-policy__title{margin-bottom:42px!important}.shopify-policy__body{font-size:13px}.shopify-policy__body h2{margin-top:35px}.empty-state{text-align:center;padding:100px 20px}.empty-state h1{margin-bottom:24px}.pagination{display:flex;justify-content:center;gap:20px;padding:48px}.pagination a,.pagination .current{padding:7px 12px}.pagination .current{border-bottom:1px solid}.content-page{max-width:760px;margin:auto;padding:75px 24px 110px}.content-page>h1{margin-bottom:42px;text-align:center}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.contact-grid label{display:grid;gap:8px}.contact-grid .full{grid-column:1/-1}.contact-grid textarea{min-height:150px}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.blog-grid article img{aspect-ratio:4/5;object-fit:cover;width:100%;margin-bottom:20px}.blog-grid h2{font-size:25px;margin:10px 0}.article-hero{margin-bottom:40px}.announcement{padding:8px 16px;text-align:center;font-size:10px;letter-spacing:1px}
@media(max-width:767px){:root{--header-height:64px;--space-section:64px}.button{min-height:48px}input,textarea,select{font-size:16px}.blog-grid{grid-template-columns:1fr}.contact-grid{grid-template-columns:1fr}.contact-grid .full{grid-column:auto}.section-space{padding:64px 20px}.content-page{padding-top:45px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
</style>
