{% if section.settings.text != blank %}<div class="announcement" style="background:{{ section.settings.background }};color:{{ section.settings.color }}">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}{{ section.settings.text | escape }}{% if section.settings.link != blank %}</a>{% endif %}</div>{% endif %}
{% schema %}
{
  "name": "Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#2a2a2a"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Announcement"
    }
  ]
}
{% endschema %}
