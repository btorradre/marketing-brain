<section class="page-width section-space"><div class="editorial-text section-space"><h1>{{ blog.title | escape }}</h1></div>{% paginate blog.articles by 12 %}<div class="blog-grid">{% for article in blog.articles %}<article>{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}</a>{% endif %}<p class="micro">{{ article.published_at | date: format: 'date' }}</p><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p><a class="text-link" href="{{ article.url }}">{{ 'general.read_more' | t }}</a></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}
{
  "name": "Journal",
  "settings": []
}
{% endschema %}
