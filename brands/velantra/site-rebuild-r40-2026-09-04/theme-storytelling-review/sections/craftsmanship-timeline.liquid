<section class="craft-timeline" aria-labelledby="CraftTitle-{{ section.id }}">
  <div class="craft-intro">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 id="CraftTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
  </div>
  <div class="craft-strip" tabindex="0" role="region" aria-label="{{ 'general.craftsmanship_stages' | t }}">
    <ol class="craft-grid" style="--craft-columns:{{ section.blocks.size }}">
      {% for block in section.blocks %}
        <li class="craft-card" {{ block.shopify_attributes }}>
          <div class="craft-media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '290, 400, 600, 800, 1000', sizes: '(min-width: 1024px) 25vw, 290px', alt: block.settings.alt }}
            {% elsif block.settings.default_asset != blank %}
              <img src="{{ block.settings.default_asset | asset_url }}" width="1024" height="1024" alt="{{ block.settings.alt | escape }}" loading="lazy">
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          {% if block.settings.day != blank %}<p class="craft-day">{{ block.settings.day | escape }}</p>{% endif %}
          <h3>{{ block.settings.heading | escape }}</h3>
          <div class="craft-copy">{{ block.settings.text }}</div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% stylesheet %}
  .craft-timeline{padding-bottom:48px}
  .craft-intro{max-width:900px;margin:0 auto;padding:80px 24px 96px;text-align:center}
  .craft-intro .eyebrow{display:flex;align-items:center;justify-content:center;gap:16px;font-size:10px;line-height:1.3;margin-bottom:32px}.craft-intro .eyebrow:before,.craft-intro .eyebrow:after{content:"";width:16px;height:1px;background:var(--color-line)}
  .craft-intro h2{font-size:clamp(22px,2.2vw,38px);line-height:1.25;margin-bottom:32px}
  .craft-intro .rte{max-width:672px;margin:auto;font-size:13px;line-height:1.5}
  .craft-intro .rte p{margin:0}
  .craft-strip{padding:0 12px;scroll-snap-type:x mandatory;scroll-padding-inline:12px;scrollbar-width:thin;scrollbar-color:var(--color-line) transparent}
  .craft-grid{display:grid;grid-template-columns:repeat(var(--craft-columns),minmax(0,1fr));gap:12px;margin:0;padding:0;list-style:none}
  .craft-card{display:flex;flex-direction:column;min-width:0;scroll-snap-align:start;position:relative}
  .craft-media{aspect-ratio:341/272;margin-bottom:24px;overflow:hidden;background:var(--studio-bg)}
  .template-product .craft-media{aspect-ratio:1}
  .craft-media img,.craft-media svg{width:100%;height:100%;object-fit:cover}.craft-media img{filter:saturate(.8);transition:filter .7s}.craft-card:hover .craft-media img{filter:saturate(1)}
  .craft-day{font-size:10px;font-weight:500;line-height:1.3;letter-spacing:1px;text-transform:uppercase;margin:0 0 12px}
  .craft-card h3{font-size:25px;line-height:1.2;margin:0 0 12px}
  .craft-copy{max-width:38ch;font-size:13px;line-height:1.35}
  .craft-copy p{margin:0}
  @media(max-width:1023px){.craft-strip{overflow-x:auto;padding-bottom:8px;overscroll-behavior-inline:contain}.craft-grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:290px;width:max-content}}
  @media(max-width:767px){.craft-intro{padding:48px 12px 56px}.craft-intro .eyebrow{font-size:9px;margin-bottom:24px}.craft-intro h2{margin-bottom:24px}.craft-intro .rte{font-size:11px;line-height:1.4}.craft-day{font-size:9px}.craft-card h3{font-size:17.11px}.craft-copy{font-size:11px;line-height:1.35}}
{% endstylesheet %}
{% javascript %}
  document.addEventListener('keydown', event => {
    const strip = event.target.closest('.craft-strip');
    if (!strip || strip.scrollWidth <= strip.clientWidth) return;
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    const grid = strip.querySelector('.craft-grid');
    const step = strip.querySelector('.craft-card').getBoundingClientRect().width + parseFloat(getComputedStyle(grid).gap);
    const maximum = strip.scrollWidth - strip.clientWidth;
    let left = strip.scrollLeft;
    if (event.key === 'Home') left = 0;
    if (event.key === 'End') left = maximum;
    if (event.key === 'ArrowLeft') left -= step;
    if (event.key === 'ArrowRight') left += step;
    strip.scrollTo({ left: Math.max(0, Math.min(maximum, left)), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
{% endjavascript %}
{% schema %}
{
  "name": "Leather timeline",
  "max_blocks": 4,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Craftsmanship"},
    {"type":"text","id":"heading","label":"Heading","default":"VALUE IN THE MAKING"},
    {"type":"richtext","id":"text","label":"Introduction","default":"<p>The character of the Vivienne begins in the leather.</p><p>From the first cut to the final detail, explore the elements that give the bag its shape, texture and quiet presence.</p>"}
  ],
  "blocks":[{
    "type":"stage","name":"Stage","settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"default_asset","label":"Included image filename"},
      {"type":"text","id":"alt","label":"Image description"},
      {"type":"text","id":"day","label":"Day or stage label"},
      {"type":"text","id":"heading","label":"Heading","default":"Leather Selection & Cutting"},
      {"type":"richtext","id":"text","label":"Description"}
    ]
  }],
  "presets":[{"name":"Leather timeline","blocks":[{"type":"stage","settings":{"day":"Day 1","heading":"Leather Selection & Cutting"}},{"type":"stage","settings":{"day":"Day 4–8","heading":"Thread Selection & Stitching"}},{"type":"stage","settings":{"day":"Finishing","heading":"Edge Paint & Finishing"}},{"type":"stage","settings":{"day":"Final review","heading":"Final Quality Inspection"}}]}]
}
{% endschema %}
