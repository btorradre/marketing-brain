{% comment %}
  PDP — Customize Your Tote (companion accessories grid with quick-add)
{% endcomment %}

<section
  class="pdp-customize pdp-section"
  data-section-id="{{ section.id }}"
  data-section-type="pdp-customize"
  style="--pdp-bg: {{ section.settings.bg_color }};"
>
  <div class="pdp-customize__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pdp-customize__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pdp-customize__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="pdp-customize__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="pdp-customize__grid">
      {%- for block in section.blocks -%}
        {%- assign p = all_products[block.settings.product] -%}
        {%- if p != blank -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          <article class="pdp-customize__card" {{ block.shopify_attributes }}>
            <a class="pdp-customize__media" href="{{ p.url }}">
              {%- if p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  widths: '240, 360, 480, 600',
                  sizes: '(min-width: 768px) 33vw, 50vw',
                  alt: p.title,
                  class: 'pdp-customize__img' }}
              {%- endif -%}
            </a>
            <div class="pdp-customize__info">
              <h3 class="pdp-customize__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
              {%- if block.settings.tagline != blank -%}
                <p class="pdp-customize__tag">{{ block.settings.tagline }}</p>
              {%- endif -%}
              <p class="pdp-customize__price">{{ p.price | money }}</p>
              <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pdp-customize__form">
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="pdp-customize__btn"{% unless v.available %} disabled{% endunless %}>
                  {%- if v.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
                </button>
              </form>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .pdp-customize {
    background: var(--pdp-bg, #faf8f4);
    padding: clamp(48px, 6vw, 80px) clamp(20px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .pdp-customize__inner { max-width: 1280px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .pdp-customize__eyebrow {
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    text-align: center; opacity: 0.6; margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .pdp-customize__heading {
    font-family: var(--font-stack-header, 'Cormorant', serif);
    font-weight: 400; font-size: clamp(26px, 2.6vw, 36px);
    text-align: center; letter-spacing: -0.01em; margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .pdp-customize__intro {
    text-align: center; max-width: 540px; margin: 0 auto clamp(32px, 4vw, 48px);
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 14px; line-height: 1.6; opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .pdp-customize__grid {
    display: grid; gap: clamp(20px, 2.5vw, 32px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { #shopify-section-{{ section.id }} .pdp-customize__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { #shopify-section-{{ section.id }} .pdp-customize__grid { grid-template-columns: repeat(3, 1fr); } }
  #shopify-section-{{ section.id }} .pdp-customize__card {
    background: #ffffff; padding: 16px;
  }
  #shopify-section-{{ section.id }} .pdp-customize__media {
    display: block; aspect-ratio: 1/1; overflow: hidden; background: #f5f3ee;
  }
  #shopify-section-{{ section.id }} .pdp-customize__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 500ms cubic-bezier(.4,0,.2,1);
  }
  #shopify-section-{{ section.id }} .pdp-customize__media:hover .pdp-customize__img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .pdp-customize__info { padding: 16px 4px 4px; }
  #shopify-section-{{ section.id }} .pdp-customize__title {
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 15px; font-weight: 500; margin: 0 0 6px;
  }
  #shopify-section-{{ section.id }} .pdp-customize__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .pdp-customize__tag {
    font-size: 12px; opacity: 0.65; margin: 0 0 8px;
    font-family: var(--font-stack-base, 'Inter', sans-serif);
  }
  #shopify-section-{{ section.id }} .pdp-customize__price {
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 14px; margin: 0 0 12px; opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .pdp-customize__btn {
    display: block; width: 100%; padding: 12px 16px;
    background: transparent; color: #1a1a1a; border: 1px solid #1a1a1a;
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    cursor: pointer; transition: background 200ms, color 200ms;
  }
  #shopify-section-{{ section.id }} .pdp-customize__btn:hover { background: #1a1a1a; color: #ffffff; }
  #shopify-section-{{ section.id }} .pdp-customize__btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

{% schema %}
{
  "name": "PDP · Customize",
  "tag": "section",
  "class": "shopify-section--pdp-customize",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MAKE IT YOURS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customize Your Tote" },
    { "type": "richtext", "id": "intro", "label": "Intro copy" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f4" }
  ],
  "blocks": [
    {
      "type": "companion",
      "name": "Companion item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "tagline", "label": "Tagline (optional)", "default": "Slip inside" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "PDP · Customize", "blocks": [{ "type": "companion" }, { "type": "companion" }, { "type": "companion" }] }
  ],
  "disabled_on": { "groups": ["header", "footer", "aside"] }
}
{% endschema %}
