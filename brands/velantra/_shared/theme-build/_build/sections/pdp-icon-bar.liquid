{% comment %}
  PDP — 3-column icon bar (Design / Quality / Sustainability spine)
  Velantra • Cuyana-style PDP system
{% endcomment %}

<section
  class="pdp-icon-bar pdp-section"
  data-section-id="{{ section.id }}"
  data-section-type="pdp-icon-bar"
  style="--pdp-bg: {{ section.settings.bg_color }}; --pdp-fg: {{ section.settings.text_color }};"
>
  <div class="pdp-icon-bar__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="pdp-icon-bar__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pdp-icon-bar__row" data-cols="{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="pdp-icon-bar__col" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="pdp-icon-bar__icon">
              {{ block.settings.icon }}
            </div>
          {%- elsif block.settings.icon_image != blank -%}
            <div class="pdp-icon-bar__icon pdp-icon-bar__icon--img">
              {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: block.settings.eyebrow }}
            </div>
          {%- endif -%}

          {%- if block.settings.eyebrow != blank -%}
            <p class="pdp-icon-bar__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}

          {%- if block.settings.headline != blank -%}
            <h3 class="pdp-icon-bar__title">{{ block.settings.headline }}</h3>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <div class="pdp-icon-bar__body rte">{{ block.settings.body }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .pdp-icon-bar {
    background: var(--pdp-bg, #faf8f4);
    color: var(--pdp-fg, #1a1a1a);
    padding: clamp(48px, 7vw, 96px) clamp(20px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__heading {
    font-family: var(--font-stack-header, 'Cormorant', serif);
    font-weight: 400;
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: -0.01em;
    text-align: center;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__row {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .pdp-icon-bar__row[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
    #shopify-section-{{ section.id }} .pdp-icon-bar__row[data-cols="2"] { grid-template-columns: repeat(2, 1fr); }
    #shopify-section-{{ section.id }} .pdp-icon-bar__row[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__col {
    text-align: center;
    padding: 0 8px;
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 20px;
    color: currentColor;
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__icon svg { width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .pdp-icon-bar__icon--img img { width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ section.id }} .pdp-icon-bar__eyebrow {
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.65;
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__title {
    font-family: var(--font-stack-header, 'Cormorant', serif);
    font-weight: 500;
    font-size: clamp(20px, 2vw, 24px);
    letter-spacing: -0.005em;
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .pdp-icon-bar__body {
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 14px;
    line-height: 1.6;
    max-width: 36ch;
    margin: 0 auto;
    color: currentColor;
    opacity: 0.85;
  }
</style>

{% schema %}
{
  "name": "PDP · Icon Bar",
  "tag": "section",
  "class": "shopify-section--pdp-icon-bar",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "text", "id": "heading", "label": "Optional heading" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f4" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "header", "content": "Icon" },
        { "type": "html", "id": "icon", "label": "Inline SVG (preferred)", "info": "Paste an SVG. Will inherit text color." },
        { "type": "image_picker", "id": "icon_image", "label": "Icon image (fallback)" },
        { "type": "header", "content": "Copy" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "DESIGN" },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Relaxed & Versatile" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Designed for everyday use, made to wear in beautifully.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "PDP · Icon Bar (Design / Quality / Sustainability)",
      "blocks": [
        { "type": "pillar", "settings": { "eyebrow": "DESIGN", "headline": "Relaxed & Versatile", "body": "<p>An everyday silhouette designed to carry your life with ease.</p>" } },
        { "type": "pillar", "settings": { "eyebrow": "QUALITY", "headline": "Made to Last", "body": "<p>Full-grain leather and reinforced stitching, finished by hand.</p>" } },
        { "type": "pillar", "settings": { "eyebrow": "SUSTAINABILITY", "headline": "Fewer, Better", "body": "<p>Tanned at LWG-certified tanneries — leather meant to last decades, not seasons.</p>" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer", "aside"] }
}
{% endschema %}
