{% comment %}
  PDP — Breadcrumb (Shop > Bags > Product)
{% endcomment %}

<nav
  class="pdp-breadcrumb"
  data-section-id="{{ section.id }}"
  data-section-type="pdp-breadcrumb"
  aria-label="Breadcrumb"
>
  <div class="pdp-breadcrumb__inner">
    <a href="{{ routes.root_url }}">Shop</a>
    {%- if section.settings.collection != blank -%}
      {%- assign col = collections[section.settings.collection] -%}
      {%- if col != blank -%}
        <span aria-hidden="true">/</span>
        <a href="{{ col.url }}">{{ col.title }}</a>
      {%- endif -%}
    {%- elsif product.collections.first != blank -%}
      <span aria-hidden="true">/</span>
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    {%- endif -%}
    {%- if product != blank -%}
      <span aria-hidden="true">/</span>
      <span class="pdp-breadcrumb__current" aria-current="page">{{ product.title }}</span>
    {%- endif -%}
  </div>
</nav>

<style>
  #shopify-section-{{ section.id }} .pdp-breadcrumb {
    background: #ffffff; padding: 16px clamp(20px, 4vw, 40px) 0;
  }
  #shopify-section-{{ section.id }} .pdp-breadcrumb__inner {
    max-width: 1440px; margin: 0 auto;
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #6a6a6a;
  }
  #shopify-section-{{ section.id }} .pdp-breadcrumb__inner a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .pdp-breadcrumb__inner a:hover { color: #1a1a1a; }
  #shopify-section-{{ section.id }} .pdp-breadcrumb__inner span[aria-hidden] { margin: 0 8px; opacity: 0.5; }
  #shopify-section-{{ section.id }} .pdp-breadcrumb__current { color: #1a1a1a; }
</style>

{% schema %}
{
  "name": "PDP · Breadcrumb",
  "tag": "section",
  "class": "shopify-section--pdp-breadcrumb",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Force a parent collection (optional)" }
  ],
  "presets": [{ "name": "PDP · Breadcrumb" }],
  "disabled_on": { "groups": ["header", "footer", "aside"] }
}
{% endschema %}
