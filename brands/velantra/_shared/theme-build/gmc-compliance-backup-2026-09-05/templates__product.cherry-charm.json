            "variant_labels": true,
            "picker_type": "button",
            "product_dynamic_variants_enable": true,
            "color_swatches": true
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "surface_pickup_enable": false,
            "show_gift_card_recipient": false
          }
        },
        "blurb": {
          "type": "text",
          "settings": {
            "text": "<p>A leather cherry charm in glossy red. Clips to any zipper pull, handle, or strap.<\/p>"
          }
        },
        "hint": {
          "type": "custom",
          "settings": {
            "code": "{% render 'pdp-send-hint' %}"
          }
        },
        "inline_acc": {
          "type": "custom",
          "settings": {
            "code": "{% render 'pdp-inline-accessories' %}"
          }
        },
        "in_store": {
          "type": "custom",
          "settings": {
            "code": "{% render 'pdp-in-store' %}"
          }
        },
        "reviews": {
          "type": "custom",
          "settings": {
            "code": "{% render 'pdp-reviews' %}"
          }
        },
        "tab_details": {
          "type": "tab",
          "settings": {
            "title": "Details",
            "content": "<p>A little sweetness for your everyday carry. The Velantra Cherry Charm clips onto a handle or zip pull and finishes a look with a playful, collectible wink.<\/p>"
          }
        },
        "tab_materials": {
          "type": "tab",
          "settings": {
            "title": "Materials &amp; Care",
            "content": "<p><strong>Material<\/strong><br>Handcrafted with smooth leather and precision detailing.<\/p><p><strong>Care<\/strong><br>Wipe clean with a soft, dry cloth. Keep away from prolonged moisture to preserve the finish.<\/p>"
          }
        },
        "tab_ship": {
          "type": "tab",
          "settings": {
            "title": "Shipping & Returns",
            "content": "<p>Free shipping on all orders over $75. Once your order is placed, it ships and arrives within 7 to 10 business days.<\/p><p>We accept returns within 30 days of delivery for items in original, unused condition with all tags attached. Exchanges are always free. If something isn&rsquo;t right, reach out &mdash; we&rsquo;ll make it right.<\/p>"
          }
        },
        "tab_warranty": {
          "type": "tab",
          "settings": {
            "title": "Two Year Warranty",
            "content": "<p>Every Velantra piece is covered for two years against defects in materials and construction. If anything goes wrong in normal use, we&rsquo;ll repair or replace it.<\/p><p>After two years, we continue to offer repair service for the cost of materials. Designed to last decades, not seasons.<\/p>"
          }
        }
      },
      "block_order": [
        "blurb",
        "price",
        "variant_picker",
        "buy_buttons",
        "description",
        "size_chart",
        "reviews",
        "tab_details",
        "tab_materials",
        "tab_ship",
        "tab_warranty",
        "hint",
        "inline_acc",
        "in_store"
