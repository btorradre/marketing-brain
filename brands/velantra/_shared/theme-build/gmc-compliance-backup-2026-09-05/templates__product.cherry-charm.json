            "eyebrow": "DESIGN",
            "headline": "A Small Statement",
            "body": "<p>A glossy leather cherry on a brass swivel. The smallest way to make a bag your own.<\/p>"
          }
        },
        "pillar_1": {
          "type": "pillar",
          "settings": {
            "eyebrow": "CRAFT",
            "headline": "Patent-Finish Leather",
            "body": "<p>Hand-finished gloss. Won&rsquo;t crack, won&rsquo;t chip, even after a year clinking around in a tote.<\/p>"
          }
        },
        "pillar_2": {
          "type": "pillar",
          "settings": {
            "eyebrow": "LONGEVITY",
            "headline": "Hand-Shaped, Each One",
            "body": "<p>Every charm cut, shaped, and finished from a single piece of leather. No two are identical.<\/p>"
          }
        }
