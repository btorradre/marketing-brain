        "eyebrow": "The Weekender Edit · For Him",
        "intro": "A considered companion to a well-dressed day. Clean structure, distinctive leather details and an easy sense of purpose.",
        "details": "A statement in the details: the Eleanor brings together rolled handles, a contoured flap and a generous, structured silhouette. Choose Cognac, Army Green, Espresso or all-leather Black.",
        "fit_copy": "A generous, open interior for the pieces you like to keep close. One nominal size, with a wide slip pocket for smaller belongings. Compare the dimensions below with your essentials before ordering.",
        "offer_heading": "Your next signature piece.",
        "offer_caption": "Choose your color and make it part of your everyday wardrobe. No code needed.",
        "closing_heading": "Good style goes with you.",
        "closing_body": "Over a weekend knit or beside a tailored coat, Eleanor is an understated finishing touch for the way you move through the day.",
        "dispatch_days": 10,
        "transit_min": 7,
        "transit_max": 10,
        "black_preorder": true,
        "recommendation_collection": "handbags"
