{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_color = current_variant.option1
  assign media_blocks = section.blocks | where: 'type', 'image'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign review_count = review_blocks.size
  assign rating_sum = 0
  for review in review_blocks
    assign rating_sum = rating_sum | plus: review.settings.rating
  endfor
  if review_count > 0
    assign rating_average = rating_sum | times: 1.0 | divided_by: review_count | round: 1
  endif
  assign is_preorder = false
  if current_color == 'Black' and section.settings.black_preorder
    assign is_preorder = true
  endif
  assign form_id = 'wk-product-form-' | append: section.id
  assign main_image = ''
  for media in media_blocks
    if media.settings.color == current_color
      assign main_image = media.settings.url
      break
    endif
  endfor
%}
<section class="wk-product" data-wk-product data-audience="{{ section.settings.audience }}" data-product-id="{{ product.id }}" data-country="{{ localization.country.iso_code }}" data-dispatch="{{ section.settings.dispatch_days }}" data-transit-min="{{ section.settings.transit_min }}" data-transit-max="{{ section.settings.transit_max }}" data-black-preorder="{{ section.settings.black_preorder }}">
<div class="wk-product-grid">
<div class="wk-gallery-wrap">
<div class="wk-gallery" data-wk-gallery aria-label="{{ 'wk_editorial.product_photos' | t }}">
{% for media in media_blocks %}
<button type="button" class="wk-gallery-item {% if media.settings.kind == 'hero' %}wk-gallery-hero{% endif %}" data-wk-image data-color="{{ media.settings.color | escape }}" data-caption="{{ media.settings.caption | escape }}" aria-label="{{ 'wk_editorial.enlarge' | t }}: {{ media.settings.caption | escape }}" {% unless media.settings.color == current_color %}hidden{% endunless %} {{ media.shopify_attributes }}>
<img src="{{ media.settings.url }}" alt="{{ media.settings.caption | escape }}" width="1086" height="1448" {% if media.settings.url == main_image %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %} style="object-position:50% {{ media.settings.focus_y }}%">
<span class="wk-zoom-mark" aria-hidden="true">+</span>
</button>
{% endfor %}
</div>
<div class="wk-gallery-nav"><button type="button" data-wk-prev aria-label="{{ 'wk_editorial.previous_photo' | t }}">←</button><span data-wk-image-counter aria-live="polite">1 / 10</span><button type="button" data-wk-next aria-label="{{ 'wk_editorial.next_photo' | t }}">→</button></div>
</div>
<div class="wk-buy-column">
<div class="wk-buy-box">
<p class="wk-kicker">{{ section.settings.eyebrow | escape }}</p>
<h1>{{ product.title | escape }}</h1>
<a class="wk-review-link" href="#wk-reviews"><span class="wk-stars {% if review_count == 0 %}wk-stars-empty{% endif %}" aria-hidden="true">{% if review_count > 0 %}★★★★★{% else %}☆☆☆☆☆{% endif %}</span><span>{% if review_count > 0 %}{{ 'wk_editorial.review_count' | t: count: review_count }}{% else %}{{ 'wk_editorial.first_review' | t }}{% endif %}</span></a>
<div class="wk-price-row" aria-live="polite"><span class="wk-price" data-wk-price>{{ current_variant.price | money_with_currency }}</span><s data-wk-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s><span class="wk-offer-chip" data-wk-sale {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ 'wk_editorial.sale' | t }}</span></div>
<p class="wk-short-description">{{ section.settings.intro | escape }}</p>
{% form 'product', product, id: form_id, class: 'wk-product-form' %}
<input type="hidden" name="id" value="{{ current_variant.id }}" data-wk-variant-input>
<input type="hidden" name="quantity" value="1">
<fieldset class="wk-colors"><legend>{{ 'wk_editorial.color' | t }}: <span data-wk-color-name>{{ current_color | escape }}</span></legend>
{% for variant in product.variants %}
{% assign swatch_url = '' %}{% for media in media_blocks %}{% if media.settings.color == variant.option1 and media.settings.kind == 'packshot' %}{% assign swatch_url = media.settings.url %}{% break %}{% endif %}{% endfor %}
<input class="wk-visually-hidden" type="radio" name="wk-color" id="wk-color-{{ variant.id }}" value="{{ variant.id }}" data-wk-color-radio {% if variant.id == current_variant.id %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
<label for="wk-color-{{ variant.id }}" title="{{ variant.option1 | escape }}"><img src="{{ swatch_url }}" alt="" width="72" height="72" loading="lazy"><span>{{ variant.option1 | escape }}</span></label>
{% endfor %}
</fieldset>
<div class="wk-delivery"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg><p><span data-wk-arrival>{{ 'wk_editorial.dispatch_fallback' | t: days: section.settings.dispatch_days }}</span><small data-wk-delivery-note>{{ 'wk_editorial.transit_note' | t: days: section.settings.dispatch_days, min: section.settings.transit_min, max: section.settings.transit_max }}</small></p></div>
<button class="wk-button wk-add" type="submit" data-wk-add {% unless current_variant.available %}disabled{% endunless %}>{% unless current_variant.available %}{{ 'wk_editorial.sold_out' | t }}{% else %}{% if is_preorder %}{{ 'wk_editorial.preorder' | t }}{% else %}{{ 'wk_editorial.add_to_cart' | t }}{% endif %}{% endunless %}</button>
<p class="wk-form-error" data-wk-product-error role="alert" hidden></p>
{% endform %}
<div class="wk-tags"><span data-wk-material>{% if current_color == 'Black' %}{{ 'wk_editorial.leather_exterior' | t }}{% else %}{{ 'wk_editorial.leather_canvas' | t }}{% endif %}</span><a href="/policies/refund-policy">{{ 'wk_editorial.return_tag' | t }}</a><a href="/policies/refund-policy">{{ 'wk_editorial.warranty_tag' | t }}</a><a href="/policies/shipping-policy">{{ 'wk_editorial.shipping_tag' | t }}</a></div>
<div class="wk-accordions">
<details><summary>{{ 'wk_editorial.details' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ section.settings.details | escape }}</p><ul><li data-wk-detail-material>{% if current_color == 'Black' %}{{ 'wk_editorial.black_detail' | t }}{% else %}{{ 'wk_editorial.canvas_detail' | t }}{% endif %}</li><li>{{ 'wk_editorial.construction_detail' | t }}</li><li>{{ 'wk_editorial.interior_detail' | t }}</li></ul><p class="wk-fine-print">{{ 'wk_editorial.care_detail' | t }}</p></div></details>
<details><summary>{{ 'wk_editorial.what_fits' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ section.settings.fit_copy | escape }}</p><dl class="wk-dimensions"><div><dt>{{ 'wk_editorial.width' | t }}</dt><dd>18 in</dd></div><div><dt>{{ 'wk_editorial.height' | t }}</dt><dd>14.5 in</dd></div><div><dt>{{ 'wk_editorial.depth' | t }}</dt><dd>7 in</dd></div></dl><p class="wk-fine-print">{{ 'wk_editorial.size_note' | t }}</p></div></details>
<details><summary>{{ 'wk_editorial.delivery_returns' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ 'wk_editorial.transit_note' | t: days: section.settings.dispatch_days, min: section.settings.transit_min, max: section.settings.transit_max }}</p><p data-wk-preorder-detail {% unless is_preorder %}hidden{% endunless %}>{{ 'wk_editorial.black_preorder_detail' | t }}</p><p>{{ 'wk_editorial.returns_detail' | t }}</p><p>{{ 'wk_editorial.warranty_detail' | t }}</p><a href="/policies/shipping-policy">{{ 'wk_editorial.shipping_policy' | t }}</a> · <a href="/policies/refund-policy">{{ 'wk_editorial.returns_policy' | t }}</a></div></details>
</div>
<div class="wk-offer-panel"><h2>{{ section.settings.offer_heading | escape }}</h2><p data-wk-offer-body>{% if current_variant.compare_at_price > current_variant.price %}{% assign saving = current_variant.compare_at_price | minus: current_variant.price | money %}{{ 'wk_editorial.offer_body' | t: amount: saving }}{% else %}{{ 'wk_editorial.offer_regular' | t }}{% endif %}</p><p>{{ section.settings.offer_caption | escape }}</p></div>
</div>
</div>
</div>
<div class="wk-service-strip">
<div><span aria-hidden="true">◇</span><h2>{{ 'wk_editorial.service_material' | t }}</h2><p>{{ 'wk_editorial.service_material_body' | t }}</p></div>
<div><span aria-hidden="true">↶</span><h2>{{ 'wk_editorial.service_returns' | t }}</h2><p>{{ 'wk_editorial.service_returns_body' | t }}</p></div>
<div><span aria-hidden="true">◈</span><h2>{{ 'wk_editorial.service_warranty' | t }}</h2><p>{{ 'wk_editorial.service_warranty_body' | t }}</p></div>
<div><span aria-hidden="true">✉</span><h2>{{ 'wk_editorial.service_support' | t }}</h2><a href="mailto:customerservice@velantrafashion.com">{{ 'wk_editorial.service_support_body' | t }}</a></div>
</div>
<section class="wk-reviews" id="wk-reviews" aria-labelledby="wk-reviews-title">
<div class="wk-reviews-heading"><div><p class="wk-kicker">{{ 'wk_editorial.review_kicker' | t }}</p><h2 id="wk-reviews-title">{{ 'wk_editorial.reviews_title' | t }}</h2></div><a class="wk-button wk-button-outline" href="#wk-review-form">{{ 'wk_editorial.write_review' | t }}</a></div>
{% if review_count > 0 %}
<div class="wk-rating-summary"><strong>{{ rating_average }}</strong><div><span class="wk-stars" aria-hidden="true">★★★★★</span><p>{{ 'wk_editorial.based_on_reviews' | t: count: review_count }}</p></div></div>
<div class="wk-review-list">{% for review in review_blocks %}<article class="wk-review" {{ review.shopify_attributes }}><div><strong>{{ review.settings.author | escape }}</strong>{% if review.settings.verified %}<small>{{ 'wk_editorial.verified_buyer' | t }}</small>{% endif %}</div><div><span class="wk-stars" aria-label="{{ 'wk_editorial.rating_out_of' | t: rating: review.settings.rating }}">{% for star in (1..5) %}{% if star <= review.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</span><h3>{{ review.settings.title | escape }}</h3><p>{{ review.settings.body | escape }}</p></div></article>{% endfor %}</div>
{% else %}<div class="wk-review-invitation"><span class="wk-stars wk-stars-empty" aria-hidden="true">☆☆☆☆☆</span><h3>{{ 'wk_editorial.review_invitation_title' | t }}</h3><p>{{ 'wk_editorial.review_invitation_body' | t }}</p></div>{% endif %}
<details class="wk-review-form-wrap" id="wk-review-form"><summary>{{ 'wk_editorial.write_review' | t }}<span aria-hidden="true">+</span></summary>
{% form 'contact', id: 'wk-review-contact', class: 'wk-review-form' %}
{% if form.posted_successfully? %}<p role="status">{{ 'wk_editorial.review_success' | t }}</p>{% endif %}{{ form.errors | default_errors }}
<input type="hidden" name="contact[product]" value="{{ product.title | escape }} ({{ product.id }})">
<input type="hidden" name="contact[request_type]" value="Product review">
<label>{{ 'wk_editorial.your_name' | t }}<input name="contact[name]" autocomplete="name" required maxlength="100"></label><label>{{ 'wk_editorial.email' | t }}<input name="contact[email]" type="email" autocomplete="email" required></label>
<label>{{ 'wk_editorial.your_rating' | t }}<select name="contact[rating]" required><option value="">{{ 'wk_editorial.choose_rating' | t }}</option>{% for rating in (1..5) %}<option value="{{ rating }}">{{ 'wk_editorial.rating_out_of' | t: rating: rating }}</option>{% endfor %}</select></label>
<label>{{ 'wk_editorial.review_title' | t }}<input name="contact[review_title]" required maxlength="150"></label><label class="wk-form-wide">{{ 'wk_editorial.your_review' | t }}<textarea name="contact[body]" required rows="4" maxlength="3000"></textarea></label>
<label class="wk-consent wk-form-wide"><input type="checkbox" name="contact[publication_consent]" value="yes" required><span>{{ 'wk_editorial.review_consent' | t }}</span></label><button type="submit" class="wk-button">{{ 'wk_editorial.submit_review' | t }}</button>
{% endform %}</details>
</section>
{% assign recommendation_collection = section.settings.recommendation_collection %}
{% if recommendation_collection != blank %}<section class="wk-recommendations" aria-labelledby="wk-recommendations-title"><div class="wk-section-heading"><p class="wk-kicker">{{ 'wk_editorial.recommendation_kicker' | t }}</p><h2 id="wk-recommendations-title">{{ 'wk_editorial.recommendations_title' | t }}</h2></div><div class="wk-recommendation-grid">{% assign recommendation_count = 0 %}{% for recommended in recommendation_collection.products limit: 8 %}{% unless recommended.id == product.id %}{% assign recommendation_count = recommendation_count | plus: 1 %}<a class="wk-recommendation-card" href="{{ recommended.url }}">{{ recommended.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(max-width: 700px) 45vw, 23vw' }}<h3>{{ recommended.title | escape }}</h3><p>{{ recommended.price | money_with_currency }}</p><span>{{ 'wk_editorial.discover' | t }} →</span></a>{% if recommendation_count == 4 %}{% break %}{% endif %}{% endunless %}{% endfor %}</div></section>{% endif %}
<div class="wk-editorial-note"><p class="wk-kicker">{{ 'wk_editorial.signature' | t }}</p><h2>{{ section.settings.closing_heading | escape }}</h2><p>{{ section.settings.closing_body | escape }}</p></div>
<div class="wk-sticky-buy" data-wk-sticky hidden><div><strong>{{ product.title | escape }}</strong><small><span data-wk-sticky-color>{{ current_color | escape }}</span> · <span data-wk-sticky-price>{{ current_variant.price | money }}</span></small></div><button class="wk-button" type="submit" form="{{ form_id }}" data-wk-sticky-add {% unless current_variant.available %}disabled{% endunless %}>{% if is_preorder %}{{ 'wk_editorial.preorder' | t }}{% else %}{{ 'wk_editorial.add_to_cart' | t }}{% endif %}</button></div>
<dialog class="wk-lightbox" data-wk-lightbox aria-label="{{ 'wk_editorial.product_photos' | t }}"><button type="button" class="wk-dialog-close" data-wk-lightbox-close aria-label="{{ 'wk_editorial.close' | t }}">×</button><button type="button" class="wk-lightbox-prev" data-wk-lightbox-prev aria-label="{{ 'wk_editorial.previous_photo' | t }}">←</button><figure><img alt="" width="1086" height="1448" data-wk-lightbox-image><figcaption data-wk-lightbox-caption></figcaption></figure><button type="button" class="wk-lightbox-next" data-wk-lightbox-next aria-label="{{ 'wk_editorial.next_photo' | t }}">→</button></dialog>
<dialog class="wk-cart" data-wk-cart aria-labelledby="wk-cart-title"><div class="wk-cart-top"><h2 id="wk-cart-title">{{ 'wk_editorial.your_bag' | t }}</h2><button type="button" data-wk-cart-close aria-label="{{ 'wk_editorial.close' | t }}">×</button></div><div data-wk-cart-items class="wk-cart-items"></div><p data-wk-cart-error role="alert" hidden></p><div class="wk-cart-bottom"><div><span>{{ 'wk_editorial.subtotal' | t }}</span><strong data-wk-cart-total></strong></div><p>{{ 'wk_editorial.cart_shipping_note' | t }}</p><form action="{{ routes.cart_url }}" method="post"><button class="wk-button" type="submit" name="checkout" data-wk-checkout>{{ 'wk_editorial.checkout' | t }}</button></form><button type="button" class="wk-text-button" data-wk-cart-close>{{ 'wk_editorial.continue_shopping' | t }}</button></div></dialog>
<script type="application/json" data-wk-config>{"currency":{{ localization.country.currency.iso_code | default: shop.currency | json }},"locale":{{ request.locale.iso_code | json }},"root":{{ routes.root_url | json }},"variants":{{ product.variants | json }},"add":{{ 'wk_editorial.add_to_cart' | t | json }},"preorder":{{ 'wk_editorial.preorder' | t | json }},"soldOut":{{ 'wk_editorial.sold_out' | t | json }},"adding":{{ 'wk_editorial.adding' | t | json }},"empty":{{ 'wk_editorial.empty_cart' | t | json }},"quantity":{{ 'wk_editorial.quantity' | t | json }},"remove":{{ 'wk_editorial.remove' | t | json }},"error":{{ 'wk_editorial.cart_error' | t | json }},"canvas":{{ 'wk_editorial.leather_canvas' | t | json }},"leather":{{ 'wk_editorial.leather_exterior' | t | json }},"canvasDetail":{{ 'wk_editorial.canvas_detail' | t | json }},"leatherDetail":{{ 'wk_editorial.black_detail' | t | json }},"orderToday":{{ 'wk_editorial.order_today' | t | json }},"international":{{ 'wk_editorial.international_delivery' | t | json }},"saveTemplate":{{ 'wk_editorial.offer_body' | t: amount: '__AMOUNT__' | json }},"regularOffer":{{ 'wk_editorial.offer_regular' | t | json }}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"url":{{ canonical_url | json }},"image":[{{ main_image | json }}],"brand":{"@type":"Brand","name":"Velantra"},"offers":{"@type":"Offer","priceCurrency":{{ shop.currency | json }},"price":{{ current_variant.price | divided_by: 100.0 | json }},"availability":"https://schema.org/{% if current_variant.available %}{% if is_preorder %}PreOrder{% else %}InStock{% endif %}{% else %}OutOfStock{% endif %}"}}</script>
</section>





{% stylesheet %}
@font-face{font-family:'Montserrat';font-weight:600;font-style:normal;font-display:swap;src:url('https://cdn.shopify.com/s/files/1/0627/4092/2433/t/23/assets/wk-editorial-montserrat-600.ttf?v=1789321534') format('truetype')}
@font-face{font-family:'Montserrat';font-weight:400;font-style:normal;font-display:swap;src:url('https://cdn.shopify.com/s/files/1/0627/4092/2433/t/23/assets/wk-editorial-montserrat-400.ttf?v=1789321535') format('truetype')}
@font-face{font-family:'Montserrat';font-weight:500;font-style:normal;font-display:swap;src:url('https://cdn.shopify.com/s/files/1/0627/4092/2433/t/23/assets/wk-editorial-montserrat-500.ttf?v=1789321537') format('truetype')}
@font-face{font-family:'Cormorant Garamond';font-weight:500;font-style:normal;font-display:swap;src:url('https://cdn.shopify.com/s/files/1/0627/4092/2433/t/23/assets/wk-editorial-cormorant-garamond-500.ttf?v=1789321538') format('truetype')}
@font-face{font-family:'Cormorant Garamond';font-weight:600;font-style:normal;font-display:swap;src:url('https://cdn.shopify.com/s/files/1/0627/4092/2433/t/23/assets/wk-editorial-cormorant-garamond-600.ttf?v=1789321539') format('truetype')}
