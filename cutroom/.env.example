# Cutroom environment — copy to .env (local) and mirror on Vercel.
# Real values live in `marketing brain/.env` and in the Vercel project env vars.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

ANTHROPIC_API_KEY=sk-ant-...

# Passcode auth (web/api/login.js)
CUTROOM_ADMIN_KEY=<edit + AI access>
CUTROOM_VIEW_KEY=<view-only, for editors>

# Local server (server.py), optional
CUTROOM_PORT=8765
