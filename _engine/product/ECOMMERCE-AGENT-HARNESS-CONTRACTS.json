  "revision_rules": [
    {
      "change": "broll_asset_only",
      "invalidate": [
        "affected_scene_selection",
        "affected_board_card",
        "dependent_timeline_export",
        "dependent_media_review"
      ],
      "preserve": [
        "narration",
        "speech_speed",
        "word_alignment",
        "unaffected_assets"
      ]
    },
    {
      "change": "script_or_voice",
      "invalidate": [
        "narration_lock_if_authorized_change",
        "word_alignment",
        "dependent_plan_timing",
        "presenter_sync",
        "caption_alignment",
        "dependent_exports_and_reviews"
      ],
      "preserve": [
        "historical_revisions",
        "provider_originals",
        "unaffected_reference_evidence"
      ]
    },
    {
      "change": "style_recipe_version",
      "invalidate": [
        "future_unpinned_context"
      ],
      "preserve": [
        "active_run_pins",
        "prior_export_bindings"
