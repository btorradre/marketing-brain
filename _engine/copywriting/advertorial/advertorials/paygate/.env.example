# Database
DATABASE_URL="postgresql://paygate:paygate@localhost:5432/paygate?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
PORT=3000
NODE_ENV=development
API_VERSION=v1

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-256-bit-encryption-key-here
JWT_SECRET=your-jwt-secret-here

# Processor Credentials — fill in based on your ISO/processor agreement
# NMI (example processor)
NMI_API_KEY=
NMI_SECURITY_KEY=

# TSYS / Global Payments
TSYS_MERCHANT_ID=
TSYS_DEVICE_ID=
TSYS_API_KEY=
TSYS_API_SECRET=

# Fiserv / First Data
FISERV_API_KEY=
FISERV_API_SECRET=
FISERV_MERCHANT_ID=

# ACH / ODFI Bank Settings
ACH_ODFI_ROUTING=        # Your sponsor bank's routing number
ACH_ODFI_NAME=           # Your sponsor bank name
ACH_COMPANY_ID=          # Your company's ACH ID (assigned by bank)
ACH_COMPANY_NAME=        # Your company name for ACH
ACH_SFTP_HOST=           # Bank's SFTP for NACHA file submission
ACH_SFTP_USER=
ACH_SFTP_KEY_PATH=

# KYC Provider (e.g., Persona, Jumio, Onfido)
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# Webhook Signing
WEBHOOK_SIGNING_SECRET=

# Logging
LOG_LEVEL=info
