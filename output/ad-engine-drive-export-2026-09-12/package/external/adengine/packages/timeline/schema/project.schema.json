            "image",
            "text",
            "shape",
            "caption"
          ]
        },
        "name": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": "integer",
          "minimum": 1
        },
        "in": {
          "type": "integer",
          "minimum": 0
        },
        "out": {
          "type": "integer",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reverse": {
          "type": "boolean"
        },
        "freeze": {
          "type": "integer",
          "minimum": 0
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "crop": {
