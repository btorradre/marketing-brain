<script>
(function(){
  var bundles = {
    '1': { price: 29.99, compare: 44.99, per: 29.99, label: 'Buy 1 — 30-Day' },
    '2': { price: 59.98, compare: 134.97, per: 19.99, label: 'Buy 2 Get 1 Free' },
    '3': { price: 89.97, compare: 224.95, per: 17.99, label: 'Buy 3 Get 2 Free' }
  };
  var SUB_DISCOUNT = 0.80;

  document.querySelectorAll('.mt-bundle').forEach(function(el) {
    el.addEventListener('click', function() {
      document.querySelectorAll('.mt-bundle').forEach(function(b) { b.classList.remove('mt-selected'); });
      el.classList.add('mt-selected');
      el.querySelector('input[type=radio]').checked = true;
      mtUpdatePrices();
    });
  });
  var subEl = document.getElementById('mtSub');
  if (subEl) subEl.addEventListener('change', mtUpdatePrices);

  function mtUpdatePrices() {
    var sel = document.querySelector('input[name="mt-bundle"]:checked');
    if (!sel) return;
    var b = bundles[sel.value];
    var isSub = document.getElementById('mtSub').checked;
    var price = isSub ? Math.round(b.price * SUB_DISCOUNT * 100) / 100 : b.price;
    var save = Math.round(b.compare - price);
    document.getElementById('mtPriceNew').textContent = '$' + price.toFixed(2);
    document.getElementById('mtPriceOld').textContent = '$' + b.compare.toFixed(2);
    document.getElementById('mtSavePill').textContent = 'SAVE $' + save;
    document.getElementById('mtAtcPrice').textContent = '$' + price.toFixed(2);
    document.getElementById('mtStickyPrice').textContent = '$' + price.toFixed(2) + ' · ' + b.label;
  }

  window.mtAddToCart = function() {
    var sel = document.querySelector('input[name="mt-bundle"]:checked');
    var b = bundles[sel.value];
    var isSub = document.getElementById('mtSub').checked;
    var qty = sel.value === '1' ? 1 : (sel.value === '2' ? 2 : 3);
    var variantId = {{ variant_id }};
    if (!variantId) { alert('Please connect a Shopify variant ID to enable checkout.'); return; }
    var payload = { items: [{ id: variantId, quantity: qty }] };
    fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
      .then(function(r){ return r.json(); })
      .then(function(){ window.location.href = '/cart'; });
  };

  window.mtSwapImg = function(thumb, src) {
    document.getElementById('mtMainImg').src = src;
    document.querySelectorAll('.mt-thumb').forEach(function(t) { t.classList.remove('active'); });
    thumb.classList.add('active');
  };

  document.querySelectorAll('.mt-faq-q').forEach(function(q) {
    q.addEventListener('click', function() { q.parentElement.classList.toggle('open'); });
  });

  var heroAtc = document.getElementById('mtHeroAtc');
  var stickyEl = document.getElementById('mtStickyCta');
  if (heroAtc && stickyEl && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          stickyEl.classList.remove('mt-visible');
          document.body.classList.remove('mt-has-sticky');
        } else {
          stickyEl.classList.add('mt-visible');
          document.body.classList.add('mt-has-sticky');
        }
      });
    }, { threshold: 0 });
    obs.observe(heroAtc);
  }

  mtUpdatePrices();
})();
</script>

