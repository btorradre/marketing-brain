{% comment %}
  ==============================================================
  MOTILLI PDP — Shopify Section
  ==============================================================
  HOW TO USE:
  1. In your theme code editor, create: sections/motilli-pdp.liquid
     Paste this entire file into it.
  2. Create template: templates/product.motilli.json
     {
       "sections": { "main": { "type": "motilli-pdp" } },
       "order": ["main"]
     }
  3. In Product admin → Theme template → choose "motilli"
  4. Hero gallery pulls from the product's images automatically (first 4).
  5. Upload these files to Online Store → Theme → Edit Code → Assets:
       motilli-testimonial-margaret.jpg
       motilli-testimonial-diana.jpg
       motilli-timeline-1.jpg
       motilli-timeline-2.jpg
       motilli-timeline-3.jpg
       motilli-timeline-4.jpg
       motilli-mechanism.jpg
       motilli-ingredient-celery.jpg
       motilli-ingredient-chlorophyll.jpg
       motilli-ingredient-fos.jpg
       motilli-ingredient-vitamins.jpg
       motilli-logo.png
  6. (Optional) Wire the ATC to Shopify by replacing mtAddToCart()
     with a POST to /cart/add.js using the product's variant ID.
  ==============================================================
{% endcomment %}

{% assign hero_1 = 'motilli-hero-1.jpg' | asset_url %}
{% assign hero_2 = hero_1 %}
{% assign hero_3 = hero_1 %}
{% assign hero_4 = hero_1 %}
{% assign hero_thumb = hero_1 %}
{% if product and product.images.size > 0 %}
  {% assign hero_1 = product.images[0] | img_url: '1200x' %}
  {% if product.images[1] %}{% assign hero_2 = product.images[1] | img_url: '1200x' %}{% endif %}
  {% if product.images[2] %}{% assign hero_3 = product.images[2] | img_url: '1200x' %}{% endif %}
  {% if product.images[3] %}{% assign hero_4 = product.images[3] | img_url: '1200x' %}{% endif %}
  {% assign hero_thumb = product.featured_image | img_url: '400x' %}
{% endif %}
{% assign product_title = 'Motilli' %}
{% if product and product.title %}{% assign product_title = product.title %}{% endif %}
{% assign variant_id = 0 %}
{% if product and product.selected_or_first_available_variant %}{% assign variant_id = product.selected_or_first_available_variant.id %}{% endif %}

