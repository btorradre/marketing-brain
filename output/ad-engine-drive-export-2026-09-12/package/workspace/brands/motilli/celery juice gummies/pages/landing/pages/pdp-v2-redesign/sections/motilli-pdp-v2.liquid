{%- comment -%}
  Motilli PDP v2 — Arctic Goddess architecture adapted for Motilli
  Single-section build: all CSS/HTML/JS inline. Namespace: mp-
{%- endcomment -%}

{%- assign product = product -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign variant_id = variant.id -%}
{%- assign base_price = variant.price | money_without_trailing_zeros -%}
{%- assign compare_price = variant.compare_at_price | money_without_trailing_zeros -%}

{%- assign selling_plan_id = 0 -%}
{%- for group in product.selling_plan_groups -%}
  {%- for plan in group.selling_plans -%}
    {%- if selling_plan_id == 0 -%}
      {%- assign selling_plan_id = plan.id -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}

{%- assign img1 = product.images[0] | image_url: width: 1200 -%}
{%- assign img2 = product.images[1] | image_url: width: 1200 -%}
{%- assign img3 = product.images[2] | image_url: width: 1200 -%}
{%- assign img4 = product.images[3] | image_url: width: 1200 -%}
{%- assign img5 = product.images[4] | image_url: width: 1200 -%}
{%- assign img6 = product.images[5] | image_url: width: 1200 -%}
{%- assign img7 = product.images[6] | image_url: width: 1200 -%}
{%- assign img8 = product.images[7] | image_url: width: 1200 -%}

<style>
  /* === Motilli PDP v2 — Redesign === */
  .mp-wrap { --mp-green:#2D4A3A; --mp-amber:#C4632A; --mp-cream:#FAF7F0; --mp-white:#FFFFFF; --mp-sage:#E8EEE4; --mp-celery:#8AAE68; --mp-text:#1A2420; --mp-text2:#556259; --mp-muted:#8B9590; --mp-border:#E5E1D6; --mp-red:#B84A3A; --mp-star:#F0A830;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--mp-text); background: var(--mp-cream); line-height: 1.55; font-size: 16px; }
  .mp-wrap *, .mp-wrap *::before, .mp-wrap *::after { box-sizing: border-box; }
  .mp-wrap img { max-width: 100%; display: block; }
  .mp-serif { font-family: 'Fraunces', Georgia, serif; }
  .mp-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .mp-section { padding: 88px 0; }
  .mp-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--mp-amber); margin-bottom: 16px; }
  .mp-h1 { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; margin: 0 0 14px; color: var(--mp-text); }
  .mp-h2 { font-size: 48px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 20px; color: var(--mp-text); }
  .mp-h2-xxl { font-size: 60px; font-weight: 800; letter-spacing: -0.025em; line-height: 1.05; margin: 0 0 24px; color: var(--mp-text); }
  .mp-h3 { font-size: 28px; font-weight: 700; line-height: 1.2; margin: 0 0 12px; color: var(--mp-text); }
  .mp-h4 { font-size: 20px; font-weight: 700; margin: 0 0 8px; color: var(--mp-text); }
  .mp-body-xl { font-size: 22px; line-height: 1.5; font-weight: 500; color: var(--mp-text); }
  .mp-body-l { font-size: 18px; line-height: 1.6; color: var(--mp-text2); }
  .mp-body-m { font-size: 16px; line-height: 1.6; color: var(--mp-text2); }
  .mp-small { font-size: 13px; color: var(--mp-muted); }
  .mp-center { text-align: center; }
  .mp-stars { color: var(--mp-star); letter-spacing: 2px; font-size: 16px; }

  /* Announcement bar */
  .mp-announce { background: var(--mp-green); color: var(--mp-cream); text-align: center; padding: 10px 16px; font-size: 13px; letter-spacing: 0.03em; font-weight: 600; }

  /* HERO */
  .mp-hero { padding: 48px 0 72px; background: var(--mp-cream); }
  .mp-hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: start; }
  .mp-gallery-main { width: 100%; border-radius: 14px; overflow: hidden; background: var(--mp-white); border: 1px solid var(--mp-border); }
  .mp-gallery-main img { width: 100%; height: auto; display: block; }
  .mp-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 12px; }
  .mp-thumb { border: 2px solid var(--mp-border); border-radius: 10px; overflow: hidden; cursor: pointer; background: var(--mp-white); transition: border-color .2s ease; }
  .mp-thumb.active { border-color: var(--mp-green); }
  .mp-thumb img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1; }
  .mp-trust-row-mini { display: flex; gap: 18px; flex-wrap: wrap; justify-content: center; margin-top: 18px; font-size: 13px; color: var(--mp-text2); font-weight: 600; }
  .mp-trust-row-mini span { display: inline-flex; align-items: center; gap: 6px; }
  .mp-label-link { display: inline-block; margin-top: 14px; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; color: var(--mp-amber); text-decoration: none; text-transform: uppercase; }

  .mp-eyebrow-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .mp-eyebrow-pill { background: #F4E8DC; color: var(--mp-amber); padding: 6px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .mp-rating-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  .mp-rating-num { font-weight: 600; font-size: 14px; color: var(--mp-text2); }
  .mp-sold-badge { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--mp-muted); text-transform: uppercase; border-left: 1px solid var(--mp-border); padding-left: 10px; }
  .mp-sub-1 { font-size: 20px; line-height: 1.45; font-weight: 500; color: var(--mp-green); margin: 14px 0 10px; }
  .mp-sub-1 strong { color: var(--mp-text); font-weight: 700; }
  .mp-sub-2 { font-size: 16px; color: var(--mp-text2); margin: 0 0 22px; line-height: 1.55; }
  .mp-divider { border-top: 1px solid var(--mp-border); margin: 22px 0; }
  .mp-price-stack { display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px; flex-wrap: wrap; }
  .mp-price-compare { font-size: 18px; color: var(--mp-red); text-decoration: line-through; font-weight: 500; }
  .mp-price-current { font-size: 36px; font-weight: 800; color: var(--mp-green); letter-spacing: -0.01em; }
  .mp-save-pill { background: var(--mp-amber); color: #fff; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

  .mp-bundles { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .mp-bundle { position: relative; border: 2px solid var(--mp-border); border-radius: 12px; padding: 16px 18px; background: var(--mp-white); cursor: pointer; display: block; transition: all .15s ease; }
  .mp-bundle.mp-selected { border-color: var(--mp-amber); background: #FFF9EF; box-shadow: 0 2px 12px rgba(196,99,42,0.1); }
  .mp-bundle input { position: absolute; opacity: 0; pointer-events: none; }
  .mp-bundle-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .mp-bundle-name { font-weight: 700; font-size: 16px; color: var(--mp-text); }
  .mp-bundle-supply { font-size: 12px; color: var(--mp-muted); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; margin-top: 2px; }
  .mp-bundle-price-row { display: flex; align-items: baseline; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
  .mp-bundle-price { font-weight: 800; font-size: 20px; color: var(--mp-text); }
  .mp-bundle-compare { font-size: 13px; color: var(--mp-muted); text-decoration: line-through; }
  .mp-bundle-savepill { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; background: var(--mp-sage); color: var(--mp-green); padding: 3px 8px; border-radius: 999px; }
  .mp-bundle-per { font-size: 12px; color: var(--mp-muted); margin-top: 4px; }
  .mp-bundle-tag { position: absolute; top: -10px; right: 16px; background: var(--mp-amber); color: #fff; font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; }

  .mp-subscribe { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border: 1px solid var(--mp-border); border-radius: 10px; background: var(--mp-white); margin-bottom: 18px; cursor: pointer; }
  .mp-subscribe input { margin-top: 3px; accent-color: var(--mp-green); }
  .mp-subscribe-copy { font-size: 13px; color: var(--mp-text); line-height: 1.45; }
  .mp-subscribe-copy strong { color: var(--mp-green); font-weight: 700; }

  .mp-shipping-progress { margin-bottom: 16px; }
  .mp-shipping-progress-top { font-size: 12px; color: var(--mp-green); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 6px; }
  .mp-shipping-progress-bar { height: 6px; background: var(--mp-border); border-radius: 999px; overflow: hidden; }
  .mp-shipping-progress-fill { height: 100%; background: var(--mp-celery); border-radius: 999px; transition: width .3s ease; width: 100%; }

  .mp-atc { display: block; width: 100%; padding: 18px 24px; background: var(--mp-green); color: #fff; font-weight: 800; font-size: 16px; letter-spacing: 0.08em; text-transform: uppercase; border: none; border-radius: 10px; cursor: pointer; transition: background .15s ease, transform .1s ease; }
  .mp-atc:hover { background: #1E3328; }
  .mp-atc:active { transform: scale(0.98); }
  .mp-atc-sub { font-size: 12px; color: var(--mp-muted); text-align: center; margin-top: 8px; }
  .mp-scarcity { background: #FEEFEB; color: var(--mp-red); border: 1px solid #F5D5CF; border-radius: 8px; padding: 10px 14px; font-size: 13px; font-weight: 600; margin-top: 14px; line-height: 1.45; }
  .mp-refill { font-size: 12px; color: var(--mp-muted); text-align: center; margin-top: 10px; }
  .mp-trust-icons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--mp-border); }
  .mp-trust-icons-item { text-align: center; font-size: 11px; font-weight: 600; color: var(--mp-text2); letter-spacing: 0.04em; }
  .mp-trust-icons-item-ic { font-size: 22px; margin-bottom: 4px; }

  /* CLINICAL RESULTS */
  .mp-clinical { background: var(--mp-cream); }
  .mp-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 48px; }
  .mp-stat { text-align: center; }
  .mp-stat-num { font-size: 80px; font-weight: 800; color: var(--mp-green); line-height: 1; letter-spacing: -0.03em; margin-bottom: 10px; font-family: 'Fraunces', Georgia, serif; }
  .mp-stat-label { font-size: 16px; color: var(--mp-text); line-height: 1.4; max-width: 240px; margin: 0 auto; }
  .mp-trust-strip { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--mp-border); }
  .mp-trust-strip-item { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mp-text2); display: inline-flex; align-items: center; gap: 6px; }

  /* PRESS ROW */
  .mp-press { background: var(--mp-sage); padding: 64px 0; }
  .mp-press-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .mp-press-q { font-family: 'Fraunces', Georgia, serif; font-style: italic; font-size: 18px; line-height: 1.4; color: var(--mp-text); margin-bottom: 14px; }
  .mp-press-src { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mp-amber); }

  /* BIG TESTIMONIAL */
  .mp-testimonial { background: var(--mp-cream); padding: 104px 0; }
  .mp-testimonial.alt { background: var(--mp-sage); }
  .mp-testimonial-q { font-family: 'Fraunces', Georgia, serif; font-weight: 800; font-style: italic; font-size: 54px; line-height: 1.08; letter-spacing: -0.02em; text-align: center; max-width: 1000px; margin: 0 auto 40px; color: var(--mp-text); }
  .mp-testimonial-author { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-bottom: 28px; }
  .mp-testimonial-photo { width: 80px; height: 80px; border-radius: 50%; background: var(--mp-border); overflow: hidden; display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-size: 32px; font-weight: 700; color: var(--mp-green); }
  .mp-testimonial-photo.lg { width: 120px; height: 120px; font-size: 44px; }
  .mp-testimonial-name { font-weight: 700; font-size: 18px; color: var(--mp-text); }
  .mp-testimonial-meta { font-size: 13px; color: var(--mp-muted); letter-spacing: 0.03em; }
  .mp-testimonial-verified { font-size: 11px; background: var(--mp-sage); color: var(--mp-green); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; }
  .mp-testimonial-body { font-size: 20px; line-height: 1.6; color: var(--mp-text2); max-width: 740px; margin: 0 auto; text-align: center; }
  .mp-testimonial-body.long { text-align: left; font-size: 20px; max-width: 820px; }
  .mp-testimonial-body.long p { margin: 0 0 20px; }
  .mp-testimonial-body.long strong { color: var(--mp-text); }

  /* USAGE STRIP */
  .mp-usage { background: var(--mp-cream); padding: 56px 0; text-align: center; border-top: 1px solid var(--mp-border); border-bottom: 1px solid var(--mp-border); }
  .mp-usage-head { font-size: 26px; font-weight: 700; color: var(--mp-text); margin-bottom: 22px; }
  .mp-usage-row { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; }
  .mp-usage-item { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 13px; color: var(--mp-text2); font-weight: 500; max-width: 180px; }
  .mp-usage-item-ic { font-size: 26px; }

  /* REPEATING ATC BAR */
  .mp-rep-atc { background: var(--mp-green); color: var(--mp-cream); padding: 36px 0; }
  .mp-rep-atc-inner { display: grid; grid-template-columns: 120px 1fr auto; gap: 24px; align-items: center; }
  .mp-rep-atc-img { width: 120px; height: 120px; border-radius: 12px; overflow: hidden; background: var(--mp-white); }
  .mp-rep-atc-img img { width: 100%; height: 100%; object-fit: cover; }
  .mp-rep-atc-info-name { font-weight: 700; font-size: 17px; color: var(--mp-cream); margin-bottom: 4px; }
  .mp-rep-atc-info-rating { font-size: 13px; color: #D5DBD4; }
  .mp-rep-atc-btn { background: var(--mp-amber); color: #fff; font-weight: 800; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; padding: 16px 28px; border: none; border-radius: 10px; cursor: pointer; transition: background .15s; }
  .mp-rep-atc-btn:hover { background: #A8531F; }
  .mp-rep-atc-sub { font-size: 11px; color: #C2CCC3; margin-top: 8px; letter-spacing: 0.04em; }

  /* TIMELINE */
  .mp-tl { background: var(--mp-cream); }
  .mp-tl-sub { font-size: 20px; font-weight: 500; color: var(--mp-text2); max-width: 820px; margin: 0 0 64px; text-align: center; margin-left: auto; margin-right: auto; }
  .mp-tl-sub strong { color: var(--mp-text); font-weight: 700; }
  .mp-tl-stage { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; margin-bottom: 72px; }
  .mp-tl-stage:nth-child(even) .mp-tl-img { order: 2; }
  .mp-tl-img { border-radius: 14px; overflow: hidden; aspect-ratio: 1.1; background: var(--mp-sage); }
  .mp-tl-img img { width: 100%; height: 100%; object-fit: cover; }
  .mp-tl-content-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--mp-amber); margin-bottom: 10px; }
  .mp-tl-h3 { font-size: 32px; font-weight: 800; line-height: 1.15; color: var(--mp-text); margin: 0 0 14px; letter-spacing: -0.01em; }
  .mp-tl-body { font-size: 17px; line-height: 1.6; color: var(--mp-text2); margin-bottom: 20px; }
  .mp-tl-mini { padding: 16px 20px; background: var(--mp-white); border-left: 3px solid var(--mp-celery); border-radius: 8px; font-size: 14px; color: var(--mp-text2); line-height: 1.5; }
  .mp-tl-mini em { font-style: normal; font-weight: 700; color: var(--mp-text); display: block; margin-top: 6px; font-size: 12px; letter-spacing: 0.03em; }

  /* PROBLEM EDUCATION */
  .mp-problem { background: var(--mp-cream); }
  .mp-problem-h { font-family: 'Fraunces', Georgia, serif; font-weight: 800; font-style: italic; font-size: 52px; line-height: 1.1; letter-spacing: -0.02em; color: var(--mp-text); max-width: 900px; margin: 0 0 18px; }
  .mp-problem-h-2 { font-family: 'Fraunces', Georgia, serif; font-weight: 800; font-style: italic; font-size: 44px; line-height: 1.1; color: var(--mp-amber); margin: 0 0 40px; }
  .mp-problem-body { font-size: 19px; line-height: 1.65; color: var(--mp-text); max-width: 780px; }
  .mp-problem-body p { margin: 0 0 20px; }
  .mp-problem-body strong { font-weight: 700; }

  /* SYSTEM FAILING */
  .mp-sys { background: var(--mp-green); color: var(--mp-cream); }
  .mp-sys .mp-h2 { color: var(--mp-cream); }
  .mp-sys-body { font-size: 19px; line-height: 1.65; color: rgba(250,247,240,0.88); max-width: 820px; margin: 0 0 48px; }
  .mp-sys-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .mp-sys-col { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; padding: 26px; }
  .mp-sys-col.winner { border-color: var(--mp-amber); background: rgba(196,99,42,0.12); }
  .mp-sys-col-h { font-weight: 800; font-size: 16px; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 20px; color: var(--mp-cream); }
  .mp-sys-col-row { font-size: 14px; line-height: 1.5; margin-bottom: 10px; color: rgba(250,247,240,0.85); }
  .mp-sys-col-row strong { color: var(--mp-cream); font-weight: 700; }

  /* HISTORICAL REVEAL */
  .mp-hist { background: var(--mp-cream); }
  .mp-hist-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: center; }
  .mp-hist-body { font-size: 18px; line-height: 1.7; color: var(--mp-text2); }
  .mp-hist-body p { margin: 0 0 18px; }
  .mp-hist-body strong { color: var(--mp-text); font-weight: 700; }
  .mp-hist-img { border-radius: 14px; overflow: hidden; aspect-ratio: 0.9; background: var(--mp-sage); }
  .mp-hist-img img { width: 100%; height: 100%; object-fit: cover; }

  /* INGREDIENT SPOTLIGHT */
  .mp-ing { background: var(--mp-sage); }
  .mp-ing-sub { font-size: 20px; font-weight: 600; letter-spacing: 0.03em; color: var(--mp-green); text-align: center; max-width: 900px; margin: 0 auto 56px; text-transform: uppercase; }
  .mp-ing-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .mp-ing-card { background: var(--mp-white); border-radius: 14px; padding: 32px; display: grid; grid-template-columns: 120px 1fr; gap: 24px; align-items: center; }
  .mp-ing-card-img { width: 120px; height: 120px; border-radius: 12px; background: var(--mp-sage); overflow: hidden; }
  .mp-ing-card-img img { width: 100%; height: 100%; object-fit: cover; }
  .mp-ing-card-role { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; background: var(--mp-sage); color: var(--mp-green); padding: 4px 10px; border-radius: 999px; margin-bottom: 10px; }
  .mp-ing-card-body { font-size: 14px; line-height: 1.55; color: var(--mp-text2); margin: 0; }

  /* SCROLLING TESTIMONIAL BANNER */
  .mp-marquee { background: var(--mp-green); color: var(--mp-cream); padding: 36px 0; overflow: hidden; white-space: nowrap; }
  .mp-marquee-track { display: inline-block; animation: mp-marquee 45s linear infinite; font-size: 18px; font-weight: 500; }
  .mp-marquee-track span { margin: 0 22px; }
  .mp-marquee-track em { color: var(--mp-amber); font-style: normal; margin: 0 4px; }
  @keyframes mp-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* COMPARISON NARRATIVE */
  .mp-narr { background: var(--mp-cream); }
  .mp-narr-body { font-size: 20px; line-height: 1.65; color: var(--mp-text2); max-width: 900px; }
  .mp-narr-body p { margin: 0 0 22px; }

  /* COMPARISON CHART */
  .mp-chart { background: var(--mp-cream); }
  .mp-chart-sub { font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mp-amber); text-align: center; margin-bottom: 48px; }
  .mp-chart-table { width: 100%; border-collapse: collapse; background: var(--mp-white); border-radius: 14px; overflow: hidden; box-shadow: 0 2px 16px rgba(26,36,32,0.05); }
  .mp-chart-table th, .mp-chart-table td { padding: 18px 14px; text-align: center; font-size: 14px; border-bottom: 1px solid var(--mp-border); vertical-align: middle; }
  .mp-chart-table th { background: var(--mp-sage); font-weight: 800; color: var(--mp-text); font-size: 13px; letter-spacing: 0.03em; }
  .mp-chart-table th:first-child, .mp-chart-table td:first-child { text-align: left; font-weight: 600; color: var(--mp-text); padding-left: 22px; }
  .mp-chart-table .mp-col-winner { background: #FFF9EF; border-left: 2px solid var(--mp-amber); border-right: 2px solid var(--mp-amber); font-weight: 700; color: var(--mp-green); }
  .mp-chart-table th.mp-col-winner { color: var(--mp-green); background: #F4E8DC; border-top: 2px solid var(--mp-amber); }
  .mp-chart-table tr:last-child td.mp-col-winner { border-bottom: 2px solid var(--mp-amber); }
  .mp-chart-y { color: var(--mp-green); font-weight: 800; font-size: 18px; }
