  <!-- 23. REPEATING ATC #5 -->
  {{ rep_atc }}

  <!-- Sticky Mobile CTA -->
  <div class="mp-sticky" id="mpSticky">
    <img class="mp-sticky-img" src="{{ img1 }}" alt="Motilli"/>
    <div class="mp-sticky-info">Motilli Digestive Gummies<small id="mpStickyPrice">$47.98</small></div>
    <button type="button" class="mp-sticky-btn" onclick="mpAddToCart()">Add To Cart</button>
  </div>

</div>

<script>
(function() {
  var VARIANT_ID = {{ variant_id }};
  var SELLING_PLAN_ID = {{ selling_plan_id }};
  var SUBSCRIBE_DISCOUNT = 0.80;

  var bundles = {
    '1': { qty: 1, price: 29.99, compare: 44.99, per: 29.99, save: 33 },
    '2': { qty: 3, price: 59.98, compare: 149.97, per: 20.00, save: 60 },
    '3': { qty: 5, price: 89.97, compare: 249.95, per: 17.99, save: 64 }
  };

  window.mpSwap = function(el, src) {
    document.getElementById('mpMainImg').src = src;
    document.querySelectorAll('.mp-thumb').forEach(function(t){ t.classList.remove('active'); });
    el.classList.add('active');
  };

  window.mpSelectBundle = function(el) {
    document.querySelectorAll('.mp-bundle').forEach(function(b){ b.classList.remove('mp-selected'); });
    el.classList.add('mp-selected');
    var input = el.querySelector('input[type="radio"]');
    input.checked = true;
    mpUpdatePrices();
  };

  window.mpUpdatePrices = function() {
    var selected = document.querySelector('input[name="mp-bundle"]:checked');
    if (!selected) return;
    var b = bundles[selected.value];
    var isSub = document.getElementById('mpSubscribe').checked;
    var price = b.price;
    if (isSub) price = Math.round(b.price * SUBSCRIBE_DISCOUNT * 100) / 100;

    document.getElementById('mpCurrentPrice').textContent = '$' + price.toFixed(2);
    document.getElementById('mpComparePrice').textContent = '$' + b.compare.toFixed(2);
    var savePct = Math.round((1 - price / b.compare) * 100);
    document.getElementById('mpSavePill').textContent = 'Save ' + savePct + '%';
    document.getElementById('mpAtcPrice').textContent = '$' + price.toFixed(2);
    var sp = document.getElementById('mpStickyPrice');
    if (sp) sp.textContent = '$' + price.toFixed(2);
  };

  window.mpAddToCart = function() {
    var selected = document.querySelector('input[name="mp-bundle"]:checked');
    if (!selected) return;
    var b = bundles[selected.value];
    var isSub = document.getElementById('mpSubscribe').checked;

    var item = { id: VARIANT_ID, quantity: b.qty };
    if (isSub && SELLING_PLAN_ID) item.selling_plan = SELLING_PLAN_ID;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [item] })
    }).then(function(r) { return r.json(); })
    .then(function() { window.location.href = '/cart'; })
    .catch(function(){ window.location.href = '/cart'; });
  };

  // Sticky mobile CTA
  var hero = document.getElementById('mpHeroAtc');
  if (hero && 'IntersectionObserver' in window) {
    var sticky = document.getElementById('mpSticky');
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          sticky.classList.remove('mp-visible');
          document.body.classList.remove('mp-has-sticky');
        } else {
          sticky.classList.add('mp-visible');
          document.body.classList.add('mp-has-sticky');
        }
      });
    }, { threshold: 0 });
    obs.observe(hero);
  }

  // Review filter click toggle
  document.querySelectorAll('.mp-rev-filter').forEach(function(f) {
    f.addEventListener('click', function() {
      document.querySelectorAll('.mp-rev-filter').forEach(function(x){ x.classList.remove('active'); });
      f.classList.add('active');
    });
  });

  mpUpdatePrices();
})();
</script>

