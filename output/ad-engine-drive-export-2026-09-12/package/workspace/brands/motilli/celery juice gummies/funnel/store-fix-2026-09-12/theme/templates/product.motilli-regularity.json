        "custom_liquid_mbg90": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<div class=\"motilli-purchase-details\"><p class=\"motilli-shipping\" data-motilli-shipping>US standard shipping: $4.99. Free on orders $45+.</p><p><strong>90 days to decide. Opened bottles count.</strong><br>If you're not satisfied, request a full refund within 90 days of delivery.</p><p class=\"motilli-delivery\">Usually ships in 1\u20132 business days. US delivery: 5\u201310 business days after dispatch.</p></div>"
          },
