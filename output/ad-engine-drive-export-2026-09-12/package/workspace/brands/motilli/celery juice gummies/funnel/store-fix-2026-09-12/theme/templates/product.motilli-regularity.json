          "name": "Custom Liquid",
          "settings": {
            "custom_liquid": "<div class=\"motilli-trustbar\">\n  <div class=\"motilli-trustbar__payments\">\n    <div class=\"motilli-trustbar__card motilli-trustbar__card--mc\">\n      <span class=\"motilli-trustbar__mc-circle motilli-trustbar__mc-circle--red\"></span>\n      <span class=\"motilli-trustbar__mc-circle motilli-trustbar__mc-circle--yellow\"></span>\n    </div>\n    <div class=\"motilli-trustbar__card motilli-trustbar__card--amex\">AMEX</div>\n    <div class=\"motilli-trustbar__card motilli-trustbar__card--apay\">\n      <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"#ffffff\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M17.05 12.04c-.03-2.79 2.28-4.13 2.38-4.2-1.3-1.9-3.32-2.16-4.04-2.19-1.71-.17-3.36 1.01-4.23 1.01-.88 0-2.23-.99-3.67-.96-1.88.03-3.62 1.1-4.59 2.77-1.96 3.4-.5 8.42 1.4 11.18.93 1.35 2.04 2.86 3.48 2.81 1.4-.06 1.93-.91 3.62-.91 1.69 0 2.17.91 3.65.88 1.51-.03 2.46-1.37 3.38-2.73 1.07-1.56 1.51-3.07 1.53-3.15-.03-.01-2.93-1.13-2.96-4.51zM14.28 4.04c.78-.94 1.3-2.25 1.16-3.55-1.12.05-2.47.75-3.27 1.69-.72.83-1.34 2.16-1.18 3.44 1.25.1 2.51-.63 3.29-1.58z\"/>\n      </svg>\n      <span>Pay</span>\n    </div>\n    <div class=\"motilli-trustbar__card motilli-trustbar__card--gpay\">\n      <span class=\"motilli-trustbar__gpay-g\">G</span>\n      <span>Pay</span>\n    </div>\n    <div class=\"motilli-trustbar__card motilli-trustbar__card--shop\">shop</div>\n    <div class=\"motilli-trustbar__card motilli-trustbar__card--discover\">DISCOVER</div>\n    <div class=\"motilli-trustbar__card motilli-trustbar__card--visa\">VISA</div>\n  </div>\n  <div class=\"motilli-trustbar__copy\">\n    90-Day Guarantee &nbsp;&bull;&nbsp; Free Shipping Over $45\n  </div>\n</div>\n\n<style>\n  .motilli-trustbar {\n    margin: 14px 0 24px 0;\n    text-align: center;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif;\n  }\n  .motilli-trustbar__payments {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 10px;\n    flex-wrap: wrap;\n    margin-bottom: 12px;\n  }\n  .motilli-trustbar__card {\n    height: 26px;\n    min-width: 42px;\n    border-radius: 4px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.3px;\n    padding: 0 8px;\n    color: #ffffff;\n    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\n  }\n  .motilli-trustbar__card--mc {\n    background: #ffffff;\n    border: 1px solid #e0e0e0;\n    gap: 0;\n    padding: 0 6px;\n  }\n  .motilli-trustbar__mc-circle {\n    width: 16px;\n    height: 16px;\n    border-radius: 50%;\n  }\n  .motilli-trustbar__mc-circle--red {\n    background: #eb001b;\n    margin-right: -6px;\n    z-index: 1;\n  }\n  .motilli-trustbar__mc-circle--yellow {\n    background: #f79e1b;\n    mix-blend-mode: multiply;\n  }\n  .motilli-trustbar__card--amex {\n    background: #006fcf;\n    font-size: 10px;\n  }\n  .motilli-trustbar__card--apay {\n    background: #000000;\n    gap: 3px;\n    font-size: 12px;\n  }\n  .motilli-trustbar__card--gpay {\n    background: #ffffff;\n    color: #5f6368;\n    border: 1px solid #e0e0e0;\n    gap: 2px;\n    font-size: 12px;\n  }\n  .motilli-trustbar__gpay-g {\n    background: linear-gradient(45deg, #4285f4 0%, #ea4335 33%, #fbbc05 66%, #34a853 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    font-size: 14px;\n    font-weight: 700;\n  }\n  .motilli-trustbar__card--shop {\n    background: #5a31f4;\n    font-size: 12px;\n    text-transform: lowercase;\n    font-weight: 700;\n  }\n  .motilli-trustbar__card--discover {\n    background: #ff6000;\n    font-size: 9px;\n  }\n  .motilli-trustbar__card--visa {\n    background: #1a1f71;\n    font-style: italic;\n    font-size: 11px;\n  }\n  .motilli-trustbar__copy {\n    font-size: 14px;\n    color: #2a2a2a;\n    font-weight: 500;\n  }\n</style>"
