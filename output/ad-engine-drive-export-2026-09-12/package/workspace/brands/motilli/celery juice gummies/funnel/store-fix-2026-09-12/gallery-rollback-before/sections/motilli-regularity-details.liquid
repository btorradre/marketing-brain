<section id="motilli-ingredients" class="motilli-explainer">
  <div class="motilli-explainer__inner">
    <p class="motilli-eyebrow">THE FIBER FROM THE AD</p>
    <h2>What does FOS actually do?</h2>
    <p class="motilli-explainer__lead">FOS is a prebiotic fiber. It feeds the good bacteria already living in your gut and can help support regular bowel movements. So when smaller meals mean less fiber, Motilli adds some of that fiber back into your day.</p>
    <div class="motilli-formula">
      <article><span class="motilli-formula__number">01</span><h3>FOS prebiotic fiber</h3><p>Also called fructooligosaccharides. This is the fiber we explain in the ad for daily regularity support.</p></article>
      <article><span class="motilli-formula__number">02</span><h3>Celery juice powder</h3><p>Celery juice powder is included alongside the FOS fiber in Motilli's daily gummy formula.</p></article>
      <article><span class="motilli-formula__number">03</span><h3>Chlorophyllin</h3><p>The formula also contains sodium copper chlorophyllin, a chlorophyll-derived ingredient.</p></article>
    </div>
    <div class="motilli-facts">
      <details><summary>See the Supplement Facts</summary><img src="https://cdn.shopify.com/s/files/1/0975/3201/9055/files/motilli-ferra-6.png?v=1786484170" alt="Motilli Supplement Facts, per two-gummy serving" width="2048" height="2048" loading="lazy"><p>Follow the full ingredient list and directions on your bottle.</p></details>
      <details><summary>Read about the fiber research</summary><p>A placebo-controlled study examined 3 grams of FOS daily in healthy female volunteers and reported stool-frequency improvements in some groups. This is research on the ingredient, not a clinical trial of Motilli or a study showing reversal of GLP-1-related stomach slowing.</p><a href="https://www.jstage.jst.go.jp/article/bifidus1996/18/1/18_1_49/_article" target="_blank" rel="noopener">Read the published FOS study ↗</a></details>
    </div>
  </div>
</section>
<div class="motilli-sticky" hidden><div><strong>Motilli</strong><span data-motilli-sticky-pack></span></div><button type="button" data-motilli-sticky-button>Choose your bottles</button></div>
<style>
.motilli-regularity,.motilli-explainer{font-family:Arial,Helvetica,sans-serif;color:#203a2b}
.motilli-regularity .page-width{max-width:1200px}
.motilli-product-figure{margin:0;min-height:540px;padding:30px;background:#f3f6e9;border-radius:20px;display:flex;align-items:center;justify-content:center;gap:30px}
.motilli-product-figure img{height:445px;width:auto;max-width:65%;object-fit:contain;mix-blend-mode:multiply}
.motilli-product-figure figcaption{font-size:16px;line-height:1.65;color:#365035;max-width:150px}
.motilli-regularity .product__info-container{padding:0 0 0 12px}
.motilli-eyebrow{font-size:11px;font-weight:700;letter-spacing:1.5px;color:#56703a;margin:0 0 8px}
.motilli-buy-intro h1{font-family:Arial,Helvetica,sans-serif;font-size:31px;line-height:1.12;letter-spacing:-.7px;font-weight:700;margin:0 0 10px;color:#203a2b}
.motilli-benefit{font-size:19px;line-height:1.3;font-weight:700;margin:0 0 10px}
.motilli-intro{font-size:14px;line-height:1.55;color:#4b554c;margin:0 0 10px}
.motilli-serving{font-size:12px;line-height:1.6;margin:0 0 8px;color:#324435}
.motilli-serving span{padding:0 5px}
.motilli-facts-link{display:inline-block;color:#315423;font-size:13px;text-underline-offset:3px;margin-bottom:6px}
.motilli-regularity .main-product-atc{background:#23432f;color:white;min-height:54px;border-radius:10px;font-size:16px;font-weight:700;letter-spacing:0;text-transform:none}
.motilli-purchase-details p{font-size:12px;line-height:1.5;margin:8px 0;color:#4a5549}
.motilli-purchase-details strong{color:#23432f;font-size:13px}
.motilli-purchase-details .motilli-shipping{color:#23432f;font-weight:700}
.motilli-regularity .kaching-bundles__bar-full-price,.motilli-regularity .kaching-bundles__bar-label{display:none}
.motilli-explainer{padding:48px 24px;background:#f3f6e9;scroll-margin-top:90px}
.motilli-explainer__inner{max-width:1120px;margin:auto}
.motilli-explainer h2{font:700 32px/1.2 Arial,Helvetica,sans-serif;color:#203a2b;margin:0 0 15px;letter-spacing:-.5px}
.motilli-explainer__lead{max-width:780px;font-size:16px;line-height:1.65;margin:0 0 25px}
.motilli-formula{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.motilli-formula article{padding:24px;background:white;border:1px solid #dce3cf;border-radius:14px}
.motilli-formula__number{font-size:12px;color:#658a23;letter-spacing:2px;font-weight:700}
.motilli-formula h3{font:700 19px/1.2 Arial,Helvetica,sans-serif;color:#203a2b;margin:12px 0}
.motilli-formula p{font-size:14px;line-height:1.6;margin:0;color:#4b554c}
.motilli-facts{margin-top:24px}
.motilli-facts details{border-top:1px solid #cad5bc;padding:15px 0;font-size:14px;line-height:1.6}
.motilli-facts summary{cursor:pointer;font-weight:700;padding:2px 0;min-height:24px}
.motilli-facts img{display:block;max-width:100%;width:600px;height:auto;margin:16px auto}
.motilli-facts p{max-width:850px}.motilli-facts a{color:#254723;text-underline-offset:3px}
.motilli-sticky{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #dde4d9;padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:flex;justify-content:space-between;align-items:center;gap:15px;z-index:15;box-shadow:0 -4px 15px #203a2b0a;font-family:Arial,Helvetica,sans-serif}
.motilli-sticky[hidden]{display:none}
.motilli-sticky strong,.motilli-sticky span{display:block;font-size:13px;line-height:1.4;color:#203a2b}
.motilli-sticky span{font-size:11px;margin-top:2px}
.motilli-sticky button{padding:13px 18px;border:0;border-radius:8px;background:#23432f;color:white;font-weight:700;min-height:44px;cursor:pointer}
@media(min-width:750px){.motilli-sticky{display:none}}
@media(max-width:749px){
 .motilli-regularity .page-width{padding:0 18px}
 .motilli-product-figure{min-height:0;height:208px;padding:12px 25px;gap:30px;border-radius:14px}
 .motilli-product-figure img{height:187px;max-width:48%}
 .motilli-product-figure figcaption{font-size:15px;max-width:145px}
 .motilli-regularity .product__info-container{padding:0}
 .motilli-regularity .product__info-wrapper{padding-top:16px}
 .motilli-buy-intro h1{font-size:25px;margin-bottom:7px}
 .motilli-benefit{font-size:17px;margin-bottom:7px}
 .motilli-intro{font-size:13px;line-height:1.45;margin-bottom:8px}
 .motilli-serving{font-size:11px}.motilli-serving span{padding:0 3px}
 .motilli-explainer{padding:34px 20px}
 .motilli-explainer h2{font-size:25px}
 .motilli-explainer__lead{font-size:15px}
 .motilli-formula{grid-template-columns:1fr;gap:10px}
 .motilli-formula article{padding:18px}
 .motilli-formula h3{font-size:18px;margin:7px 0}
 .motilli-sticky-open{padding-bottom:82px}
}
</style>
<script>
(()=>{
const root=document.querySelector('.motilli-regularity');
if(!root)return;
const form=root.querySelector('form[action*="/cart/add"]');
const button=form?.querySelector('button[type="submit"]');
const sticky=document.querySelector('.motilli-sticky');
if(!form||!button||!sticky)return;
let visible=true;
const selected=()=>root.querySelector('.kaching-bundles__bar--selected');
const label=button.querySelector('.main-atc__label__text');
root.addEventListener('click',event=>{
 if(event.target.closest('.kaching-bundles__bar--selected .kaching-bundles__bar-main')){event.preventDefault();event.stopPropagation();}
},true);
root.addEventListener('keydown',event=>{
 if((event.key==='Enter'||event.key===' ')&&event.target.closest('.kaching-bundles__bar--selected .kaching-bundles__bar-main')){event.preventDefault();event.stopPropagation();}
},true);
function refresh(){
 const choice=selected();
 const price=choice?.querySelector('.kaching-bundles__bar-price')?.textContent.trim();
 const quantity=parseInt(form.querySelector('input[name="quantity"]')?.value||'1',10);
 const valid=Number.isFinite(quantity)&&quantity>0;
 const pack=valid?`${quantity} ${quantity===1?'bottle':'bottles'}`:'';
 if(label&&price&&valid){const text=`Add ${pack} — ${price}`;if(label.textContent!==text)label.textContent=text;}
 const packText=price&&valid?`${pack} · ${price}`:'Choose your bottles';
 const packNode=sticky.querySelector('[data-motilli-sticky-pack]');
 if(packNode.textContent!==packText)packNode.textContent=packText;
 const stickyButton=sticky.querySelector('button');
 const busy=button.disabled||button.getAttribute('aria-disabled')==='true';
 const stickyText=busy?'Adding…':price?`Add to cart — ${price}`:'Choose your bottles';
 if(stickyButton.textContent!==stickyText)stickyButton.textContent=stickyText;
 stickyButton.disabled=busy;
 const priceNumber=price?Number(price.replace(/[^0-9.]/g,'')):NaN;
 const shipping=root.querySelector('[data-motilli-shipping]');
 const shippingText=Number.isFinite(priceNumber)&&window.Shopify?.currency?.active==='USD'?(priceNumber>=45?'Free US standard shipping on this selection.':'US standard shipping: $4.99. Free on orders $45+.'):'US standard shipping: $4.99. Free on orders $45+.';
 if(shipping&&shipping.textContent!==shippingText)shipping.textContent=shippingText;
 const drawer=document.querySelector('cart-drawer.active');
 const hide=visible||!!drawer||window.innerWidth>=750;
 if(sticky.hidden!==hide)sticky.hidden=hide;
 document.body.classList.toggle('motilli-sticky-open',!hide);
}
new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;refresh();},{threshold:0}).observe(button);
let timer;
new MutationObserver(()=>{clearTimeout(timer);timer=setTimeout(refresh,60);}).observe(root,{subtree:true,childList:true,attributes:true,attributeFilter:['class','value','disabled','aria-disabled']});
const drawer=document.querySelector('cart-drawer');
if(drawer)new MutationObserver(refresh).observe(drawer,{attributes:true,attributeFilter:['class']});
form.addEventListener('change',refresh);window.addEventListener('resize',refresh);
sticky.querySelector('button').addEventListener('click',()=>{if(selected()&&!button.disabled&&button.getAttribute('aria-disabled')!=='true'){button.click();}else{button.scrollIntoView({behavior:'smooth',block:'center'});button.focus({preventScroll:true});}});
document.querySelectorAll('a[href="#MainProduct"]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();button.scrollIntoView({behavior:'smooth',block:'center'});button.focus({preventScroll:true});}));
refresh();
})();
</script>
