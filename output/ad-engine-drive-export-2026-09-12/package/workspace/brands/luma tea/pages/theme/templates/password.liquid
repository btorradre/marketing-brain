<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} &mdash; Coming Soon</title>
  {{ content_for_header }}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400;1,500&family=Inter:wght@400;500&display=swap">
  <style>
    body { margin: 0; background: #f6f1e7; color: #2a2418; font-family: 'Inter', sans-serif; display: flex; min-height: 100vh; align-items: center; justify-content: center; padding: 20px; }
    .wrap { max-width: 480px; text-align: center; }
    h1 { font-family: 'Cormorant Garamond', serif; font-size: 56px; font-style: italic; color: #8a7438; margin: 0 0 14px; font-weight: 500; }
    p { color: #6b614e; font-size: 16px; line-height: 1.7; }
    form { margin-top: 32px; display: flex; gap: 10px; }
    input { flex: 1; padding: 14px 18px; border: 1px solid #e8dfc9; border-radius: 10px; background: #fffdf7; font-size: 14px; }
    button { background: #8a7438; color: white; border: none; padding: 14px 24px; border-radius: 10px; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; font-weight: 600; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>Luma Tea</h1>
    <p>A teapot designed for slower mornings. <br>Arriving soon.</p>
    {{ powered_by_link }}
    {% form 'storefront_password' %}
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Enter</button>
    {% endform %}
  </div>
</body>
</html>
