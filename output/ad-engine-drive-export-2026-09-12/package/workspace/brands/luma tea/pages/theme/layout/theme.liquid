<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap">
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
  <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  <style>
    :root {
      --lt-cream: #f6f1e7;
      --lt-cream-2: #fffdf7;
      --lt-ink: #2a2418;
      --lt-muted: #6b614e;
      --lt-line: #e8dfc9;
      --lt-gold-deep: #8a7438;
    }
    html, body { margin: 0; padding: 0; background: var(--lt-cream); color: var(--lt-ink); font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased; }
    * { box-sizing: border-box; }
    a { color: var(--lt-gold-deep); }
    .lt-min-wrap { max-width: 720px; margin: 0 auto; padding: 60px 24px 80px; }
    .lt-min-head { display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; border-bottom: 1px solid var(--lt-line); background: rgba(246,241,231,0.92); backdrop-filter: blur(10px); }
    .lt-min-logo { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 24px; color: var(--lt-gold-deep); text-decoration: none; }
    .lt-min-logo img { height: 32px; width: auto; display: block; }
    .lt-min-back { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--lt-ink); text-decoration: none; }
    .lt-min-back:hover { color: var(--lt-gold-deep); }
    h1.lt-min-title { font-family: 'Cormorant Garamond', serif; font-size: 40px; font-weight: 500; color: var(--lt-ink); margin: 0 0 18px; line-height: 1.1; }
    h2 { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 500; }
    p, li { line-height: 1.7; color: var(--lt-ink); font-size: 15.5px; }
    img { max-width: 100%; height: auto; }
  </style>
</head>
<body>
  <header class="lt-min-head">
    <a href="/" class="lt-min-logo">
      <img src="{{ 'luma-logo.png' | asset_url }}" alt="{{ shop.name }}">
    </a>
    <a href="/" class="lt-min-back">&larr; Back to Shop</a>
  </header>
  <main class="lt-min-wrap">
    {{ content_for_layout }}
  </main>
</body>
</html>
