<script>
(function() {
  var IMG_MAIN = "{{ img1 | image_url: width: 300 }}";
  var FREE_SHIP_THRESHOLD = 8000; // cents
  var MONEY_FORMAT = {{ shop.money_format | json }};

  // Format cents → display string using the shop's money format (handles $, currency symbols, etc.)
  function fmt(cents) {
    if (cents == null || isNaN(cents)) return '';
    var amount = (cents / 100).toFixed(2);
    var clean = amount.replace(/\.00$/, '');
    if (MONEY_FORMAT) {
      return MONEY_FORMAT
        .replace(/\{\{\s*amount\s*\}\}/g, amount)
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, clean.replace(/\.\d+$/, ''))
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amount.replace('.', ','))
        .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, clean.replace(/\.\d+$/, ''));
    }
    return '$' + clean;
  }

  window.ltSwapImg = function(el, src) {
    document.getElementById('ltMainImg').src = src;
    document.querySelectorAll('.lt-thumb').forEach(function(t) { t.classList.remove('active'); });
    el.classList.add('active');
  };

  window.ltSelectVariant = function(el) {
    if (el.classList.contains('lt-soldout')) return;
    document.querySelectorAll('.lt-variant').forEach(function(v) { v.classList.remove('selected'); });
    el.classList.add('selected');

    var id = el.getAttribute('data-variant-id');
    var title = el.getAttribute('data-variant-title');
    var price = parseInt(el.getAttribute('data-variant-price'), 10);
    var compare = parseInt(el.getAttribute('data-variant-compare'), 10) || 0;
    var available = el.getAttribute('data-variant-available') === 'true';

    // Update the hidden form field that Shopify uses to identify the variant
    document.getElementById('ltVariantId').value = id;
    document.getElementById('ltSelectActive').textContent = title;

    // Push variant ID into URL for shareability + variant deeplinking
    if (history && history.replaceState) {
      var url = new URL(window.location.href);
      url.searchParams.set('variant', id);
      history.replaceState({}, '', url);
    }

    // Sync price displays everywhere
    var pStr = fmt(price);
    document.getElementById('ltStickyPrice').textContent = pStr;

    // Sticky compare-at toggle
    var stickyWrap = document.getElementById('ltStickyCompareWrap');
    if (compare && compare > price) {
      document.getElementById('ltStickyCompare').textContent = fmt(compare);
      stickyWrap.style.display = '';
    } else {
      stickyWrap.style.display = 'none';
    }

    // ATC label + enabled state
    var atc = document.getElementById('ltAtcBtn');
    var label = document.getElementById('ltAtcLabel');
    if (available) {
      atc.disabled = false;
      label.innerHTML = 'Add to Cart &mdash; <span id="ltAtcPrice">' + pStr + '</span>';
      document.getElementById('ltStockNote').textContent = 'In Stock · Ships in 1–2 days';
    } else {
      atc.disabled = true;
      label.textContent = 'Sold Out';
      document.getElementById('ltStockNote').textContent = 'Sold Out';
    }
  };

  // Quantity selector — bound via addEventListener for reliability
  function ltBindQty() {
    var qtyInput = document.getElementById('ltQty');
    if (!qtyInput) return;
    document.querySelectorAll('.lt-qty-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var delta = parseInt(btn.getAttribute('data-delta'), 10) || 0;
        var current = parseInt(qtyInput.value, 10);
        if (isNaN(current)) current = 1;
        var next = current + delta;
        var min = parseInt(qtyInput.min, 10) || 1;
        var max = parseInt(qtyInput.max, 10) || 10;
        if (next < min) next = min;
        if (next > max) next = max;
        qtyInput.value = next;
        qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
    // Clamp manual entry too
    qtyInput.addEventListener('change', function() {
      var v = parseInt(qtyInput.value, 10);
      var min = parseInt(qtyInput.min, 10) || 1;
      var max = parseInt(qtyInput.max, 10) || 10;
      if (isNaN(v) || v < min) qtyInput.value = min;
      else if (v > max) qtyInput.value = max;
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ltBindQty);
  } else {
    ltBindQty();
  }

  window.ltOpenCart = function() {
    document.getElementById('ltDrawer').classList.add('lt-open');
    document.getElementById('ltCartBackdrop').classList.add('lt-open');
    document.body.style.overflow = 'hidden';
    refreshCart();
  };
  window.ltCloseCart = function() {
    document.getElementById('ltDrawer').classList.remove('lt-open');
    document.getElementById('ltCartBackdrop').classList.remove('lt-open');
    document.body.style.overflow = '';
  };

  // Hijack form submit → SET line-item to the selected quantity (not additive).
  // If the variant is already in the cart, we change the line to the target qty
  // instead of stacking, so clicking ATC with qty=3 always results in qty=3.
  var ltForm = document.getElementById('ltProductForm');
  if (ltForm) {
    ltForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = document.getElementById('ltAtcBtn');
      // Double-submit guard
      if (btn && btn.dataset.busy === '1') return;
      if (btn) { btn.dataset.busy = '1'; btn.disabled = true; }

      var variantId = parseInt(document.getElementById('ltVariantId').value, 10);
      var targetQty = parseInt(document.getElementById('ltQty').value, 10) || 1;

      fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var existing = null;
          for (var i = 0; i < cart.items.length; i++) {
            if (cart.items[i].variant_id === variantId) { existing = cart.items[i]; break; }
          }
          if (existing) {
            // SET the line to target qty (replace, not add)
            return fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ id: existing.key, quantity: targetQty })
            });
          }
          // Brand-new variant — add it
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: targetQty })
          });
        })
        .then(function(r) {
          if (!r.ok) return r.json().then(function(err) { throw err; });
          return r.json();
        })
        .then(function() {
          if (btn) { btn.dataset.busy = ''; btn.disabled = false; }
          ltOpenCart();
        })
        .catch(function(err) {
          if (btn) { btn.dataset.busy = ''; btn.disabled = false; }
          console.error('Cart update failed:', err);
          alert((err && err.description) || 'Sorry — we could not update your cart.');
        });
    });
  }

  function refreshCart() {
    fetch('/cart.js').then(function(r) { return r.json(); }).then(renderCart);
  }

  function renderCart(cart) {
    var body = document.getElementById('ltDrawerBody');
    var foot = document.getElementById('ltDrawerFoot');
    document.getElementById('ltCartCount').textContent = cart.item_count || 0;

    if (!cart.items || !cart.items.length) {
      body.innerHTML = '<div class="lt-drawer-empty">Your cart is quiet. Bring it to life.</div>';
      foot.style.display = 'none';
      document.getElementById('ltGoalText').textContent = 'Add $80 more for complimentary shipping.';
      document.getElementById('ltGoalFill').style.width = '0%';
      return;
    }

    var html = '';
    cart.items.forEach(function(item) {
      html += '<div class="lt-cart-item">'
        + '<img src="' + (item.image || IMG_MAIN) + '" alt="">'
        + '<div class="lt-cart-item-meta">'
        +   '<div class="lt-cart-item-title">' + item.product_title + '</div>'
        +   '<div class="lt-cart-item-variant">' + item.variant_title + '</div>'
        +   '<div class="lt-cart-item-controls">'
        +     '<div class="lt-cart-qty">'
        +       '<button onclick="ltChangeQty(\'' + item.key + '\',' + (item.quantity - 1) + ')">&minus;</button>'
        +       '<span>' + item.quantity + '</span>'
        +       '<button onclick="ltChangeQty(\'' + item.key + '\',' + (item.quantity + 1) + ')">+</button>'
        +     '</div>'
        +     '<span class="lt-cart-item-price">' + fmt(item.final_line_price) + '</span>'
        +   '</div>'
        +   '<button class="lt-cart-item-remove" onclick="ltChangeQty(\'' + item.key + '\',0)">Remove</button>'
        + '</div>'
        + '</div>';
    });
    body.innerHTML = html;
    foot.style.display = 'block';
    document.getElementById('ltDrawerSubtotal').textContent = fmt(cart.total_price);

    var remaining = FREE_SHIP_THRESHOLD - cart.total_price;
    if (remaining > 0) {
      document.getElementById('ltGoalText').innerHTML = 'Add <strong>' + fmt(remaining) + '</strong> more for complimentary shipping.';
      document.getElementById('ltGoalFill').style.width = Math.min(100, (cart.total_price / FREE_SHIP_THRESHOLD) * 100) + '%';
    } else {
      document.getElementById('ltGoalText').innerHTML = '&#10004; You qualify for complimentary shipping.';
      document.getElementById('ltGoalFill').style.width = '100%';
    }
  }

  window.ltChangeQty = function(key, qty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(function(r) { return r.json(); }).then(renderCart);
  };

  // Initial cart load
  fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
    document.getElementById('ltCartCount').textContent = cart.item_count || 0;
  });

  // Sticky CTA observer
  if ('IntersectionObserver' in window) {
    var atcEl = document.getElementById('ltAtcBtn');
    if (atcEl) {
      var ob = new IntersectionObserver(function(entries) {
        var s = document.getElementById('ltSticky');
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            s.classList.remove('lt-visible');
            document.body.classList.remove('lt-has-sticky');
          } else {
            s.classList.add('lt-visible');
            document.body.classList.add('lt-has-sticky');
          }
        });
      }, { threshold: 0 });
      ob.observe(atcEl);
    }
  }
})();
</script>

