{%- liquid
  if product == blank or product.handle != 'luma-glass-teapot'
    assign product = all_products['luma-glass-teapot']
  endif
  assign cur = product.selected_or_first_available_variant
  assign img1 = product.images[0] | default: product.featured_image
  assign img2 = product.images[1] | default: img1
  assign img3 = product.images[2] | default: img1
  assign img4 = product.images[3] | default: img1
-%}

<style>
  :root {
    --lt-cream: #f6f1e7;
    --lt-cream-2: #fffdf7;
    --lt-card: #ffffff;
    --lt-ink: #2a2418;
    --lt-muted: #6b614e;
    --lt-line: #e8dfc9;
    --lt-gold: #a08a4f;
    --lt-gold-deep: #8a7438;
    --lt-clay: #b87333;
    --lt-sage: #7a8a6b;
    --lt-radius: 14px;
  }

  .lt-container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .lt-serif { font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-weight: 500; letter-spacing: 0.005em; }

  /* ANNOUNCEMENT BAR */
  .lt-announce { background: var(--lt-ink); color: var(--lt-cream); text-align: center; padding: 10px 16px; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; }
  .lt-announce span { display: inline-block; margin: 0 18px; }
  .lt-announce-dot { color: var(--lt-gold); }

  /* HEADER — nav-left | center-logo | nav-right + cart */
  .lt-header { position: sticky; top: 0; z-index: 50; background: rgba(246,241,231,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--lt-line); }
  .lt-header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 18px 32px; max-width: 1400px; margin: 0 auto; gap: 24px; }
  .lt-nav { display: flex; gap: 32px; }
  .lt-nav-left { justify-content: flex-start; }
  .lt-nav-right { justify-content: flex-end; align-items: center; gap: 28px; }
  .lt-nav a { color: var(--lt-ink); text-decoration: none; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; }
  .lt-nav a:hover { color: var(--lt-gold-deep); }
  .lt-logo { display: flex; justify-content: center; align-items: center; text-decoration: none; }
  .lt-logo img { height: 64px; width: auto; display: block; }
  .lt-cart-btn { background: none; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; color: var(--lt-ink); font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; }
  .lt-cart-count { background: var(--lt-gold-deep); color: white; border-radius: 999px; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; letter-spacing: 0; }

  /* HERO */
  .lt-hero { padding: 48px 0 80px; }
  .lt-hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 64px; align-items: start; }

  .lt-gallery { position: sticky; top: 90px; }
  .lt-gallery-main { background: var(--lt-cream-2); border-radius: var(--lt-radius); overflow: hidden; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; }
  .lt-gallery-main img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.25s ease; }
  .lt-thumbs { display: flex; gap: 12px; margin-top: 16px; }
  .lt-thumb { width: 80px; height: 80px; border-radius: 10px; overflow: hidden; cursor: pointer; border: 2px solid transparent; background: var(--lt-cream-2); flex-shrink: 0; transition: border-color 0.2s; }
  .lt-thumb.active { border-color: var(--lt-gold-deep); }
  .lt-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* HERO DETAILS COLUMN */
  .lt-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .lt-pill { background: var(--lt-cream-2); border: 1px solid var(--lt-line); padding: 7px 14px; border-radius: 999px; font-size: 12px; color: var(--lt-ink); display: inline-flex; align-items: center; gap: 6px; letter-spacing: 0.04em; }
  .lt-pill svg { width: 14px; height: 14px; color: var(--lt-gold-deep); }

  .lt-title { font-family: 'Cormorant Garamond', serif; font-size: 44px; line-height: 1.05; margin: 4px 0 10px; font-weight: 500; color: var(--lt-ink); letter-spacing: -0.01em; }
  .lt-rating { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; font-size: 13px; color: var(--lt-muted); }
  .lt-stars { color: #d4a945; letter-spacing: 0.04em; font-size: 15px; }

  .lt-hook { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-style: italic; line-height: 1.3; color: var(--lt-ink); margin: 0 0 16px; }
  .lt-desc { color: var(--lt-muted); font-size: 15px; line-height: 1.65; margin: 0 0 8px; }
  .lt-desc + .lt-desc { margin-top: 12px; }
  .lt-checks { list-style: none; padding: 0; margin: 18px 0 4px; display: grid; gap: 10px; }
  .lt-checks li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; line-height: 1.45; color: var(--lt-ink); }
  .lt-checks li svg { flex-shrink: 0; width: 18px; height: 18px; color: var(--lt-gold-deep); margin-top: 2px; }
  .lt-learnmore { display: inline-block; color: var(--lt-gold-deep); text-decoration: underline; text-underline-offset: 4px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; margin: 12px 0 4px; cursor: pointer; }

  /* VARIANT SELECTOR (size tiles) */
  .lt-select-label { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lt-muted); margin: 28px 0 12px; display: flex; justify-content: space-between; align-items: center; }
  .lt-select-label .lt-select-active { color: var(--lt-gold-deep); font-weight: 600; }

  .lt-variants { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lt-variant { position: relative; background: var(--lt-card); border: 1.5px solid var(--lt-line); border-radius: var(--lt-radius); padding: 18px 16px; cursor: pointer; transition: all 0.2s; }
  .lt-variant input { position: absolute; opacity: 0; pointer-events: none; }
  .lt-variant.selected { border-color: var(--lt-gold-deep); background: linear-gradient(180deg, #fffaef, #fff); box-shadow: 0 1px 0 rgba(160,138,79,0.08); }
  .lt-variant-tag { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--lt-gold-deep); color: white; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
  .lt-variant-size { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 600; color: var(--lt-ink); line-height: 1; }
  .lt-variant-sub { font-size: 11px; color: var(--lt-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-top: 4px; }
  .lt-variant-prices { margin-top: 12px; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .lt-variant-price { font-size: 18px; font-weight: 600; color: var(--lt-ink); }
  .lt-variant-compare { color: var(--lt-muted); text-decoration: line-through; font-size: 14px; }
  .lt-variant-save { background: #e8e1ce; color: var(--lt-gold-deep); font-size: 10px; padding: 3px 7px; border-radius: 4px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }
  .lt-variant-radio { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--lt-line); position: absolute; top: 16px; right: 16px; background: white; }
  .lt-variant.selected .lt-variant-radio { border-color: var(--lt-gold-deep); background: radial-gradient(circle, var(--lt-gold-deep) 40%, white 50%); }
  .lt-variant.lt-soldout { opacity: 0.55; cursor: not-allowed; }
  .lt-variant.lt-soldout .lt-variant-price { text-decoration: line-through; }
  .lt-product-form { margin: 0; padding: 0; }

  /* QUICK TRUST STRIP (under ATC) */
  .lt-quick-trust { margin-top: 14px; display: flex; gap: 22px; justify-content: center; font-size: 11px; color: var(--lt-muted); letter-spacing: 0.04em; flex-wrap: wrap; }
  .lt-quick-trust span { display: inline-flex; align-items: center; gap: 4px; }

  /* QUANTITY + ATC */
  .lt-qty-atc { display: flex; gap: 12px; margin-top: 14px; }
  .lt-ship-bar { display: flex; align-items: center; gap: 10px; margin-top: 18px; padding: 12px 14px; background: linear-gradient(0deg, rgba(184,148,74,0.08), rgba(184,148,74,0.08)), var(--lt-cream-2); border: 1px solid rgba(184,148,74,0.28); border-radius: 10px; font-size: 13.5px; color: var(--lt-ink); }
  .lt-ship-bar svg { flex-shrink: 0; width: 20px; height: 20px; color: var(--lt-gold-deep); }
  .lt-ship-bar strong { font-weight: 600; }
  .lt-qty { display: flex; align-items: center; border: 1.5px solid var(--lt-line); border-radius: var(--lt-radius); background: var(--lt-card); padding: 0 8px; }
  .lt-qty button { background: none; border: none; cursor: pointer; padding: 14px 10px; font-size: 18px; color: var(--lt-ink); }
  .lt-qty input { width: 32px; border: none; text-align: center; font-size: 15px; background: transparent; color: var(--lt-ink); -moz-appearance: textfield; }
  .lt-qty input::-webkit-outer-spin-button, .lt-qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .lt-atc { flex: 1; background: var(--lt-gold-deep); color: white; border: none; border-radius: var(--lt-radius); font-size: 14px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; cursor: pointer; padding: 18px 24px; transition: background 0.2s, transform 0.05s; }
  .lt-atc:hover { background: var(--lt-ink); }
  .lt-atc:active { transform: scale(0.99); }
  .lt-atc:disabled { opacity: 0.6; cursor: not-allowed; }

  /* TRUST STRIP */
  .lt-trust-strip { display: flex; gap: 22px; justify-content: center; margin-top: 20px; padding: 14px 0; border-top: 1px solid var(--lt-line); border-bottom: 1px solid var(--lt-line); flex-wrap: wrap; }
  .lt-trust-strip span { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lt-muted); }
  .lt-trust-strip svg { width: 14px; height: 14px; color: var(--lt-gold-deep); }

  /* ACCORDIONS */
  .lt-accordion { margin-top: 22px; border-top: 1px solid var(--lt-line); }
  .lt-accordion-item { border-bottom: 1px solid var(--lt-line); }
  .lt-accordion-header { padding: 18px 0; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; color: var(--lt-ink); user-select: none; }
  .lt-accordion-header::after { content: "+"; font-size: 22px; color: var(--lt-gold-deep); font-weight: 300; transition: transform 0.2s; }
  .lt-accordion-item.open .lt-accordion-header::after { content: "\2212"; }
  .lt-accordion-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.25s ease; }
  .lt-accordion-body-inner { padding: 0 0 22px; font-size: 14.5px; line-height: 1.65; color: var(--lt-muted); }
  .lt-accordion-item.open .lt-accordion-body { max-height: 1200px; }

  /* TESTIMONIAL CARD */
  .lt-testimonial { margin-top: 22px; background: #efe8d4; border: 1px solid var(--lt-line); border-radius: var(--lt-radius); padding: 24px 22px; text-align: center; }
  .lt-testimonial h4 { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 24px; margin: 0 0 8px; color: var(--lt-ink); }
  .lt-testimonial .lt-stars { font-size: 16px; }
  .lt-testimonial blockquote { margin: 12px 0; font-size: 14.5px; line-height: 1.6; color: var(--lt-ink); font-style: italic; font-family: 'Cormorant Garamond', serif; }
  .lt-testimonial cite { font-size: 12px; color: var(--lt-muted); letter-spacing: 0.08em; font-style: normal; }
  .lt-testimonial a { display: inline-block; margin-top: 10px; color: var(--lt-gold-deep); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: underline; text-underline-offset: 4px; }

  /* MARQUEE */
  .lt-marquee { background: var(--lt-ink); color: var(--lt-cream); padding: 18px 0; overflow: hidden; }
  .lt-marquee-track { display: flex; gap: 60px; animation: lt-scroll 32s linear infinite; white-space: nowrap; will-change: transform; }
  .lt-marquee span { font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 60px; }
  .lt-marquee em { color: var(--lt-gold); font-style: normal; }
  @keyframes lt-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* STORY SECTION */
  .lt-section { padding: 88px 0; }
  .lt-section--alt { background: var(--lt-cream-2); }
  .lt-section-eyebrow { font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--lt-gold-deep); margin-bottom: 14px; }
  .lt-section-title { font-family: 'Cormorant Garamond', serif; font-size: 44px; line-height: 1.1; font-weight: 500; color: var(--lt-ink); margin: 0 0 18px; letter-spacing: -0.01em; }
  .lt-section-title em { font-style: italic; color: var(--lt-gold-deep); }
  .lt-section-lede { font-size: 16px; line-height: 1.7; color: var(--lt-muted); max-width: 60ch; }

  .lt-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .lt-two-col img { width: 100%; border-radius: var(--lt-radius); object-fit: cover; aspect-ratio: 4 / 5; }

  /* FEATURE CARDS */
  .lt-features { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 48px; }
  .lt-feature-card { background: var(--lt-card); border: 1px solid var(--lt-line); border-radius: var(--lt-radius); overflow: hidden; }
  .lt-feature-card-img { aspect-ratio: 4 / 3; background: var(--lt-cream-2); }
  .lt-feature-card-img img { width: 100%; height: 100%; object-fit: cover; }
  .lt-feature-card-body { padding: 28px 26px; }
  .lt-feature-card h3 { font-family: 'Cormorant Garamond', serif; font-size: 28px; margin: 0 0 14px; color: var(--lt-ink); font-weight: 500; }
  .lt-feature-card ul { list-style: none; padding: 0; margin: 0; }
  .lt-feature-card li { display: flex; align-items: flex-start; gap: 10px; padding: 7px 0; font-size: 14.5px; color: var(--lt-ink); }
  .lt-feature-card li svg { flex-shrink: 0; width: 18px; height: 18px; color: var(--lt-gold-deep); margin-top: 1px; }

  /* HOW TO BREW */
  .lt-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 56px; }
  .lt-step { text-align: center; }
  .lt-step-num { display: inline-flex; width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid var(--lt-gold-deep); color: var(--lt-gold-deep); align-items: center; justify-content: center; font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 600; font-style: italic; margin-bottom: 18px; }
  .lt-step h4 { font-family: 'Cormorant Garamond', serif; font-size: 22px; margin: 0 0 8px; color: var(--lt-ink); font-weight: 500; }
  .lt-step p { font-size: 14px; color: var(--lt-muted); line-height: 1.6; margin: 0; }

  /* TRUST BADGES (6 icons) */
  .lt-badges { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; margin-top: 32px; }
  .lt-badge { text-align: center; }
  .lt-badge-icon { width: 56px; height: 56px; border-radius: 50%; background: var(--lt-cream-2); border: 1px solid var(--lt-line); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px; }
  .lt-badge-icon svg { width: 26px; height: 26px; color: var(--lt-gold-deep); }
  .lt-badge p { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lt-muted); margin: 0; }

  /* COMPARISON */
  .lt-compare { margin-top: 48px; background: var(--lt-card); border: 1px solid var(--lt-line); border-radius: var(--lt-radius); overflow: hidden; max-width: 880px; margin-left: auto; margin-right: auto; }
  .lt-compare-row { display: grid; grid-template-columns: 1.4fr 1fr 1fr; align-items: center; }
  .lt-compare-row + .lt-compare-row { border-top: 1px solid var(--lt-line); }
  .lt-compare-row > div { padding: 18px 22px; font-size: 14px; }
  .lt-compare-row > div:nth-child(2) { background: #faf6ea; color: var(--lt-gold-deep); font-weight: 600; text-align: center; border-left: 1px solid var(--lt-line); border-right: 1px solid var(--lt-line); }
  .lt-compare-row > div:nth-child(3) { color: var(--lt-muted); text-align: center; }
  .lt-compare-header { background: var(--lt-ink); color: var(--lt-cream); }
  .lt-compare-header > div { padding: 16px 22px; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; }
  .lt-compare-header > div:nth-child(2) { color: var(--lt-gold); background: var(--lt-ink); text-align: center; border-left-color: rgba(255,255,255,0.1); border-right-color: rgba(255,255,255,0.1); }
  .lt-compare-header > div:nth-child(3) { color: rgba(246,241,231,0.6); text-align: center; }
  .lt-compare-check { color: var(--lt-gold-deep); font-weight: 700; }

  /* FAQ */
  .lt-faq { max-width: 760px; margin: 48px auto 0; }
  .lt-faq .lt-accordion { border-top: 1px solid var(--lt-line); margin-top: 0; }

  /* REVIEWS */
  .lt-reviews-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 48px; }
  .lt-review { background: var(--lt-card); border: 1px solid var(--lt-line); border-radius: var(--lt-radius); padding: 22px 24px; }
  .lt-review-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .lt-review-top .lt-stars { font-size: 14px; }
  .lt-review-verified { font-size: 10px; color: var(--lt-sage); letter-spacing: 0.1em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 4px; }
  .lt-review h5 { font-family: 'Cormorant Garamond', serif; font-size: 18px; margin: 6px 0 8px; color: var(--lt-ink); font-weight: 600; }
  .lt-review p { font-size: 14px; color: var(--lt-muted); line-height: 1.65; margin: 0 0 12px; }
  .lt-review-author { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--lt-muted); letter-spacing: 0.04em; }

  /* FOUNDER */
  .lt-founder { max-width: 720px; margin: 0 auto; text-align: center; }
  .lt-founder-divider { width: 60px; height: 1px; background: var(--lt-line); margin: 32px auto; }
  .lt-founder-quote { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 19px; line-height: 1.6; color: var(--lt-ink); }
  .lt-founder-sig { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-style: italic; color: var(--lt-gold-deep); margin-top: 24px; }
  .lt-founder-name { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--lt-muted); margin-top: 4px; }

  /* FOOTER */
  .lt-footer { background: var(--lt-ink); color: var(--lt-cream); padding: 72px 0 32px; margin-top: 0; }
  .lt-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.4fr; gap: 48px; }
  .lt-footer h5 { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lt-gold); margin: 0 0 18px; font-weight: 500; }
  .lt-footer a { color: rgba(246,241,231,0.78); text-decoration: none; display: block; padding: 5px 0; font-size: 14px; }
  .lt-footer a:hover { color: var(--lt-gold); }
  .lt-footer-brand { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 32px; color: var(--lt-cream); margin-bottom: 14px; }
  .lt-footer-tag { font-size: 14px; color: rgba(246,241,231,0.65); line-height: 1.65; max-width: 28ch; }
  .lt-footer-newsletter input { width: 100%; background: transparent; border: none; border-bottom: 1px solid rgba(246,241,231,0.3); color: var(--lt-cream); padding: 10px 0; font-size: 14px; outline: none; }
  .lt-footer-newsletter input::placeholder { color: rgba(246,241,231,0.5); }
  .lt-footer-newsletter button { margin-top: 14px; background: transparent; border: 1px solid var(--lt-gold); color: var(--lt-gold); padding: 11px 24px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
  .lt-footer-newsletter button:hover { background: var(--lt-gold); color: var(--lt-ink); }
  .lt-footer-social { margin-top: 22px; display: flex; gap: 16px; }
  .lt-footer-social a { padding: 0; }
  .lt-footer-social svg { width: 18px; height: 18px; color: var(--lt-cream); }
  .lt-footer-bottom { margin-top: 56px; padding-top: 28px; border-top: 1px solid rgba(246,241,231,0.12); display: flex; justify-content: space-between; font-size: 12px; color: rgba(246,241,231,0.5); letter-spacing: 0.08em; }

  /* STICKY MOBILE ATC */
  .lt-sticky { position: fixed; bottom: -100px; left: 0; right: 0; background: var(--lt-cream-2); border-top: 1px solid var(--lt-line); padding: 12px 16px; display: flex; gap: 10px; align-items: center; transition: bottom 0.3s ease; z-index: 60; box-shadow: 0 -4px 18px rgba(0,0,0,0.08); }
  .lt-sticky.lt-visible { bottom: 0; }
  .lt-sticky-left { flex: 1; }
  .lt-sticky-title { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--lt-ink); line-height: 1; }
  .lt-sticky-price { font-size: 13px; color: var(--lt-muted); margin-top: 2px; }
  .lt-sticky-price s { color: var(--lt-muted); opacity: 0.7; margin-left: 6px; }
  .lt-sticky-atc { background: var(--lt-gold-deep); color: white; border: none; padding: 16px 22px; border-radius: 10px; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; cursor: pointer; white-space: nowrap; }

  /* CART DRAWER */
  .lt-cart-backdrop { position: fixed; inset: 0; background: rgba(42,36,24,0.4); opacity: 0; pointer-events: none; transition: opacity 0.25s; z-index: 80; }
  .lt-cart-backdrop.lt-open { opacity: 1; pointer-events: auto; }
