<h1 class="lt-min-title">Search</h1>
<form action="/search" method="get" style="margin-bottom:24px;">
  <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the shop" style="width:100%; padding:14px 18px; border:1px solid var(--lt-line); border-radius: 10px; font-size:15px; background: var(--lt-cream-2);">
</form>
{% if search.performed %}
  <p style="color: var(--lt-muted);">{{ search.results_count }} results for &ldquo;{{ search.terms }}&rdquo;</p>
  {% for item in search.results %}
    <a href="{{ item.url }}" style="display:block; padding:16px 0; border-bottom:1px solid var(--lt-line); text-decoration:none; color:inherit;">
      <div style="font-family:'Cormorant Garamond',serif; font-size:20px; font-weight:600;">{{ item.title }}</div>
    </a>
  {% endfor %}
{% endif %}
