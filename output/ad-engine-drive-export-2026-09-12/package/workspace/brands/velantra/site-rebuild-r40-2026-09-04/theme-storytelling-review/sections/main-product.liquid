{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign fact_material = ''
  assign fact_detail = ''
  assign fact_carry = ''
  case product.handle
    when 'velantra-vivienne'
      assign fact_material = 'commerce.facts.vivienne_material' | t
      assign fact_detail = 'commerce.facts.vivienne_detail' | t
      assign fact_carry = 'commerce.facts.vivienne_carry' | t
    when 'velantra-delphine'
      assign fact_material = 'commerce.facts.delphine_material' | t
      assign fact_detail = 'commerce.facts.delphine_detail' | t
      assign fact_carry = 'commerce.facts.delphine_carry' | t
    when 'velantra-juliette'
      assign fact_material = 'commerce.facts.juliette_material' | t
      assign fact_detail = 'commerce.facts.juliette_detail' | t
      assign fact_carry = 'commerce.facts.juliette_carry' | t
    when 'the-colette-wool-tote'
      assign fact_material = 'commerce.facts.colette_material' | t
      assign fact_detail = 'commerce.facts.colette_detail' | t
      assign fact_carry = 'commerce.facts.colette_carry' | t
    when 'velantra-boat-tote-2'
      assign fact_material = 'commerce.facts.camille_material' | t
      assign fact_detail = 'commerce.facts.camille_detail' | t
      assign fact_carry = 'commerce.facts.camille_carry' | t
    when 'velantra-margot-tote'
      assign fact_material = 'commerce.facts.meridian_material' | t
      assign fact_detail = 'commerce.facts.meridian_detail' | t
      assign fact_carry = 'commerce.facts.meridian_carry' | t
  endcase
  assign fact_material = section.settings.fact_material | default: fact_material
  assign fact_detail = section.settings.fact_detail | default: fact_detail
  assign fact_carry = section.settings.fact_carry | default: fact_carry
  assign preorder_kind = ''
  assign preorder_message = ''
  case product.handle
    when 'velantra-vivienne'
      if settings.vivienne_preorder != false
        assign preorder_kind = 'october'
        assign preorder_message = 'commerce.product.preorder_october' | t
        assign preorder_message = settings.vivienne_preorder_message | default: preorder_message
      endif
    when 'the-colette-wool-tote'
      if settings.colette_preorder != false
        assign preorder_kind = 'early_october'
        assign preorder_message = 'commerce.product.preorder_early_october' | t
        assign preorder_message = settings.colette_preorder_message | default: preorder_message
      endif
    when 'the-eleanor-weekender', 'velantra-weekender'
      if settings.weekender_black_preorder != false
        assign preorder_kind = 'black_september'
        assign preorder_message = 'commerce.product.preorder_black_september' | t
        assign preorder_message = settings.weekender_black_preorder_message | default: preorder_message
      endif
  endcase
  assign is_preorder = false
  if preorder_kind == 'october' or preorder_kind == 'early_october'
    assign is_preorder = true
  elsif preorder_kind == 'black_september' and selected_variant.option1 == 'Black'
    assign is_preorder = true
  endif
  assign standard_lead_time = section.settings.lead_time | default: '1–2 business days to process'
  assign preorder_lead_time = section.settings.preorder_lead_time | default: preorder_message
  assign displayed_material = fact_material
  if selected_variant.option1 == 'Black' and section.settings.fact_material_black != blank
    assign displayed_material = section.settings.fact_material_black
  endif
  assign purchase_disabled = false
  if selected_variant.available == false or selected_variant.price == 0
    assign purchase_disabled = true
  endif
-%}
<section class="product-detail" id="Product-{{ section.id }}" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-preorder-kind="{{ preorder_kind }}">
  <div class="product-detail__visual">
    <nav class="product-breadcrumb eyebrow" aria-label="{{ 'commerce.product.breadcrumb' | t | escape }}"><a href="{{ routes.root_url }}">{{ 'commerce.product.home' | t }}</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">{{ 'commerce.product.collection' | t }}</a><span aria-hidden="true">/</span><span>{{ product.title | escape }}</span></nav>
    {% render 'product-gallery', product: product, section_id: section.id %}
  </div>
  <div class="product-detail__content">
    <div class="product-buybox">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow product-buybox__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1>{{ section.settings.title_override | default: product.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="product-buybox__subtitle eyebrow">{{ section.settings.subtitle | escape }}</p>{%- endif -%}
      {%- if section.settings.show_batch and section.settings.batch_number != blank -%}
        <p class="product-batch eyebrow"><span aria-hidden="true">●</span> {% if section.settings.batch_status == 'final' %}{{ 'commerce.product.batch_final' | t: number: section.settings.batch_number | escape }}{% else %}{{ 'commerce.product.batch_open' | t: number: section.settings.batch_number | escape }}{% endif %}</p>
      {%- endif -%}
      <p class="product-preorder eyebrow" data-preorder-notice {% unless is_preorder %}hidden{% endunless %} role="status">
        {{ preorder_message | escape }}
      </p>
      <div class="product-price" data-product-price aria-live="polite" aria-atomic="true">{% render 'product-price', product: product, variant: selected_variant, show_currency: true %}</div>
      {%- if section.settings.show_facts and fact_material != blank -%}
        <dl class="product-facts">
          <div><dt class="eyebrow">{{ 'commerce.facts.material' | t }}</dt><dd data-material-fact data-standard-material="{{ fact_material | escape }}" data-black-material="{{ section.settings.fact_material_black | escape }}">{{ displayed_material | escape }}</dd></div>
          <div><dt class="eyebrow">{{ 'commerce.facts.detail' | t }}</dt><dd>{{ fact_detail }}</dd></div>
          <div><dt class="eyebrow">{{ 'commerce.facts.lead_time' | t }}</dt><dd data-lead-time data-standard-lead-time="{{ standard_lead_time | escape }}" data-preorder-lead-time="{{ preorder_lead_time | escape }}">{% if is_preorder %}{{ preorder_lead_time | escape }}{% else %}{{ standard_lead_time | escape }}{% endif %}</dd></div>
        </dl>
      {%- endif -%}
      {%- assign product_description = section.settings.description_override | default: product.description -%}
      {%- if product_description != blank -%}<div class="product-description rte">{{ product_description }}</div>{%- endif -%}
      {%- if section.settings.material_provenance != blank -%}<div class="product-provenance rte">{{ section.settings.material_provenance }}</div>{%- endif -%}
      {%- form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' -%}
        <div class="variant-fallback" data-variant-fallback>
          <label for="VariantSelect-{{ section.id }}" class="eyebrow">{{ 'commerce.product.variant' | t }}</label>
          <select id="VariantSelect-{{ section.id }}" name="id" data-variant-select>
            {%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant.id == selected_variant.id %}selected{% endif %} {% if variant.available == false or variant.price == 0 %}disabled{% endif %}>{{ variant.title | escape }} — {% if variant.price == 0 %}{{ 'commerce.product.contact_availability' | t }}{% else %}{{ variant.price | money | strip_html }}{% endif %}{% unless variant.available %} — {{ 'commerce.product.sold_out' | t }}{% endunless %}</option>{%- endfor -%}
          </select>
        </div>
        <div class="product-options" data-option-picker hidden>
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_index = option.position | minus: 1
              assign option_name_lower = option.name | downcase
              assign is_color = false
              if option_name_lower == 'color' or option_name_lower == 'colour'
                assign is_color = true
              endif
            -%}
            {%- unless product.has_only_default_variant -%}
            <fieldset class="product-option" data-option-position="{{ option_index }}" {% if is_color %}data-color-option{% endif %}>
              <legend class="eyebrow">{{ option.name | escape }} <span aria-hidden="true">/</span> <span data-selected-option>{{ option.selected_value | escape }}</span></legend>
              <div class="product-option__values {% if is_color %}product-option__values--colors{% endif %}">
              {%- for value in option.values -%}
                {%- assign value_name = value.name | default: value -%}
                {%- assign value_variant = nil -%}
                {%- for variant in product.variants -%}{%- if variant.options[option_index] == value_name -%}{%- assign value_variant = variant -%}{%- break -%}{%- endif -%}{%- endfor -%}
                <div class="product-option__value">
                  <input class="visually-hidden" type="radio" id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value_name %}checked{% endif %}>
                  <label class="{% if is_color and value_variant.featured_image %}product-option__thumbnail{% else %}product-option__text{% endif %}" for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" title="{{ value | escape }}">
                    {%- if is_color and value_variant.featured_image -%}
                      {%- capture option_studio -%}{%- render 'studio-image-url', image: value_variant.featured_image, product: product -%}{%- endcapture -%}
                      {%- assign option_studio = option_studio | strip -%}
                      {%- if option_studio != blank -%}<img src="{{ option_studio }}" alt="" width="120" height="150" loading="lazy">
                      {%- else -%}{{ value_variant.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                      <span class="visually-hidden">{{ value | escape }}</span>
                    {%- else -%}{{ value | escape }}{%- endif -%}
                  </label>
                </div>
              {%- endfor -%}
              </div>
            </fieldset>
            {%- endunless -%}
          {%- endfor -%}
        </div>
        {%- if product.selling_plan_groups.size > 0 -%}
          <label for="SellingPlan-{{ section.id }}">{{ 'commerce.product.purchase_option' | t }}</label>
          <select name="selling_plan" id="SellingPlan-{{ section.id }}">
            {%- unless product.requires_selling_plan -%}<option value="">{{ 'commerce.product.one_time' | t }}</option>{%- endunless -%}
            {%- for group in product.selling_plan_groups -%}<optgroup label="{{ group.name | escape }}">{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}</optgroup>{%- endfor -%}
          </select>
        {%- endif -%}
        {%- if section.settings.show_quantity -%}<div class="product-quantity"><label class="eyebrow" for="Quantity-{{ section.id }}">{{ 'commerce.product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" min="1" step="1" name="quantity" value="1"></div>{%- else -%}<input type="hidden" name="quantity" value="1">{%- endif -%}
        <p class="product-form__error" data-product-error role="alert" hidden></p>
        <button class="button product-form__submit" name="add" type="submit" data-add-button {% if purchase_disabled %}disabled{% endif %}>
          <span data-add-label>{% if selected_variant.price == 0 %}{{ 'commerce.product.contact_availability' | t }}{% elsif selected_variant.available == false %}{{ 'commerce.product.sold_out' | t }}{% elsif is_preorder %}{{ 'commerce.product.preorder' | t }}{% else %}{{ 'commerce.product.add_to_cart' | t }}{% endif %}</span>
        </button>
        <a class="product-availability-link" data-contact-availability href="mailto:{{ shop.email | escape }}?subject={{ product.title | url_encode }}" {% unless selected_variant.price == 0 %}hidden{% endunless %}>{{ 'commerce.product.email_availability' | t }}</a>
        {%- if section.settings.show_dynamic_checkout and selected_variant.price > 0 -%}<div data-dynamic-checkout>{{ form | payment_button }}</div>{%- endif -%}
      {%- endform -%}
      <div class="product-service-notes"><p>{{ 'commerce.product.free_shipping_threshold' | t }}</p><p>{{ 'commerce.product.returns_30_days' | t }}</p></div>
      <div class="product-accordions">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}<div {{ block.shopify_attributes }}>{% render block %}</div>
            {%- when 'accordion' -%}
              {%- if block.settings.content != blank or block.settings.page.content != blank -%}
                <details class="product-accordion" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}><summary class="eyebrow">{{ block.settings.heading | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div></details>
              {%- endif -%}
            {%- when 'text' -%}<div class="product-content-block rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
        {%- if section.settings.show_shipping_summary -%}
          <details class="product-accordion product-accordion--shipping"><summary class="eyebrow">{{ 'commerce.product.shipping_returns' | t }}<span aria-hidden="true">+</span></summary><div class="rte">
            <p>{{ 'commerce.product.free_shipping_threshold' | t }}</p>
            <p data-shipping-preorder {% unless is_preorder %}hidden{% endunless %}>{{ preorder_message | escape }}</p>
            <p data-shipping-standard {% if is_preorder %}hidden{% endif %}>{{ 'commerce.product.processing_summary' | t: lead_time: standard_lead_time }}</p>
            {{ section.settings.shipping_summary }}
          </div></details>
        {%- endif -%}
        {%- if section.settings.show_policies -%}
          {%- if shop.shipping_policy.body != blank -%}<details class="product-accordion"><summary class="eyebrow">{{ 'commerce.product.shipping' | t }}<span aria-hidden="true">+</span></summary><div class="rte">{{ shop.shipping_policy.body }}</div></details>{%- endif -%}
          {%- if shop.refund_policy.body != blank -%}<details class="product-accordion"><summary class="eyebrow">{{ 'commerce.product.returns' | t }}<span aria-hidden="true">+</span></summary><div class="rte">{{ shop.refund_policy.body }}</div></details>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if section.settings.mobile_sticky_cart -%}<div class="product-sticky" data-product-sticky hidden><div><span>{{ product.title | escape }}</span><span data-sticky-price>{% render 'product-price', product: product, variant: selected_variant, show_currency: true %}</span></div><button type="submit" form="{{ product_form_id }}" class="button" data-sticky-add {% if purchase_disabled %}disabled{% endif %}>{% if is_preorder %}{{ 'commerce.product.preorder' | t }}{% else %}{{ 'commerce.product.add_to_cart' | t }}{% endif %}</button></div>{%- endif -%}
  <script type="application/json" data-product-variants>[
    {%- for variant in product.variants -%}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"formatted_price":{{ variant.price | money_with_currency | strip_html | json }},"formatted_price_without_currency":{{ variant.price | money | strip_html | json }},"formatted_compare_at_price":{{ variant.compare_at_price | money_with_currency | strip_html | json }},"formatted_compare_at_price_without_currency":{{ variant.compare_at_price | money | strip_html | json }},"featured_media_id":{{ variant.featured_media.id | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}
  ]</script>
</section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {"type":"richtext","id":"description_override","label":"Description override","info":"Leave blank to use the product description."},
    {"type":"text","id":"title_override","label":"Display title override","info":"Changes the page heading; the product name remains unchanged in search, checkout, and structured data."},
    {"type":"text","id":"eyebrow","label":"Eyebrow"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Luxury, without the logo"},
    {"type":"checkbox","id":"show_facts","label":"Show verified product facts","default":true},
    {"type":"text","id":"fact_material","label":"Material fact override"},
    {"type":"text","id":"fact_detail","label":"Detail fact override"},
    {"type":"text","id":"fact_carry","label":"Carry fact override"},
    {"type":"text","id":"fact_material_black","label":"Black Weekender material","info":"Used only for the Black Weekender variant."},
    {"type":"text","id":"lead_time","label":"Standard processing lead time","default":"1–2 business days to process"},
    {"type":"text","id":"preorder_lead_time","label":"Pre-order lead time","info":"Shown only when the selected color is a pre-order. Keep in sync with your pre-order date."},
    {"type":"richtext","id":"material_provenance","label":"Material origin and certification","info":"Add only supplier-confirmed origins, leather grades or certifications. Leave blank when unverified."},
    {"type":"header","content":"Production batch"},
    {"type":"checkbox","id":"show_batch","label":"Show verified batch status","default":false},
    {"type":"text","id":"batch_number","label":"Actual production batch number","info":"Enter a real batch identifier. No status appears until a number is entered."},
    {"type":"select","id":"batch_status","label":"Batch order status","options":[{"value":"open","label":"Orders open"},{"value":"final","label":"Final orders"}],"default":"open"},
    {"type":"header","content":"Delivery and returns"},
    {"type":"checkbox","id":"show_shipping_summary","label":"Show shipping and returns summary","default":true},
    {"type":"richtext","id":"shipping_summary","label":"Delivery and return details","default":"<p>Standard U.S. delivery is estimated at 7–10 business days after dispatch. International delivery times vary by destination.</p><p>30-day returns from delivery for unused items with original packaging and tags. Contact customerservice@velantrafashion.com to arrange a return. Return postage is your responsibility unless we made an error.</p>"},
    {"type":"checkbox","id":"show_quantity","label":"Show quantity selector","default":false},
    {"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout","default":false},
    {"type":"checkbox","id":"show_policies","label":"Show full store policies","default":false},
    {"type":"checkbox","id":"mobile_sticky_cart","label":"Show mobile purchase bar","default":true}
  ],
  "blocks": [
    {"type":"@app"},
    {"type":"accordion","name":"Accordion","settings":[{"type":"text","id":"heading","label":"Heading","default":"Details"},{"type":"richtext","id":"content","label":"Content"},{"type":"page","id":"page","label":"Page content"},{"type":"checkbox","id":"open","label":"Open by default","default":false}]},
    {"type":"text","name":"Text","settings":[{"type":"richtext","id":"text","label":"Text"}]}
  ]
}
{% endschema %}
