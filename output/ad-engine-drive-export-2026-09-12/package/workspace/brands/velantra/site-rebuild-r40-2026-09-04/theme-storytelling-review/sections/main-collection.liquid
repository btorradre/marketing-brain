<section class="collection-page page-width" id="Collection-{{ section.id }}">
  <header class="collection-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ collection.title | escape }}</h1>{% if section.settings.show_description and collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</header>
  {%- paginate collection.products by section.settings.products_per_page -%}
    <form action="{{ collection.url }}" method="get" class="collection-toolbar">
      <div class="collection-filters">
        {%- if section.settings.enable_filtering -%}
        {%- for filter in collection.filters -%}
          <details class="collection-filter">
            <summary class="eyebrow">{{ filter.label | escape }} <span aria-hidden="true">+</span>{% if filter.active_values.size > 0 %}<span>({{ filter.active_values.size }})</span>{% endif %}</summary>
            <div class="collection-filter__panel">
              {%- case filter.type -%}
                {%- when 'boolean', 'list' -%}
                  {%- for value in filter.values -%}<label class="collection-filter__value"><input type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}> <span>{{ value.label | escape }}</span> <span>({{ value.count }})</span></label>{%- endfor -%}
                {%- when 'price_range' -%}
                  <div class="collection-price-filter"><label>{{ 'commerce.collection.min_price' | t }} ({{ cart.currency.iso_code }})<input name="{{ filter.min_value.param_name }}" type="number" min="0" step="0.01" placeholder="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ 'commerce.collection.max_price' | t }}<input name="{{ filter.max_value.param_name }}" type="number" min="0" step="0.01" placeholder="{{ filter.range_max | divided_by: 100.0 }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label></div>
              {%- endcase -%}
              <div class="collection-filter__actions"><a href="{{ filter.url_to_remove }}">{{ 'commerce.collection.reset' | t }}</a><button type="submit" class="button">{{ 'commerce.collection.apply' | t }}</button></div>
            </div>
          </details>
        {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="collection-sort"><span class="eyebrow collection-count">{{ 'commerce.collection.product_count' | t: count: collection.products_count }}</span>{% if section.settings.enable_sorting %}<label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'commerce.collection.sort' | t }}</label><select name="sort_by" id="SortBy-{{ section.id }}" data-auto-submit>{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><noscript><button type="submit">{{ 'commerce.collection.apply' | t }}</button></noscript>{% endif %}</div>
    </form>
    <div class="collection-active-filters">
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}<a href="{{ value.url_to_remove }}">{{ filter.label | escape }}: {{ value.label | escape }} <span aria-hidden="true">×</span><span class="visually-hidden">{{ 'commerce.collection.remove_filter' | t }}</span></a>{%- endfor -%}
        {%- if filter.type == 'price_range' -%}{%- if filter.min_value.value != nil or filter.max_value.value != nil -%}<a href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} <span aria-hidden="true">×</span><span class="visually-hidden">{{ 'commerce.collection.remove_filter' | t }}</span></a>{%- endif -%}{%- endif -%}
      {%- endfor -%}
    </div>
    <div class="product-grid" style="--desktop-columns: {{ section.settings.columns }}">
      {%- for product in collection.products -%}{% render 'product-card', product: product, show_swatches: section.settings.show_swatches %}{%- else -%}<div class="commerce-empty"><p>{{ 'commerce.collection.empty' | t }}</p><a href="{{ collection.url }}" class="button button--outline">{{ 'commerce.collection.clear_filters' | t }}</a></div>{%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="commerce-pagination" aria-label="{{ 'commerce.collection.pagination' | t | escape }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{"name":"Collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The collection"},{"type":"checkbox","id":"show_description","label":"Show collection description","default":true},{"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":48,"step":4,"default":24},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":4,"step":1,"default":4},{"type":"checkbox","id":"enable_filtering","label":"Enable storefront filters","default":true},{"type":"checkbox","id":"enable_sorting","label":"Enable sorting","default":true},{"type":"checkbox","id":"show_swatches","label":"Show color thumbnails","default":true}]}
{% endschema %}
