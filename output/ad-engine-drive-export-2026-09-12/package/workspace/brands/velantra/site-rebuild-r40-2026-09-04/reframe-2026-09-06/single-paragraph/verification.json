            "product": {
              "id": "gid://shopify/Product/7651875422273",
              "handle": "velantra-cherry-charm",
              "descriptionHtml": "<p>A little mischief for an everyday bag. The Cherry Charm brings a playful fruit silhouette and a touch of shine to the handle you reach for most. It is a small, personal flourish that makes even the simplest outfit feel more like yours.</p>"
