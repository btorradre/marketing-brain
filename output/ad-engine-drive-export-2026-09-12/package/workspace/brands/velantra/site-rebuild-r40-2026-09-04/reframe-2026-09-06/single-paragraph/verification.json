    {
      "handle": "velantra-margot-tote",
      "data": {
        "data": {
          "productUpdate": {
            "product": {
              "id": "gid://shopify/Product/7648515031105",
              "handle": "velantra-margot-tote",
              "descriptionHtml": "<p>The Meridian has a composed kind of ease. A softly structured shape, pebbled leather and silver-tone accents bring definition without feeling formal. From a morning appointment to a table booked for two, it suits the woman who likes her everyday pieces to feel considered.</p>"
            },
            "userErrors": []
          }
        }
