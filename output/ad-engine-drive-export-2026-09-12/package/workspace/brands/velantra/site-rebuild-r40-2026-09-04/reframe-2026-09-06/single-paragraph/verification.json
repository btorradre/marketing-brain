    },
    {
      "handle": "velantra-delphine",
      "data": {
        "data": {
          "productUpdate": {
            "product": {
              "id": "gid://shopify/Product/8041821143105",
              "handle": "velantra-delphine",
              "descriptionHtml": "<p>The Delphine moves easily from the first coffee to the last table of the evening. Textured canvas and burnished leather give its compact shape a warm, collected character, while rolled handles and gold-tone fittings lend a little formality. A bag for the woman whose plans rarely end where they began.</p>"
            },
            "userErrors": []
          }
        }
      }
    },
    {
      "handle": "velantra-vivienne",
      "data": {
        "data": {
          "productUpdate": {
            "product": {
              "id": "gid://shopify/Product/8050561876033",
              "handle": "velantra-vivienne",
              "descriptionHtml": "<p>For the woman who leaves room for the unexpected. The Vivienne pairs a softly slouching leather body with rolled handles, a braided upper edge and warm gold accents. Its relaxed folds bring an easy warmth to a tailored coat, a familiar pair of jeans, and whatever the afternoon becomes.</p>"
            },
            "userErrors": []
          }
        }
      }
    },
    {
