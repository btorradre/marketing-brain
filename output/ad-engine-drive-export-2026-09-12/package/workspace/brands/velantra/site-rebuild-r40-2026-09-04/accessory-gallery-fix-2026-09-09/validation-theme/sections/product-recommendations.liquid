<div class="product-recommendations page-width" data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="collection-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
    <div class="product-grid" style="--desktop-columns: 4">{%- for recommendation in recommendations.products -%}{% render 'product-card', product: recommendation %}{%- endfor -%}</div>
  {%- endif -%}
</div>
{% schema %}
{"name":"Related products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Considered companions"},{"type":"text","id":"heading","label":"Heading","default":"You may also like"},{"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Related products"}],"enabled_on":{"templates":["product"]}}
{% endschema %}
