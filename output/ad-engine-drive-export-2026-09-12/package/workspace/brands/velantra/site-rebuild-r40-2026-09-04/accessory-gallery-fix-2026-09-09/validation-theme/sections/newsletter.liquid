<section class="newsletter section-space"><h2>{{ section.settings.heading | escape }}</h2><div>{{ section.settings.text }}</div>{% assign newsletter_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: newsletter_id %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="newsletter-input"><label class="visually-hidden" for="Email-{{ section.id }}">{{ 'newsletter.email' | t }}</label><input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}"><button class="micro" type="submit">{{ 'newsletter.subscribe' | t }}</button></div><label class="newsletter-consent"><input type="checkbox" required><span>{{ 'newsletter.consent' | t }} <a href="{{ shop.privacy_policy.url }}">{{ 'newsletter.privacy' | t }}</a>.</span></label>{% if form.posted_successfully? %}<p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>{% endif %}{% if form.errors %}<div class="form-message error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</section>
{% stylesheet %}.newsletter{text-align:center;max-width:560px;margin:auto}.newsletter h2{font-size:26px;margin-bottom:20px}.newsletter>div{font-size:11px;margin-bottom:20px}.newsletter-input input{font-size:11px}.newsletter-input .micro{font-size:9px}@media(max-width:767px){.newsletter-input input{font-size:16px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be Among The First"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>New arrivals, thoughtful details, and a closer look at Velantra.</p>"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
