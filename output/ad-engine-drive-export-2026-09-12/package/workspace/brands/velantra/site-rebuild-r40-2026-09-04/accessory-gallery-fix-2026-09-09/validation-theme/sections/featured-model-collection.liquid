{%- liquid
  assign horizontal_padding = section.settings.side_padding | times: 2
  assign column_gaps = section.settings.columns | minus: 1 | times: section.settings.gap
  assign collection_url = section.settings.collection.url | default: routes.all_products_collection_url
  assign section_label = section.settings.heading | default: section.settings.eyebrow
  if section_label == blank
    assign section_label = 'general.collection' | t
  endif
-%}
{%- capture image_sizes -%}
  (min-width: 768px) calc((100vw - {{ horizontal_padding }}px - {{ column_gaps }}px) / {{ section.settings.columns }}), {% if section.settings.mobile_layout == 'scroll' %}82vw{% else %}calc(100vw - {{ horizontal_padding }}px){% endif %}
{%- endcapture -%}
<section
  class="featured-model-collection featured-model-collection--{{ section.settings.mobile_layout }}"
  aria-label="{{ section_label | escape }}"
  style="--model-columns: {{ section.settings.columns }}; --model-ratio: {{ section.settings.ratio }}; --model-gap: {{ section.settings.gap }}px; --model-side-padding: {{ section.settings.side_padding }}px; --model-vertical-padding: {{ section.settings.vertical_padding }}px;"
>
  {% if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.show_collection_link %}
    <div class="featured-model-collection__heading">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.show_collection_link %}
        <a class="text-link" href="{{ collection_url }}">{{ 'general.view_collection' | t }}</a>
      {% endif %}
    </div>
  {% endif %}
  <ul class="featured-model-collection__grid" role="list">
    {% for block in section.blocks %}
      {%- liquid
        assign card_product = block.settings.product
        assign card_variant = blank
        assign requested_variant_id = block.settings.variant_id | strip | plus: 0
        if requested_variant_id > 0 and card_product != blank
          for candidate_variant in card_product.variants
            if candidate_variant.id == requested_variant_id
              assign card_variant = candidate_variant
              break
            endif
          endfor
        endif
        assign card_url = card_product.url
        if card_variant != blank
          assign card_url = card_url | append: '?variant=' | append: card_variant.id
        endif
        assign card_title = block.settings.title | default: card_product.title
        if card_title == blank
          assign card_title = 'general.collection' | t
        endif
        assign card_image = card_variant.featured_image | default: card_product.featured_image
        assign image_alt = block.settings.alt_text | default: block.settings.image.alt | default: card_product.title | default: card_title
        assign image_position = block.settings.image_position
        if image_position == 'focal'
          assign image_position = block.settings.image.presentation.focal_point | default: card_image.presentation.focal_point | default: '50% 50%'
        endif
        assign image_loading = 'lazy'
        if section.index == 1 and forloop.index <= section.settings.columns
          assign image_loading = 'eager'
        endif
        capture studio_image
          render 'studio-image-url', image: card_image, product: card_product
        endcapture
        assign studio_image = studio_image | strip
      -%}
      {% if card_product != blank or request.design_mode %}
        <li
          class="featured-model-collection__item"
          style="--model-image-fit: {{ block.settings.image_fit }}; --model-image-position: {{ image_position }};"
          {{ block.shopify_attributes }}
        >
          {% if card_product != blank %}
            <a class="featured-model-collection__media" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
          {% else %}
            <div class="featured-model-collection__media">
          {% endif %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 2000 | image_tag: widths: '400, 600, 900, 1200, 1600, 2000', sizes: image_sizes, loading: image_loading, alt: image_alt }}
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url | escape }}" width="1200" height="1500" loading="{{ image_loading }}" alt="{{ image_alt | escape }}">
            {% elsif studio_image != blank %}
              <img src="{{ studio_image | escape }}" width="1200" height="1500" loading="{{ image_loading }}" alt="{{ image_alt | escape }}">
            {% elsif card_image != blank %}
              {{ card_image | image_url: width: 2000 | image_tag: widths: '400, 600, 900, 1200, 1600, 2000', sizes: image_sizes, loading: image_loading, alt: image_alt }}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'featured-model-collection__placeholder' }}
            {% endif %}
          {% if card_product != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
          <div class="featured-model-collection__details">
            <h3>
              {% if card_product != blank %}
                <a href="{{ card_url }}">{{ card_title | escape }}</a>
              {% else %}
                {{ card_title | escape }}
              {% endif %}
            </h3>
            {% if section.settings.show_prices and card_product != blank %}
              <div class="featured-model-collection__price">
                {% render 'product-price', product: card_product, variant: card_variant %}
              </div>
            {% endif %}
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</section>

{% stylesheet %}
  .featured-model-collection {
    padding-block: var(--model-vertical-padding);
  }

  .featured-model-collection__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin: 0 max(20px, var(--model-side-padding)) 36px;
  }

  .featured-model-collection__heading .eyebrow {
    margin-bottom: 14px;
  }

  .featured-model-collection__heading .text-link {
    flex-shrink: 0;
  }

  .featured-model-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--model-columns), minmax(0, 1fr));
    align-items: start;
    gap: 32px var(--model-gap);
    margin: 0;
    padding: 0 var(--model-side-padding);
    list-style: none;
  }

  .featured-model-collection__item {
    position: relative;
    min-width: 0;
  }

  .featured-model-collection__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--model-ratio);
    overflow: hidden;
    background: var(--studio-bg, #fff);
  }

  .featured-model-collection__media img,
  .featured-model-collection__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: var(--model-image-fit);
    object-position: var(--model-image-position) !important;
  }

  .featured-model-collection__media:focus-visible {
    outline-offset: -4px;
  }

  .featured-model-collection__details {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 18px 12px 6px;
  }

  .featured-model-collection__details h3 {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 1px;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .featured-model-collection__details a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .featured-model-collection__price {
    min-width: 0;
    max-width: 100%;
    font-size: 11px;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .featured-model-collection__heading {
      align-items: start;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 28px;
    }

    .featured-model-collection__heading h2 {
      font-size: 26px;
    }

    .featured-model-collection--scroll .featured-model-collection__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82vw;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--model-side-padding);
      padding-bottom: 12px;
    }

    .featured-model-collection--scroll .featured-model-collection__item {
      scroll-snap-align: start;
    }

    .featured-model-collection--stack .featured-model-collection__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured-model-collection__details {
      padding-inline: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured model collection",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FEATURED COLLECTION" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "collection", "id": "collection", "label": "Collection link destination" },
    { "type": "checkbox", "id": "show_collection_link", "label": "Show collection link", "default": true },
    { "type": "checkbox", "id": "show_prices", "label": "Show prices", "default": true },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "1/1", "label": "Square (1:1)" }
      ],
      "default": "4/5"
    },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Space between images", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "scroll", "label": "Horizontal scroll" },
        { "value": "stack", "label": "Stacked" }
      ],
      "default": "scroll"
    },
    { "type": "range", "id": "side_padding", "label": "Side spacing", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "vertical_padding", "label": "Top and bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Model product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "variant_id", "label": "Variant ID (optional)", "info": "Link to the color shown. Use a variant ID belonging to this product; otherwise the product's default link and starting price are used." },
        { "type": "image_picker", "id": "image", "label": "Model image" },
        { "type": "url", "id": "image_url", "label": "Image URL fallback", "info": "Used when no model image is selected. Paste a Shopify Files image URL. Without either image, the product image is used." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "alt_text", "label": "Image description", "info": "Describe the model, bag and color shown for screen readers." },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "options": [
            { "value": "contain", "label": "Show entire image" },
            { "value": "cover", "label": "Fill frame (may crop)" }
          ],
          "default": "contain"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "focal", "label": "Image focal point" },
            { "value": "50% 50%", "label": "Center" },
            { "value": "50% 0%", "label": "Top" },
            { "value": "50% 100%", "label": "Bottom" },
            { "value": "0% 50%", "label": "Left" },
            { "value": "100% 50%", "label": "Right" }
          ],
          "default": "focal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured model collection",
      "blocks": [
        { "type": "product", "settings": { "product": "velantra-vivienne", "title": "VIVIENNE" } },
        { "type": "product", "settings": { "product": "velantra-weekender", "title": "WEEKENDER" } },
        { "type": "product", "settings": { "product": "velantra-margot-tote", "title": "MERIDIAN" } }
      ]
    }
  ]
}
{% endschema %}
