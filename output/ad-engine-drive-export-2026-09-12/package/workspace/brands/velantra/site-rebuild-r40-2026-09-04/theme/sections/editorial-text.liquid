<section class="editorial-text section-space" style="--text-width:{{ section.settings.width }}px;text-align:{{ section.settings.alignment }}">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}<div class="rte">{{ section.settings.text }}</div>{% if section.settings.label != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}</section>
{% stylesheet %}.editorial-text>h2{margin-bottom:32px}.editorial-text>.rte{max-width:var(--text-width);margin:0 auto;font-size:12px;line-height:1.8}.editorial-text>.eyebrow{font-size:9px;color:var(--color-muted);letter-spacing:1.6px}.editorial-text>.text-link{display:inline-block;margin-top:15px}@media(max-width:767px){.editorial-text>.rte{font-size:12px}.editorial-text>h2{margin-bottom:24px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Editorial statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LUXURY, WITHOUT THE LOGO"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>For the way it feels. For the way it carries.<br>A considered collection of bags with nothing to prove.</p>"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Text width",
      "min": 360,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "center"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial statement"
    }
  ]
}
{% endschema %}
