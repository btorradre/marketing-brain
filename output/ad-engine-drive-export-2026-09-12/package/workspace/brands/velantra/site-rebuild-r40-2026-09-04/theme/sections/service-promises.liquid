<section class="service-promises" aria-label="{{ 'general.client_services' | t }}">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span class="promise-number">{{ block.settings.number | escape }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="visually-hidden" href="{{ block.settings.link }}">{{ block.settings.heading | escape }}</a>{% endif %}</div>{% endfor %}</section>
{% stylesheet %}.service-promises{display:grid;grid-template-columns:repeat(4,1fr);padding:48px 12px;border-top:1px solid var(--color-line);border-bottom:1px solid var(--color-line);text-align:center}.service-promises>div{border-right:1px solid var(--color-line);padding:0 20px;position:relative}.service-promises>div:last-child{border:0}.promise-number{font:22px var(--font-serif);color:var(--color-muted);display:block;margin-bottom:16px}.service-promises h3{font:500 9px var(--font-sans);letter-spacing:1px;text-transform:uppercase;margin-bottom:8px}.service-promises p{font-size:10px;margin:0;color:var(--color-muted)}@media(max-width:767px){.service-promises{grid-template-columns:1fr 1fr;padding:35px 12px;row-gap:35px}.service-promises>div:nth-child(2){border:0}}
{% endstylesheet %}
{% schema %}
{
  "name": "Service details",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Numeral",
          "default": "I"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Considered design"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "For your everyday"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service details",
      "blocks": [
        {
          "type": "service"
        },
        {
          "type": "service"
        },
        {
          "type": "service"
        },
        {
          "type": "service"
        }
      ]
    }
  ]
}
{% endschema %}
