{%- comment -%}
  In-buy-column "Send a hint" — opens mailto with prefilled body.
  Cuyana reference: paper-plane icon + text, with a small info circle. Borders top + bottom for separator feel.
{%- endcomment -%}

{%- capture mail_subject -%}Hint Hint! Check out the {{ product.title }} from Velantra{%- endcapture -%}
{%- capture mail_body -%}I've been eyeing this from Velantra...

{{ product.title }}
{{ shop.url }}{{ product.url }}

xo{%- endcapture -%}

<div class="pdp-hint-row">
  <a class="pdp-hint"
     href="mailto:?subject={{ mail_subject | url_encode }}&body={{ mail_body | url_encode }}">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
    </svg>
    <span>Send a hint</span>
    <svg class="pdp-hint__info" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 8h.01M12 11v5"/>
    </svg>
  </a>
</div>

<style>
  .pdp-hint-row {
    margin: 0;
    padding: 16px 0;
    border-top: 1px solid #e8e8e1;
  }
  .pdp-hint {
    display: inline-flex; align-items: center; gap: 10px;
    color: #1a1a1a; text-decoration: none;
    font-family: var(--font-stack-base, 'Inter', sans-serif);
    font-size: 14px; letter-spacing: 0.01em;
  }
  .pdp-hint:hover { opacity: 0.7; }
  .pdp-hint__info { opacity: 0.55; margin-left: 2px; }
</style>
