{
  "sections": {
    "breadcrumb": {
      "type": "pdp-breadcrumb",
      "settings": {}
    },
    "main": {
      "type": "main-product",
      "settings": {
        "image_position": "left",
        "image_size": "large",
        "product_zoom_enable": true,
        "thumbnail_position": "below",
        "thumbnail_height": "fixed",
        "mobile_layout": "full",
        "enable_video_looping": true,
        "product_video_style": "muted"
      },
      "blocks": {
        "blurb": {
          "type": "text",
          "settings": {
            "text": "<p>A drawstring bucket bag in soft pebbled leather. Roomy enough for everyday, refined enough for evening.</p>"
          }
        },
        "variants": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "product_dynamic_variants_enable": true,
            "color_swatches": true,
            "variant_labels": true
          }
        },
        "monogram": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-monogram' %}"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "buy": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "surface_pickup_enable": true
          }
        },
        "trust": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-trust-strip' %}"
          }
        },
        "hint": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-send-hint' %}"
          }
        },
        "inline_acc": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-inline-accessories' %}"
          }
        },
        "tab_dim": {
          "type": "tab",
          "settings": {
            "title": "Dimensions & Care",
            "content": "<p><strong>Dimensions</strong><br>\nPlease see product details below.</p>\n<p><strong>Material</strong><br>\nFull-grain leather, canvas, and hand-set hardware.</p>\n<p><strong>Care</strong><br>\nWipe clean with a soft, dry cloth. Condition leather every 6&ndash;12 months with a neutral leather cream. Avoid prolonged exposure to direct sunlight, water, and heat.</p>"
          }
        },
        "tab_ship": {
          "type": "tab",
          "settings": {
            "title": "Shipping & Returns",
            "content": "<p><strong>Shipping</strong><br>\nFree standard shipping on orders over $100. Orders ship within 1&ndash;2 business days from our New York atelier.</p>\n<p><strong>Returns</strong><br>\n30-day returns on unused items in original condition. Personalized items are final sale.</p>\n<p><strong>Repairs</strong><br>\nEvery Velantra bag is covered by our Two-Year Warranty. We&rsquo;ll repair or replace anything that fails in normal use.</p>"
          }
        },
        "in_store": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-in-store' %}"
          }
        }
      },
      "block_order": [
        "blurb",
        "variants",
        "monogram",
        "price",
        "buy",
        "trust",
        "hint",
        "inline_acc",
        "tab_dim",
        "tab_ship",
        "in_store"
      ]
    },
    "warranty": {
      "type": "pdp-warranty",
      "settings": {
        "eyebrow": "OUR PROMISE",
        "heading": "Two-Year Warranty",
        "body": "<p>Every Velantra bag is built to last. If anything fails in normal use, we&rsquo;ll repair or replace it.</p>",
        "link_url": "/pages/warranty",
        "link_label": "Read the warranty",
        "bg_color": "#1a1a1a",
        "text_color": "#ffffff"
      }
    },
    "icon_bar": {
      "type": "pdp-icon-bar",
      "settings": {
        "bg_color": "#faf8f4",
        "text_color": "#1a1a1a"
      },
      "blocks": {
        "pillar_0": {
          "type": "pillar",
          "settings": {
            "eyebrow": "DESIGN",
            "headline": "Soft & Sculptural",
            "body": "<p>A drawstring silhouette that slouches naturally and holds its proportion when set down.</p>"
          }
        },
        "pillar_1": {
          "type": "pillar",
          "settings": {
            "eyebrow": "QUALITY",
            "headline": "Pebbled Full-Grain",
            "body": "<p>Drum-tumbled for the soft, lived-in pebble that defines our signature leather.</p>"
          }
        },
        "pillar_2": {
          "type": "pillar",
          "settings": {
            "eyebrow": "SUSTAINABILITY",
            "headline": "Tanned Responsibly",
            "body": "<p>LWG-certified tanneries. Edge finishing free of chrome and solvents.</p>"
          }
        }
      },
      "block_order": [
        "pillar_0",
        "pillar_1",
        "pillar_2"
      ]
    },
    "benefits": {
      "type": "pdp-benefit-blocks",
      "settings": {
        "eyebrow": "BUILT-IN BENEFITS",
        "heading": "Made with intention",
        "layout": "stack",
        "bg_color": "#ffffff"
      },
      "blocks": {
        "benefit_0": {
          "type": "benefit",
          "settings": {
            "eyebrow_small": "INSIDE",
            "headline": "Suede drawstring closure",
            "body": "<p>Microfiber drawstring tightens with one hand and stays closed in transit.</p>"
          }
        },
        "benefit_1": {
          "type": "benefit",
          "settings": {
            "eyebrow_small": "ORGANIZED",
            "headline": "Detachable pouch",
            "body": "<p>Internal zip pouch clips out \u2014 use it as a clutch on its own.</p>"
          }
        },
        "benefit_2": {
          "type": "benefit",
          "settings": {
            "eyebrow_small": "READY FOR",
            "headline": "Day or evening",
            "body": "<p>Adjustable shoulder strap takes it from crossbody to shoulder to clutch.</p>"
          }
        }
      },
      "block_order": [
        "benefit_0",
        "benefit_1",
        "benefit_2"
      ]
    },
    "feature_carousel": {
      "type": "pdp-feature-carousel",
      "settings": {
        "eyebrow": "IN DETAIL",
        "heading": "Every detail, considered",
        "bg_color": "#ffffff"
      },
      "blocks": {
        "slide_0": {
          "type": "slide",
          "settings": {
            "caption": "Pebbled full-grain leather, drum-tumbled"
          }
        },
        "slide_1": {
          "type": "slide",
          "settings": {
            "caption": "Suede drawstring with brass-tipped pull"
          }
        },
        "slide_2": {
          "type": "slide",
          "settings": {
            "caption": "Detachable internal zip pouch"
          }
        },
        "slide_3": {
          "type": "slide",
          "settings": {
            "caption": "Adjustable strap \u2014 crossbody to shoulder"
          }
        }
      },
      "block_order": [
        "slide_0",
        "slide_1",
        "slide_2",
        "slide_3"
      ]
    },
    "editorial": {
      "type": "pdp-editorial-tile",
      "settings": {
        "bg_color": "#ffffff"
      },
      "blocks": {
        "tile_0": {
          "type": "tile",
          "settings": {
            "image_position": "left",
            "eyebrow": "THE LEATHER",
            "headline": "Pebbled, not pressed",
            "body": "<p>Most pebbled leather is embossed by machine. Ours is drum-tumbled for hours until the grain emerges from the leather itself \u2014 softer, deeper, never uniform.</p>"
          }
        }
      },
      "block_order": [
        "tile_0"
      ]
