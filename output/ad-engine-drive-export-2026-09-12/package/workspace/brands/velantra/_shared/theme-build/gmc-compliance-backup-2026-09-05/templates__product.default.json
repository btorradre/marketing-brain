        "custom_kDRt9Q": {
          "type": "custom",
          "settings": {
            "code": "{%- comment -%}\n  DELIVERY WINDOW – 7 to 10 business days from today\n{%- endcomment -%}\n{%- liquid\n  assign min_days = 7\n  assign max_days = 10\n\n  assign now_s   = 'now' | date: '%s' | plus: 0\n  assign day_sec = 86400\n\n  assign min_add = min_days | times: day_sec\n  assign max_add = max_days | times: day_sec\n\n  assign min_ts  = now_s | plus: min_add\n  assign max_ts  = now_s | plus: max_add\n\n  assign min_month = min_ts | date: '%b'\n  assign max_month = max_ts | date: '%b'\n  assign min_day   = min_ts | date: '%-d'\n  assign max_day   = max_ts | date: '%-d'\n\n  if min_month == max_month\n    assign window_text = min_month | append: ' ' | append: min_day | append: '–' | append: max_day\n  else\n    assign window_text = min_month | append: ' ' | append: min_day | append: ' – ' | append: max_month | append: ' ' | append: max_day\n  endif\n-%}\n\n<div class=\"delivery-estimate-v1\" role=\"status\" aria-live=\"polite\">\n  <span class=\"delivery-estimate-v1__icon\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n      <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\" stroke=\"#1a1a1a\" stroke-width=\"1.5\" fill=\"none\"><\/rect>\n      <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\" stroke=\"#1a1a1a\" stroke-width=\"1.5\" fill=\"none\"><\/polygon>\n      <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\" stroke=\"#1a1a1a\" stroke-width=\"1.5\" fill=\"none\"><\/circle>\n      <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\" stroke=\"#1a1a1a\" stroke-width=\"1.5\" fill=\"none\"><\/circle>\n    <\/svg>\n  <\/span>\n  <span class=\"delivery-estimate-v1__text\">Order today and receive by {{ window_text }}<\/span>\n<\/div>\n\n<style>\n  .delivery-estimate-v1{\n    display:flex; align-items:center; gap:.6rem;\n    margin:.5rem 0 1rem 0;\n    font: inherit; line-height:1.4;\n    color:#1a1a1a; font-weight:500; font-size:1.125rem;\n  }\n  .delivery-estimate-v1__icon{ width:22px; height:22px; flex:0 0 22px; display:inline-flex; }\n  .delivery-estimate-v1__text{ letter-spacing:.1px; }\n<\/style>"
          }
