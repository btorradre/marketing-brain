{%- comment -%}
  In-buy-column "Add Accessories" accordion (open by default).
  Cuyana-reference card layout: image left, name + sub + price + ATC stacked right.

  Sources (priority order):
    1. product.metafields.pdp.companions  (list.product_reference)
    2. collections['accessories'].products (first 3)
{%- endcomment -%}

{%- liquid
  assign companions = product.metafields.pdp.companions.value
  if companions == blank or companions.size == 0
    assign acc = collections['accessories'].products
    if acc.size > 0
      assign companions = acc | where: 'available' | slice: 0, 3
      if companions.size == 0
        assign companions = acc | slice: 0, 3
      endif
    endif
  endif
-%}

{%- if companions != blank and companions.size > 0 -%}
  <details class="pdp-acc" open>
    <summary class="pdp-acc__summary">
      <span class="pdp-acc__title">Add Accessories</span>
      <svg class="pdp-acc__chev" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 6l4 4 4-4"/>
      </svg>
    </summary>
    <div class="pdp-acc__list">
      {%- for p in companions limit: 4 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        {%- assign sub = '' -%}
        {%- if v.title != 'Default Title' -%}
          {%- unless v.title contains ' / ' -%}
            {%- assign sub = v.title -%}
          {%- endunless -%}
        {%- endif -%}
        <article class="pdp-acc__card">
          <a class="pdp-acc__media" href="{{ p.url }}">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 320 | image_tag:
                loading: 'lazy',
                widths: '160, 240, 320',
                sizes: '120px',
                alt: p.title,
                class: 'pdp-acc__img' }}
            {%- endif -%}
          </a>
          <div class="pdp-acc__info">
            <a class="pdp-acc__name" href="{{ p.url }}">{{ p.title }}</a>
            {%- if sub != '' -%}
              <p class="pdp-acc__sub">({{ sub }})</p>
            {%- endif -%}
            <p class="pdp-acc__price">{{ p.price | money }}</p>
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pdp-acc__form">
              <input type="hidden" name="id" value="{{ v.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="pdp-acc__btn"{% unless v.available %} disabled{% endunless %}>
                {%- if v.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
              </button>
            </form>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </details>

  <style>
    .pdp-acc {
      margin: 0;
      border-top: 1px solid #e8e8e1;
      border-bottom: 1px solid #e8e8e1;
      padding: 0;
    }
    .pdp-acc + .pdp-acc, .pdp-acc + details { border-top: 0; }  /* avoid double borders */
    .pdp-acc__summary {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 0; cursor: pointer; list-style: none;
      font-family: var(--font-stack-base, 'Inter', sans-serif);
      font-size: 15px; font-weight: 500; color: #1a1a1a;
    }
    .pdp-acc__summary::-webkit-details-marker { display: none; }
    .pdp-acc__title { letter-spacing: 0.01em; }
    .pdp-acc__chev { transition: transform 200ms; opacity: 0.7; }
    .pdp-acc[open] .pdp-acc__chev { transform: rotate(180deg); }

    .pdp-acc__list {
      display: flex; flex-direction: column; gap: 14px;
      padding: 4px 0 22px;
    }
    .pdp-acc__card {
      display: grid; grid-template-columns: 120px 1fr; gap: 14px;
      align-items: start;
    }
    .pdp-acc__media {
      display: block; aspect-ratio: 1/1; background: #f5f3ee; overflow: hidden;
    }
    .pdp-acc__img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 400ms cubic-bezier(.4,0,.2,1);
    }
    .pdp-acc__media:hover .pdp-acc__img { transform: scale(1.04); }
    .pdp-acc__info {
      display: flex; flex-direction: column; gap: 4px;
      font-family: var(--font-stack-base, 'Inter', sans-serif);
    }
    .pdp-acc__name {
      font-size: 14px; font-weight: 500; color: #1a1a1a;
      text-decoration: none; line-height: 1.35;
    }
    .pdp-acc__name:hover { text-decoration: underline; text-underline-offset: 3px; }
    .pdp-acc__sub { font-size: 12px; color: #6a6a6a; margin: 0; line-height: 1.3; }
    .pdp-acc__price { font-size: 13px; color: #1a1a1a; margin: 2px 0 8px; }
    .pdp-acc__form { margin: 0; }
    .pdp-acc__btn {
      display: inline-block;
      padding: 9px 18px;
      background: #1a1a1a; color: #ffffff; border: 0;
      font-family: inherit; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
      cursor: pointer; transition: background 200ms;
      border-radius: 999px;
    }
    .pdp-acc__btn:hover { background: #3a3a3a; }
    .pdp-acc__btn:disabled { opacity: 0.5; cursor: not-allowed; }

    @media (max-width: 480px) {
      .pdp-acc__card { grid-template-columns: 96px 1fr; gap: 12px; }
    }
  </style>
{%- endif -%}
