{
  "sections": {
    "breadcrumb": {
      "type": "pdp-breadcrumb",
      "settings": {}
    },
    "main": {
      "type": "main-product",
      "settings": {
        "image_position": "left",
        "image_size": "large",
        "product_zoom_enable": true,
        "thumbnail_position": "below",
        "thumbnail_height": "fixed",
        "mobile_layout": "full",
        "enable_video_looping": true,
        "product_video_style": "muted"
      },
      "blocks": {
        "blurb": {
          "type": "text",
          "settings": {
            "text": "<p>A structured leather carry in matte black. Hardware in gunmetal. Designed for the late commute and the long flight.</p>"
          }
        },
        "variants": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "product_dynamic_variants_enable": true,
            "color_swatches": true,
            "variant_labels": true
          }
        },
        "monogram": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-monogram' %}"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "buy": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "surface_pickup_enable": true
          }
        },
        "trust": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-trust-strip' %}"
          }
        },
        "hint": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-send-hint' %}"
          }
        },
        "inline_acc": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-inline-accessories' %}"
          }
        },
        "tab_dim": {
          "type": "tab",
          "settings": {
            "title": "Dimensions & Care",
            "content": "<p><strong>Dimensions</strong><br>\nPlease see product details below.</p>\n<p><strong>Material</strong><br>\nFull-grain leather, canvas, and hand-set hardware.</p>\n<p><strong>Care</strong><br>\nWipe clean with a soft, dry cloth. Condition leather every 6&ndash;12 months with a neutral leather cream. Avoid prolonged exposure to direct sunlight, water, and heat.</p>"
          }
        },
        "tab_ship": {
          "type": "tab",
          "settings": {
            "title": "Shipping & Returns",
            "content": "<p><strong>Shipping</strong><br>\nFree standard shipping on orders over $100. Orders ship within 1&ndash;2 business days from our New York atelier.</p>\n<p><strong>Returns</strong><br>\n30-day returns on unused items in original condition. Personalized items are final sale.</p>\n<p><strong>Repairs</strong><br>\nEvery Velantra bag is covered by our Two-Year Warranty. We&rsquo;ll repair or replace anything that fails in normal use.</p>"
          }
        },
        "in_store": {
          "type": "custom",
          "settings": {
            "liquid": "{% render 'pdp-in-store' %}"
          }
        }
      },
      "block_order": [
        "blurb",
        "variants",
        "monogram",
        "price",
        "buy",
        "trust",
        "hint",
        "inline_acc",
        "tab_dim",
        "tab_ship",
        "in_store"
      ]
    },
    "warranty": {
      "type": "pdp-warranty",
      "settings": {
        "eyebrow": "OUR PROMISE",
        "heading": "Two-Year Warranty",
        "body": "<p>Every Velantra bag is built to last. If anything fails in normal use, we&rsquo;ll repair or replace it.</p>",
        "link_url": "/pages/warranty",
        "link_label": "Read the warranty",
        "bg_color": "#1a1a1a",
        "text_color": "#ffffff"
      }
    },
    "icon_bar": {
      "type": "pdp-icon-bar",
      "settings": {
        "bg_color": "#faf8f4",
        "text_color": "#1a1a1a"
      },
      "blocks": {
        "pillar_0": {
          "type": "pillar",
          "settings": {
            "eyebrow": "DESIGN",
            "headline": "Quiet & Architectural",
            "body": "<p>Black-on-black with gunmetal hardware. A silhouette that disappears into the city and stands out everywhere else.</p>"
          }
        },
        "pillar_1": {
          "type": "pillar",
          "settings": {
            "eyebrow": "QUALITY",
            "headline": "Matte Full-Grain",
            "body": "<p>A matte-finish leather that resists fingerprints and softens at the corners with use.</p>"
          }
        },
        "pillar_2": {
          "type": "pillar",
          "settings": {
            "eyebrow": "SUSTAINABILITY",
            "headline": "LWG-Certified Tannery",
            "body": "<p>Made at one of fewer than 50 LWG Gold tanneries in the world.</p>"
          }
        }
      },
      "block_order": [
        "pillar_0",
        "pillar_1",
        "pillar_2"
      ]
    },
    "benefits": {
      "type": "pdp-benefit-blocks",
      "settings": {
        "eyebrow": "BUILT-IN BENEFITS",
        "heading": "Made with intention",
        "layout": "stack",
        "bg_color": "#ffffff"
      },
      "blocks": {
        "benefit_0": {
          "type": "benefit",
          "settings": {
            "eyebrow_small": "INSIDE",
            "headline": "Padded laptop sleeve",
            "body": "<p>16-inch laptop fits flat against the back panel, padded in soft microsuede.</p>"
          }
        },
        "benefit_1": {
          "type": "benefit",
          "settings": {
            "eyebrow_small": "ORGANIZED",
            "headline": "Five internal compartments",
            "body": "<p>Phone slot, pen loops, two open pockets, one zippered.</p>"
          }
        },
        "benefit_2": {
          "type": "benefit",
          "settings": {
            "eyebrow_small": "DETAIL",
            "headline": "Gunmetal hardware",
            "body": "<p>All-metal hardware in matte gunmetal \u2014 won't tarnish, won't scratch the body.</p>"
          }
        }
      },
      "block_order": [
        "benefit_0",
        "benefit_1",
        "benefit_2"
      ]
    },
    "feature_carousel": {
      "type": "pdp-feature-carousel",
      "settings": {
