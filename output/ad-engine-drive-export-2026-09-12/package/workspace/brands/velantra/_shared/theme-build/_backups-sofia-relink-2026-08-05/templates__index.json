    "craft_promises": {
      "type": "advanced-content",
      "blocks": {
        "liq": {
          "type": "liquid",
          "settings": {
            "code": "<div class=\"v-craft\">\n  <div class=\"v-craft-grid\">\n    <div class=\"v-craft-col\">\n      <h3 class=\"v-craft-title\">Decades, not seasons<\/h3>\n      <p class=\"v-craft-text\">Reinforced stitching. Solid brass hardware. Materials that earn character instead of losing it.<\/p>\n    <\/div>\n    <div class=\"v-craft-col\">\n      <h3 class=\"v-craft-title\">A two-year promise<\/h3>\n      <p class=\"v-craft-text\">Every bag is covered for two years. If it ever fails you, we make it right.<\/p>\n    <\/div>\n    <div class=\"v-craft-col\">\n      <h3 class=\"v-craft-title\">Quiet by design<\/h3>\n      <p class=\"v-craft-text\">No logos. No badges. The craftsmanship speaks first, and strangers ask where it's from.<\/p>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n  .v-craft { max-width: 1100px; margin: 0 auto; padding: 48px 20px; }\n  .v-craft-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: center; }\n  .v-craft-title { font-size: 1.15rem; font-weight: 600; margin-bottom: 10px; }\n  .v-craft-text { font-size: 0.98rem; line-height: 1.6; opacity: 0.85; }\n  @media (max-width: 760px) { .v-craft-grid { grid-template-columns: 1fr; gap: 28px; } }\n<\/style>\n",
            "width": "100%",
            "alignment": "center"
          }
        }
      },
      "block_order": [
        "liq"
      ],
      "name": "t:sections.advanced-content.presets.custom_content.name",
      "settings": {
        "full_width": false,
        "space_around": false
      }
