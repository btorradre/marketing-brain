    "press_cbs": {
      "type": "advanced-content",
      "blocks": {
        "liq": {
          "type": "liquid",
          "settings": {
            "code": "<div class=\"v-press\">\n  <p class=\"v-press-eyebrow\">As Featured On<\/p>\n  <a class=\"v-press-logo\" href=\"https:\/\/www.cbsnews.com\/losangeles\/video\/celebrating-national-girlfriends-day-go-to-girlfriend\/\" target=\"_blank\" rel=\"noopener\">\n    <img class=\"v-press-logo-img\" src=\"{{ 'velantra-cbs-logo.svg' | asset_url }}\" alt=\"CBS Los Angeles\" loading=\"lazy\" style=\"height: clamp(30px, 4.5vw, 44px); width: auto; display: block;\">\n  <\/a>\n  <p class=\"v-press-sub\">Velantra was featured in the Go-To Girlfriend's National Girlfriends Day picks on CBS News Los Angeles. <a class=\"v-press-link\" href=\"https:\/\/www.cbsnews.com\/losangeles\/video\/celebrating-national-girlfriends-day-go-to-girlfriend\/\" target=\"_blank\" rel=\"noopener\">Watch the segment<\/a><\/p>\n<\/div>\n\n<style>\n  .v-press { background: #E7E3DB; text-align: center; padding: 46px 20px; }\n  .v-press .v-press-eyebrow { font-size: 0.78rem; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.7; margin-bottom: 18px; }\n  .v-press .v-press-logo { display: inline-block; margin-bottom: 16px; }\n  .v-press .v-press-logo:hover { opacity: 0.75; }\n  .v-press .v-press-logo-img { display: block; height: clamp(30px, 4.5vw, 44px); width: auto; }\n  .v-press .v-press-sub { font-size: 0.95rem; line-height: 1.6; opacity: 0.85; max-width: 560px; margin: 0 auto; }\n  .v-press .v-press-link { text-decoration: underline; color: inherit; }\n<\/style>"
