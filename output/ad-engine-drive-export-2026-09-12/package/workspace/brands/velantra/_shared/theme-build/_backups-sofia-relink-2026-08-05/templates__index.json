    "ourstory": {
      "type": "advanced-content",
      "blocks": {
        "liq": {
          "type": "liquid",
          "settings": {
            "code": "<div class=\"v-split v-split-story\">\n  <div class=\"v-split-img\">\n    <img src=\"{{ 'velantra-ourstory.jpg' | asset_url }}\" alt=\"Velantra\" loading=\"lazy\">\n  <\/div>\n  <div class=\"v-split-text\">\n    <div class=\"v-split-inner v-split-inner-left\">\n      <p class=\"v-split-eyebrow\">Built to last decades, not seasons<\/p>\n      <h2 class=\"v-split-title\">Our Story<\/h2>\n      <p class=\"v-split-body\">Velantra started with a refusal: that a woman should have to choose between a bag she loves and a bag she can actually live in. So we build structured, considered pieces — reinforced stitching, solid brass, materials that earn character instead of losing it — made to last decades, not seasons. Designed with you in mind, and named for the women who inspired them.<\/p>\n      <a class=\"v-split-link\" href=\"\/pages\/about-us-1\">Read the founder's letter &rarr;<\/a>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n  .v-split-story .v-split-inner-left { text-align: left; max-width: 460px; }\n  .v-split-story .v-split-link { display: inline-block; font-size: 0.95rem; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; color: inherit; }\n  @media (max-width: 780px) { .v-split-story .v-split-text { padding: 48px 24px; } }\n<\/style>\n",
            "width": "100%",
            "alignment": "center"
          }
        }
      },
      "block_order": [
        "liq"
      ],
      "name": "t:sections.advanced-content.presets.custom_content.name",
