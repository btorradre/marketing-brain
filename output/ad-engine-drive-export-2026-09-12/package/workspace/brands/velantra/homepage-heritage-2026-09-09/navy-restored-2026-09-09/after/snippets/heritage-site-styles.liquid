{% doc %}
Shared heritage typography, spacing and commerce treatments.
{% enddoc %}
<style>
:root{--heritage-navy:#132039;--heritage-cream:#f7f5ef;--heritage-line:#dedad0;--heritage-muted:#5e6269;--page-margin:28px;--header-height:92px}
.heritage-site{color:var(--color-text);background:var(--color-bg)}
.heritage-site .nav-flyout{top:100%;border-color:var(--color-line)}
.heritage-site .icon-close{width:44px;height:44px}
.heritage-site .button{min-height:50px;font-size:11px;letter-spacing:.12em}
.heritage-site .button:not(.button--outline){background:var(--color-text);color:var(--color-bg)}
.heritage-site .button:not(.button--outline):hover{background:var(--color-bg);color:var(--color-text)}
.heritage-site input[type=checkbox],.heritage-site input[type=radio]{accent-color:var(--color-text)}
.heritage-site :is(input,select,textarea):focus-visible{outline:2px solid var(--color-text);outline-offset:3px}
.heritage-site .navigation-drawer nav>a{font-size:30px;padding-block:12px}
.heritage-site .dialog-top{padding:24px 28px}
.heritage-site .dialog-top h2{font-size:34px}
.heritage-site .drawer-body{padding:28px}
.heritage-site .product-detail{max-width:1600px;margin:auto;padding:32px var(--page-margin) 72px;gap:clamp(28px,4vw,64px);grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}
.heritage-site .product-detail__visual{position:sticky;top:92px}
.heritage-site .product-breadcrumb{position:relative;inset:auto;flex-wrap:wrap;align-items:center;margin:0 0 20px;font-size:9px;gap:10px;line-height:1.6}
.heritage-site .product-breadcrumb a{padding-block:8px}
.heritage-site .product-gallery{border:1px solid var(--color-line)}
.heritage-site .product-gallery__viewport{height:clamp(400px,calc(100svh - 200px),780px)}
.heritage-site .product-gallery__controls:not([hidden]){background:var(--color-bg);border-color:var(--color-line)}
.heritage-site .product-detail__content{padding:38px 0 0}
.heritage-site .product-buybox{text-align:left;max-width:560px}
.heritage-site .product-buybox h1{font-size:clamp(40px,3.8vw,58px);line-height:1.08;letter-spacing:-.015em;margin-bottom:16px}
.heritage-site .product-buybox__eyebrow,.heritage-site .product-buybox__subtitle{font-size:10px;letter-spacing:.12em;margin-bottom:20px}
.heritage-site .product-preorder{margin:0 0 20px;font-size:10px;line-height:1.8;max-width:none;letter-spacing:.055em}
.heritage-site .product-batch{margin-left:0}
.heritage-site .product-batch__headline.eyebrow{justify-content:flex-start}
.heritage-site .product-price{font-size:16px;margin:20px 0 28px}
.heritage-site .product-facts{border-color:var(--color-line);padding:22px 0;margin-bottom:28px;text-align:left}
.heritage-site .product-facts>div{padding:0 14px}
.heritage-site .product-facts>div:first-child{padding-left:0}
.heritage-site .product-facts>div+div{border-color:var(--color-line)}
.heritage-site .product-facts dt{font-size:9px;letter-spacing:.12em}
.heritage-site .product-facts dd{font-size:12px;line-height:1.7}
.heritage-site .product-description,.heritage-site .product-provenance{font-size:14px;line-height:1.85;margin-bottom:28px}
.heritage-site .product-options{border-color:var(--color-line);padding:24px 0 28px}
.heritage-site .product-option legend{font-size:10px;letter-spacing:.12em;margin-bottom:16px}
.heritage-site .product-option__values{justify-content:flex-start;gap:12px}
.heritage-site .product-option__value label{min-height:44px;min-width:44px}
.heritage-site .product-option__value input:checked+label{border-color:var(--color-text);box-shadow:0 0 0 1px var(--color-text)}
.heritage-site .product-quantity[data-product-quantity]{justify-content:start;justify-items:start;gap:12px;margin-bottom:24px}
.heritage-site .product-quantity>.eyebrow{margin:0;font-size:10px;letter-spacing:.12em}
.heritage-site .product-quantity__controls{border-color:var(--color-line)}
.heritage-site .product-form__submit{min-height:52px;font-size:11px}
.heritage-site .product-service-notes{justify-content:flex-start;font-size:11px;line-height:1.7;margin:20px 0 28px}
.heritage-site .product-buybox .product-accordion summary{padding:16px 0;min-height:54px;font-size:10px;letter-spacing:.12em}
.heritage-site .product-accordion>.rte{font-size:14px;line-height:1.85;padding:0 0 20px}
.heritage-site .product-sticky{background:var(--color-bg);color:var(--color-text)}
.heritage-site .craft-timeline{padding-bottom:80px;border-top:1px solid var(--color-line)}
.heritage-site .craft-intro{padding:72px 24px 56px}
.heritage-site :is(.craft-intro h2,.value-breakdown__heading,.client-perspectives__header h2,.product-recommendations .collection-heading h2){font-size:clamp(32px,3vw,46px);line-height:1.15;letter-spacing:-.01em}
.heritage-site .craft-intro .rte{font-size:14px;line-height:1.8}
.heritage-site .craft-strip{padding-inline:var(--page-margin);scroll-padding-inline:var(--page-margin)}
.heritage-site .craft-grid{gap:24px}
.heritage-site .craft-card h3{font-size:27px;line-height:1.2}
.heritage-site .craft-copy{font-size:13px;line-height:1.8;max-width:44ch}
.heritage-site .value-breakdown{padding-bottom:0;border-block:1px solid var(--color-line)}
.heritage-site .value-breakdown__content{padding:48px clamp(24px,4vw,64px)}
.heritage-site .value-breakdown__table{font-size:13px;line-height:1.65}
.heritage-site .value-breakdown__table thead th{font-family:var(--font-sans);font-size:10px;letter-spacing:.1em;line-height:1.6;text-transform:uppercase;padding-bottom:22px}
.heritage-site .value-breakdown__table tbody tr{border-top:1px solid var(--color-line)}
.heritage-site .value-breakdown__note{font-size:14px;line-height:1.8}
.heritage-site .client-perspectives{padding-block:64px 80px}
.heritage-site .client-perspectives__header{margin-inline:var(--page-margin);text-align:center}
.heritage-site .collection-page,.heritage-site .search-page,.heritage-site .cart-page{padding-top:64px;padding-bottom:80px}
.heritage-site .collection-heading{margin-bottom:40px}
.heritage-site :is(.collection-heading h1,.content-page>h1,.shopify-policy__title h1,.empty-state h1){font-size:clamp(38px,4vw,56px);line-height:1.12;letter-spacing:-.015em}
.heritage-site .collection-heading .rte{font-size:14px;line-height:1.85}
.heritage-site .collection-toolbar{padding-block:18px;margin-bottom:28px}
.heritage-site .collection-sort select{font-size:12px;min-height:44px}
.heritage-site .collection-filter summary{font-size:10px;min-height:44px;align-items:center}
.heritage-site .collection-filter__value{min-height:44px;font-size:12px}
.heritage-site .collection-filter__panel{top:100%}
.heritage-site .product-grid{gap:40px 24px}
.heritage-site .product-card__media{border:1px solid var(--color-line)}
.heritage-site .product-card__info{padding-top:18px}
.heritage-site .product-card h3{font-size:24px;line-height:1.2}
.heritage-site .product-card__price{font-size:12px}
.heritage-site .product-card__heading{display:block}
.heritage-site .product-card__price{text-align:left;margin-top:8px}
.heritage-site .product-card__price--availability{max-width:none}
.heritage-site .product-card__swatches{gap:8px;margin-top:12px}
.heritage-site .product-card__swatches a{width:44px;height:44px;background:#fff;border-color:var(--color-line)}
.heritage-site .product-card__swatches a img{padding:3px}
.heritage-site .product-card__swatches .product-card__more{background:transparent}
.heritage-site .product-recommendations{padding-block:72px}
.heritage-site .commerce-search-form input{font-size:16px;min-height:50px}
.heritage-site .commerce-search-form button{font-size:11px;min-height:50px}
.heritage-site .content-page{max-width:820px;padding-block:64px 96px;font-size:15px;line-height:1.85}
.heritage-site .content-page .rte h2,.heritage-site .shopify-policy__body h2{font-size:30px;line-height:1.25}
.heritage-site .contact-grid{gap:24px}
.heritage-site .contact-grid input,.heritage-site .contact-grid textarea{width:100%;min-height:48px;font-size:16px}
.heritage-site .shopify-policy__container{max-width:820px!important}
.heritage-site .shopify-policy__body{font-size:15px;line-height:1.85;overflow-wrap:break-word}
.heritage-site .cart-line__details>p,.heritage-site .cart-summary__tax{font-size:13px;line-height:1.8}
.heritage-site .cart-line__quantity input,.heritage-site .cart-summary textarea{font-size:16px;min-height:48px}
.heritage-site .cart-line__quantity a{display:inline-flex;align-items:center;min-height:44px;font-size:10px}
.heritage-site .cart-summary{padding:28px;background:#efede6;border:1px solid var(--color-line)}
.heritage-site .cart-summary__row{font-size:14px}
.heritage-site.template-list-collections #MainContent>.shopify-section>.section-space{padding-top:64px;padding-bottom:80px}
.heritage-site.template-list-collections .editorial-text.section-space{padding:0 0 40px}
.heritage-site.template-list-collections .editorial-text h1,.heritage-site.template-blog #MainContent h1,.heritage-site.template-article #MainContent h1{font-size:clamp(38px,4vw,56px);line-height:1.12}
.heritage-site.template-list-collections .blog-grid h2{font-size:30px}
@media(max-width:1100px){:root{--header-height:92px}.heritage-site .product-detail{gap:28px}.heritage-site .product-facts>div{padding-inline:10px}}
@media(max-width:899px){.heritage-site .product-detail{padding:24px var(--page-margin) 56px}.heritage-site .product-detail__visual{position:relative;top:auto;max-width:640px;margin-inline:auto}.heritage-site .product-gallery__viewport{height:auto;aspect-ratio:4/5}.heritage-site .product-detail__content{padding:36px 0 0}.heritage-site .product-buybox{max-width:640px}.heritage-site .product-buybox h1{font-size:42px}.heritage-site .product-grid{gap:32px 16px}.heritage-site .product-card h3{font-size:22px}.heritage-site .value-breakdown__media{height:auto;aspect-ratio:4/5}.heritage-site .collection-filter__panel{top:100%}}
@media(max-width:767px){:root{--page-margin:20px;--header-height:70px}.heritage-site .product-detail{padding-top:12px}.heritage-site .product-breadcrumb{font-size:8px;gap:8px;margin-bottom:12px}.heritage-site .product-detail__content{padding-top:28px}.heritage-site .product-facts{padding-block:20px}.heritage-site .product-facts dd{font-size:11px}.heritage-site .product-buybox h1{font-size:40px}.heritage-site .product-description{font-size:14px}.heritage-site .product-grid{gap:32px 12px}.heritage-site .product-card h3{font-size:21px}.heritage-site .product-card__swatches{gap:6px}.heritage-site .product-card__price{font-size:11px}.heritage-site .collection-page,.heritage-site .search-page,.heritage-site .cart-page{padding-block:44px 56px}.heritage-site .collection-sort select{font-size:16px;max-width:190px}.heritage-site .collection-count{display:none}.heritage-site .craft-intro{padding:52px 20px 36px}.heritage-site .craft-grid{gap:20px;grid-auto-columns:min(290px,80vw)}.heritage-site .craft-card h3{font-size:25px}.heritage-site .craft-copy{font-size:13px}.heritage-site .craft-timeline{padding-bottom:56px}.heritage-site .value-breakdown__content{padding:40px 20px}.heritage-site .value-breakdown__table{font-size:12px}.heritage-site .value-breakdown__table th,.heritage-site .value-breakdown__table td{padding-block:14px}.heritage-site .product-recommendations{padding-block:52px}.heritage-site .client-perspectives{padding-block:48px 56px}.heritage-site .content-page{padding:44px 20px 64px}.heritage-site .cart-summary{padding:24px}.heritage-site .dialog-top,.heritage-site .drawer-body{padding:20px}.heritage-site .product-sticky:not([hidden]){z-index:35}}
@media(max-width:479px){.heritage-site .collection-filter__panel{top:auto}.heritage-site .product-facts dt{font-size:8px}.heritage-site .product-card__swatches a{width:44px;height:44px}}
.heritage-site #MainContent:has(>#pp-tracking-page-app){display:flex;flex-direction:column}
.heritage-site #pp-tracking-page-app{order:0;padding:64px 20px;background:var(--color-bg);color:var(--color-text);font-family:var(--font-sans)}
.heritage-site #pp-tracking-page-app .pp_tracking_content{--pp-base-color:var(--color-text)!important;--pp-popover-background:var(--color-bg)!important;--pp-timeline-color:#efede6!important;--pp-popover-text:var(--color-text)!important;color:var(--color-text);font-family:var(--font-sans)}
.heritage-site #pp-tracking-page-app .pp_tracking_title{font:400 clamp(38px,4vw,56px)/1.12 var(--font-serif);letter-spacing:-.015em;color:var(--color-text);margin:0 0 40px}
.heritage-site #pp-tracking-page-app .pp_tracking_form_div{margin-top:0;margin-bottom:0}
.heritage-site #pp-tracking-page-app .pp_tracking_span,.heritage-site #pp-tracking-page-app .pp_tracking_tab{font-family:var(--font-sans);font-size:13px;color:var(--color-text)}
.heritage-site #pp-tracking-page-app input{background:transparent!important;border:1px solid var(--color-line)!important;border-radius:0!important;color:var(--color-text);font:400 16px/1.5 var(--font-sans);min-height:50px}
.heritage-site #pp-tracking-page-app button[type=submit]{background:var(--color-text)!important;color:var(--color-bg)!important;border:1px solid var(--color-text)!important;border-radius:0!important;font:500 11px/1.5 var(--font-sans);letter-spacing:.12em;text-transform:uppercase;min-height:50px}
.heritage-site #pp-tracking-page-app [role=tab]{min-height:44px}
.heritage-site #pp-tracking-page-app .pp_active{border-color:var(--color-text)!important}
.heritage-site #vh-contact-embed{order:1;padding:44px 20px 64px;border-top:1px solid var(--color-line);color:var(--color-text)}
.heritage-site #vh-contact-embed h2{font:400 34px/1.2 var(--font-serif);margin-bottom:24px;letter-spacing:0}
.heritage-site #vh-contact-embed p{font-size:14px;line-height:1.8}
@media(max-width:767px){.heritage-site #pp-tracking-page-app{padding:44px 20px}.heritage-site #vh-contact-embed{padding:36px 20px 48px}.heritage-site #vh-contact-embed .vhc-wrap{padding:0}}
</style>
<script>
(() => {
  const styles = `
    #UpcartPopup{--upcart-internal-global-button-border-radius:0px;font-family:Montserrat,Arial,sans-serif;color:#132039}
    #UpcartPopup .upcart-cart,#UpcartPopup .UpcartDesignSettings__backgroundColor>div{background:#f7f5ef!important;color:#132039}
    #UpcartPopup .UpcartDesignSettings__cartTextColor,#UpcartPopup .UpcartDesignSettings__subtotalTextColor{color:#132039!important}
    #UpcartPopup .UpcartDesignSettings__cartTextSubduedColor,#UpcartPopup .UpcartDesignSettings__subtotalSubduedColor{color:#5e6269!important;opacity:1}
    #UpcartPopup .upcart-header{border-bottom:1px solid #dedad0;padding:24px}
    #UpcartPopup .upcart-header-text,#UpcartPopup h3{font-family:'Cormorant Garamond',Georgia,serif!important;font-size:32px!important;font-weight:400!important;line-height:1.2;color:#132039}
    #UpcartPopup .upcart-product-title{font-family:'Cormorant Garamond',Georgia,serif!important;font-size:24px!important;line-height:1.2}
    #UpcartPopup h2{font-family:'Cormorant Garamond',Georgia,serif!important;font-size:28px!important;font-weight:400!important}
    #UpcartPopup .UpcartDesignSettings__button,#UpcartPopup .UpcartDesignSettings__button span{background:#132039!important;color:#f7f5ef!important;border-radius:0!important}
    #UpcartPopup .UpcartDesignSettings__button{min-height:50px;font-size:12px;letter-spacing:.06em}
    #UpcartPopup .upcart-checkout-button,#UpcartPopup .upcart-checkout-button span{font:500 11px/1.5 Montserrat,Arial,sans-serif!important;letter-spacing:.12em;text-transform:uppercase}
    #UpcartPopup .UpcartDesignSettings__cartAccentColor{background:#efede6!important}
    #UpcartPopup .UpcartDesignSettings__cartSavingsTextColor{color:#36523b!important}
    #UpcartPopup .upcart-header-close-button{width:44px;height:44px;color:#132039}
    #UpcartPopup button:focus-visible,#UpcartPopup a:focus-visible,#UpcartPopup input:focus-visible{outline:2px solid #132039;outline-offset:3px}
    #UpcartPopup input{font-size:16px}
  `;
  const apply = () => {
    const root = document.getElementById('upCart')?.shadowRoot;
    if (!root) return false;
    if (!root.getElementById('heritage-cart-styles')) {
      const style = document.createElement('style');
      style.id = 'heritage-cart-styles';
      style.textContent = styles;
      root.append(style);
    }
    return true;
  };
  let attempts = 0;
  const timer = window.setInterval(() => { if (apply() || ++attempts >= 120) window.clearInterval(timer); }, 250);
  document.addEventListener('click', event => {
    if (event.target.closest('[data-dialog-open="CartDrawer"],[data-add-button],[data-sticky-add]')) {
      apply();
      window.setTimeout(apply, 500);
      window.setTimeout(apply, 1500);
    }
  });
})();
</script>
