<section class="image-text {% if section.settings.reverse %}image-text--reverse{% endif %}"><div class="image-text-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy' }}{% elsif section.settings.default_asset != blank %}<img src="{{ section.settings.default_asset | asset_url }}" width="1200" height="1500" alt="{{ section.settings.heading | escape }}" loading="lazy">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><div class="image-text-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% for block in section.blocks %}<div class="value-row" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span>{{ block.settings.value | escape }}</span></div>{% endfor %}{% if section.settings.label != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}</div></section>
{% stylesheet %}.image-text{display:grid;grid-template-columns:1fr 1fr}.image-text--reverse .image-text-media{order:2}.image-text-media img,.image-text-media svg{width:100%;height:100%;min-height:500px;object-fit:cover;background:var(--studio-bg)}.image-text-copy{padding:clamp(40px,6vw,110px);align-self:center}.image-text-copy h2{margin-bottom:32px}.image-text-copy .rte{font-size:12px;line-height:1.9}.image-text-copy .text-link{display:inline-block;margin-top:28px}.value-row{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px solid var(--color-line);font-size:11px}.value-row span:last-child{text-align:right}@media(max-width:767px){.image-text{grid-template-columns:1fr}.image-text--reverse .image-text-media{order:0}.image-text-media img,.image-text-media svg{min-height:0;aspect-ratio:4/5}.image-text-copy{padding:60px 24px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Image and story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "default_asset",
      "label": "Included image filename"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Image on right",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our approach"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "VALUE IN THE DETAILS"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The pieces you reach for again and again. Considered proportions, tactile materials, and a place for everything your day brings.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Link label",
      "default": "Discover The Vivienne"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "The signature"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Luxury without the logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image and story"
    }
  ]
}
{% endschema %}
