<article class="content-page"><p class="eyebrow">{{ article.published_at | date: format: 'date' }}</p><h1>{{ article.title | escape }}</h1>{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: class: 'article-hero', loading: 'eager' }}{% endif %}<div class="rte">{{ article.content }}</div><a class="text-link" href="{{ blog.url }}">{{ 'general.back_journal' | t }}</a></article>
{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
