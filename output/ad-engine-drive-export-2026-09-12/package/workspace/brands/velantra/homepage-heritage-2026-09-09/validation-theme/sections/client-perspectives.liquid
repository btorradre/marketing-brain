{%- capture review_content -%}
  {% for block in section.blocks %}
    {% render block %}
  {% endfor %}
{%- endcapture -%}
{%- liquid
  assign review_content = review_content | strip
  assign review_label = section.settings.heading | default: product.title
-%}
{% if review_content != blank or section.settings.show_empty_state %}
  <section class="client-perspectives" aria-label="{{ review_label | escape }}">
    {% if section.settings.heading != blank %}
      <header class="client-perspectives__header">
        <h2>{{ section.settings.heading | escape }}</h2>
      </header>
    {% endif %}
    <div class="client-perspectives__body">
      {% if review_content != blank %}
        {{ review_content }}
      {% else %}
        <p class="client-perspectives__empty">{{ section.settings.empty_text | escape }}</p>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .client-perspectives {
    padding-block: 40px 64px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
  }

  .client-perspectives__header {
    margin: 0 12px 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-line);
    text-align: center;
  }

  .client-perspectives__header h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .client-perspectives__body {
    width: 100%;
    max-width: 1200px;
    min-width: 0;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .client-perspectives__body > * {
    max-width: 100%;
  }

  .client-perspectives__empty {
    max-width: 42rem;
    margin: 0 auto;
    padding-block: 40px;
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
    overflow-wrap: anywhere;
  }

  @media (min-width: 1024px) {
    .client-perspectives {
      padding-block: 80px 112px;
    }

    .client-perspectives__header {
      text-align: left;
    }

    .client-perspectives__header h2 {
      font-size: 32px;
    }

    .client-perspectives__body {
      padding-inline: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Client perspectives",
  "limit": 1,
  "max_blocks": 4,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Client Perspectives" },
    { "type": "paragraph", "content": "Add your reviews app block to display this product's customer reviews. The app supplies review text, ratings, photos and verification status." },
    { "type": "checkbox", "id": "show_empty_state", "label": "Show section when no reviews app is configured", "default": true },
    { "type": "textarea", "id": "empty_text", "label": "Empty state text", "default": "Customer reviews are not available here yet." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Client perspectives" }]
}
{% endschema %}
