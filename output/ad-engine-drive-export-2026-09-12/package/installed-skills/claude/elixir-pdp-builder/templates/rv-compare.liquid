<section class="rvcmp">
  <p class="rvcmp-eyebrow">Why Renavita?</p>
  <h2 class="rvcmp-h2">Real true Ceylon† vs Other brands</h2>
  <div class="rvcmp-table">
    <div class="rvcmp-col rvcmp-us">
      <div class="rvcmp-bottle"><img src="__IMG_BOTTLE__" alt="Renavita"></div>
      <div class="rvcmp-cells">
        <span class="rvcmp-yes">✓</span><span class="rvcmp-yes">✓</span><span class="rvcmp-yes">✓</span><span class="rvcmp-yes">✓</span><span class="rvcmp-yes">✓</span>
      </div>
    </div>
    <div class="rvcmp-col rvcmp-feat">
      <span>True Verum Ceylon (not Cassia)</span>
      <span>Zero Sugar — No Maltitol</span>
      <span>You Chew It — Actually Absorbs</span>
      <span>Third-Party Verified &amp; Tested</span>
      <span>USA Made</span>
    </div>
    <div class="rvcmp-col rvcmp-them">
      <div class="rvcmp-bottle"><span class="rvcmp-blackbottle"></span></div>
      <div class="rvcmp-cells">
        <span class="rvcmp-no">✕</span><span class="rvcmp-no">✕</span><span class="rvcmp-no">✕</span><span class="rvcmp-no">✕</span><span class="rvcmp-no">✕</span>
      </div>
    </div>
  </div>
</section>
<style>
.rvcmp{max-width:880px;margin:0 auto;padding:60px 22px;text-align:center;}
.rvcmp-eyebrow{font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:__BRAND__;margin:0 0 8px;}
.rvcmp-h2{font-family:'Iowan Old Style',Palatino,Georgia,serif;font-size:30px;font-weight:800;color:__INK__;margin:0 0 34px;}
.rvcmp-table{display:grid;grid-template-columns:1fr 1.4fr 1fr;align-items:stretch;max-width:760px;margin:0 auto;}
.rvcmp-us{background:linear-gradient(160deg,__BRAND__,__BRAND_DARK__);border-radius:16px 16px 0 0;}
.rvcmp-them{background:#ececec;border-radius:16px 16px 0 0;}
.rvcmp-bottle{height:150px;display:flex;align-items:center;justify-content:center;padding:16px;}
.rvcmp-bottle img{max-height:135px;border-radius:8px;}
.rvcmp-blackbottle{width:54px;height:118px;background:#1c1c1c;border-radius:10px 10px 6px 6px;display:block;}
.rvcmp-cells{display:flex;flex-direction:column;}
.rvcmp-cells span{height:58px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;border-top:1px solid rgba(0,0,0,.08);}
.rvcmp-us .rvcmp-cells span{border-top-color:rgba(255,255,255,.14);}
.rvcmp-yes{color:#fff;} .rvcmp-no{color:#9a9a9a;}
.rvcmp-feat{display:flex;flex-direction:column;padding-top:150px;}
.rvcmp-feat span{height:58px;display:flex;align-items:center;justify-content:center;font-size:14.5px;font-weight:600;color:__INK__;border-top:1px solid __LINE__;}
@media(max-width:820px){.rvcmp{padding:44px 16px;}.rvcmp-h2{font-size:24px;}.rvcmp-feat span{font-size:12.5px;}.rvcmp-bottle{height:120px;}.rvcmp-feat{padding-top:120px;}}
</style>
{% schema %}{"name":"RV Compare","settings":[],"presets":[{"name":"RV Compare"}]}{% endschema %}
