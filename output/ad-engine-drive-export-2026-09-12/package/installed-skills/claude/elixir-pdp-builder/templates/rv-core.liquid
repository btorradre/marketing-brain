<section class="rvcore">
  <div class="rvcore-panel">
    <div class="rvcore-grid">
      <div class="rvcore-body">
        <p class="rvcore-eyebrow">The True Spice</p>
        <h2 class="rvcore-h2">Support your blood sugar from the inside out</h2>
        <p class="rvcore-p">Renavita is built to fight the oxidative “rust” that jams your cells and quietly corrodes your kidney filters — with true Verum Ceylon cinnamon, standardized to 2,000&nbsp;mg, in a sugar-free gummy you actually chew.†</p>
        <div class="rvcore-feats">
          <div class="rvcore-feat"><span>✦</span>Steady All-Day Energy†</div>
          <div class="rvcore-feat"><span>◈</span>Antioxidant Cellular Support†</div>
          <div class="rvcore-feat"><span>◆</span>Healthy Blood Sugar†</div>
          <div class="rvcore-feat"><span>❋</span>Gentle On Your Stomach†</div>
        </div>
      </div>
      <div class="rvcore-img"><img src="{{ 'three-bottles-t.png' | asset_url }}" alt="Renavita Ceylon Cinnamon Gummies"></div>
    </div>
  </div>
</section>
<style>
.rvcore{width:100vw;position:relative;left:50%;transform:translateX(-50%);background:radial-gradient(120% 140% at 82% 18%,__BRAND_DARK__,__DARK__ 72%);padding:8px 22px;}
.rvcore-panel{max-width:1180px;margin:0 auto;}
.rvcore-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;}
.rvcore-body{padding:56px;align-self:center;}
.rvcore-eyebrow{font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:__GOLD_LT__ !important;margin:0 0 12px;}
.rvcore-h2{font-family:'Iowan Old Style',Palatino,Georgia,serif;font-size:34px;line-height:1.12;font-weight:800;color:__PAPER__ !important;margin:0 0 16px;}
.rvcore-p{font-size:16px;line-height:1.6;color:rgba(243,230,208,.85) !important;margin:0 0 28px;max-width:480px;}
.rvcore-feats{display:grid;grid-template-columns:1fr 1fr;gap:18px 16px;max-width:470px;}
.rvcore-feat{display:flex;align-items:center;gap:10px;color:__PAPER__ !important;font-size:14px;font-weight:600;}
.rvcore-feat span{color:__GOLD_LT__ !important;font-size:20px;}
.rvcore-img{display:flex;align-items:center;justify-content:center;padding:40px 28px;}.rvcore-img img{width:auto;max-width:100%;max-height:380px;height:auto;display:block;}
@media(max-width:820px){.rvcore-grid{grid-template-columns:1fr;}.rvcore-body{padding:32px 24px;order:2;}.rvcore-h2{font-size:26px;}.rvcore-feats{max-width:none;}.rvcore-img img{height:auto;}}
</style>
