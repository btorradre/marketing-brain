<style>

  :root{
    /* ===== ALL ACCENTS = VARIATIONS OF #94C218 ===== */
    --accent:        #94C218;   /* primary brand green — headings, numbers, accents */
    --accent-hover:  #9ACD32;   /* button hover */
    --accent-deep:   #7DA614;   /* button base / medium fills */
    --accent-band:   #6E9614;   /* deep fill behind white text (banners, hero, press) */
    --accent-ink:    #4d6e0c;   /* darkest green for accent text on light */
    --accent-tint:   #F4F8E8;   /* pale celery section background */
    --accent-tint2:  #EFFAD1;   /* deeper celery tint (cards, gift banner) */
    --accent-tint3:  #E3F0BE;   /* celery border / chip */
    /* neutrals (brandkit) */
    --ink:#1c1c1a; --charcoal:#2A2A2A; --body:#3d3d3a; --mid:#5F6264;
    --line:#E5E5E5; --canvas:#F2F2EC; --white:#FFFFFF;
    --serif:'Playfair Display', Georgia, serif;
    --sans:'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  /* ============ HIDE THEME CHROME (header/footer/announcement/popups) ============ */
  .shopify-section-header,
  .shopify-section-footer,
  [id*='shopify-section-'][id*='__header'],
  [id*='shopify-section-'][id*='__footer'],
  [id*='shopify-section-'][id*='__announcement'],
  [id*='shopify-section-'][id*='announcement-bar'],
  #shopify-section-promo-popup,
  #shopify-section-scroll-to-top-btn,
  #shopify-section-global-music-player,
  .site-header, .header, header.site-header,
  .site-footer, .footer, footer.site-footer,
  #header-component, #footer-component,
  .announcement-bar, .promo-popup,
  scroll-to-top-btn, global-music-player {
    display: none !important;
  }
  body { padding-top: 0 !important; margin-top: 0 !important; }
  main, #MainContent, [role="main"] { margin-top: 0 !important; padding-top: 0 !important; }

  html{scroll-behavior:smooth;}
  body{font-family:var(--sans);color:var(--body);background:var(--white);
    font-size:16px;line-height:1.6;letter-spacing:-0.2px;-webkit-font-smoothing:antialiased;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1040px;margin:0 auto;padding:0 22px;}
  .narrow{max-width:760px;margin:0 auto;padding:0 22px;}
  strong,b{font-weight:700;color:var(--ink);}
  em{font-style:italic;}

  /* serif display headers */
  .serif{font-family:var(--serif);color:var(--accent);font-weight:700;line-height:1.12;letter-spacing:-0.3px;}

  /* numbered list titles */
  .item-title{font-family:var(--sans);color:var(--accent-ink);font-weight:800;
    font-size:clamp(22px,3.4vw,30px);line-height:1.2;letter-spacing:-0.6px;margin-bottom:22px;}

  /* buttons */
  .btn{display:inline-block;background:var(--accent-deep);color:#fff;text-decoration:none;
    font-weight:700;font-size:14px;letter-spacing:.6px;text-transform:uppercase;
    padding:16px 34px;border-radius:30px;border:none;cursor:pointer;transition:.18s;
    box-shadow:0 4px 14px rgba(125,166,20,.28);}
  .btn:hover{background:var(--accent-hover);transform:translateY(-1px);}
  .btn-ghost{background:transparent;border:2px solid #fff;box-shadow:none;}
  .btn-ghost:hover{background:rgba(255,255,255,.14);transform:none;}
  .btn-lg{padding:18px 46px;font-size:15px;}
  .cta-center{text-align:center;margin:42px 0;}
  .cta-note{display:inline-block;margin-left:14px;color:var(--accent-ink);font-weight:700;
    font-size:13px;letter-spacing:.4px;text-transform:uppercase;vertical-align:middle;}

  /* image placeholders */
  .ph{background:linear-gradient(135deg,#F4F6EC,#E9F1D4);border-radius:10px;
    display:flex;align-items:center;justify-content:center;text-align:center;
    color:#8aa24e;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;
    padding:18px;border:1px solid var(--accent-tint3);min-height:200px;}
  .ph span{max-width:80%;line-height:1.5;}
  .img-asset{border-radius:10px;width:100%;height:auto;display:block;}

  /* generic two-col row */
  .row{display:flex;gap:38px;align-items:flex-start;margin:0 auto;}
  .row .col-img{flex:0 0 40%;}
  .row .col-txt{flex:1;}
  .row .col-txt p{margin-bottom:14px;}

  section{padding:0;}

  /* ============ HERO ============ */
  .hero{background:linear-gradient(168deg,#94C218 0%,#7DA614 58%,#cfe48f 100%);
    color:#1e2b06;padding:54px 0 70px;}
  .hero-grid{display:flex;gap:30px;align-items:center;}
  .hero-left{flex:1.05;}
  .hero-right{flex:1;position:relative;min-height:380px;}
  .hero h1{font-family:var(--serif);font-weight:700;color:#fff;
    font-size:clamp(28px,4.4vw,44px);line-height:1.12;letter-spacing:-0.5px;margin-bottom:18px;
    text-shadow:0 1px 1px rgba(40,60,5,.12);}
  .hero h1 em{font-style:italic;color:#fff;}
  .hero .sub{color:#1f2d06;font-size:clamp(15px,2vw,18px);font-weight:500;margin-bottom:22px;max-width:520px;}
  .hero .sub strong{color:#1a2605;}
  .hero .minihead{font-weight:800;color:#27360a;font-size:14px;margin-bottom:8px;text-transform:uppercase;letter-spacing:.4px;}
  .hero ul{list-style:none;margin-bottom:26px;}
  .hero ul li{position:relative;padding-left:24px;margin-bottom:7px;color:#23320a;font-weight:500;font-size:15px;}
  .hero ul li::before{content:"";position:absolute;left:2px;top:8px;width:9px;height:9px;border-radius:50%;background:#fff;}
  .hero-prod{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
  .hero-prod img{width:92%;max-width:520px;height:auto;}
  .hero-prod .ph{width:62%;min-height:330px;background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.5);color:#3c5210;}
  .bubble{position:absolute;background:#fff;border-radius:40px;padding:11px 18px;
    font-size:12.5px;font-weight:700;color:var(--accent-ink);line-height:1.25;text-align:center;
    box-shadow:0 6px 18px rgba(40,60,5,.18);max-width:160px;z-index:2;}
  .bubble.b1{top:2%;right:6%;}
  .bubble.b2{top:30%;left:-2%;}
  .bubble.b3{top:46%;right:-1%;}
  .bubble.b4{bottom:4%;left:24%;}

  /* ============ OPENING FRAME ============ */
  .opening{background:var(--accent-tint);padding:56px 0;}
  .opening .col-img .ph,.opening .col-img img{min-height:330px;object-fit:cover;}
  .opening .col-txt{font-size:15.5px;color:var(--body);}
  .opening .col-txt p{margin-bottom:13px;}

  /* ============ BAND BANNER ============ */
  .band{background:var(--accent-band);color:#fff;text-align:center;padding:30px 22px;}
  .band p{font-family:var(--serif);font-size:clamp(20px,3vw,30px);font-weight:600;}
  .band p strong{color:#fff;font-weight:800;}

  /* ============ LIST ITEMS ============ */
  .items{padding:56px 0;}
  .item{margin-bottom:62px;}
  .item .item-body{font-size:15.5px;color:var(--body);}
  .item .item-body p{margin-bottom:13px;}
  .item .ph,.item .col-img img{min-height:300px;object-fit:cover;}
  .quotes-inline{color:var(--mid);font-style:italic;}

  /* interstitial */
  .inter{text-align:center;padding:30px 0 10px;}
  .inter h2{font-family:var(--serif);color:var(--accent);font-size:clamp(22px,3.4vw,32px);font-weight:700;margin-bottom:30px;}
  .chart-row{display:flex;gap:38px;align-items:center;}
  .chart-row .chart{flex:1;}
  .chart-row .chart-txt{flex:1;font-size:15px;}
  .chart-row .chart-txt p{margin-bottom:12px;}
  .chart svg{width:100%;height:auto;}

  /* ============ CLOSE / TIMELINE ============ */
  .closeblock{text-align:center;padding:30px 0 10px;font-size:16px;}
  .closeblock .narrow p{margin-bottom:6px;}
  .timeline{padding:54px 0;}
  .timeline h2{font-family:var(--serif);color:var(--accent);font-size:clamp(24px,3.6vw,34px);font-weight:700;margin-bottom:26px;line-height:1.1;}
  .tl-item{display:flex;gap:13px;align-items:flex-start;margin-bottom:16px;font-size:15px;}
  .tl-item svg{flex:0 0 22px;margin-top:2px;}
  .tl-item b{color:var(--ink);}
  .timeline .ph,.timeline .col-img img{min-height:360px;object-fit:cover;}

  /* ============ TESTIMONIAL CARDS ============ */
  .tcards{display:flex;gap:24px;padding:24px 0 56px;}
  .tcard{flex:1;background:var(--accent-tint);border:1px solid var(--accent-tint3);border-radius:8px;padding:24px;}
  .tcard .h{font-weight:800;color:var(--ink);margin-bottom:12px;}
  .tcard .q{font-style:italic;color:var(--body);margin-bottom:14px;}
  .tcard .n{font-style:italic;color:var(--mid);font-size:14px;}

  /* ============ COMPARISON TABLE ============ */
  .compare{padding:30px 0 56px;}
  .ctable{display:flex;border-radius:6px;overflow:hidden;max-width:840px;margin:0 auto;box-shadow:0 6px 22px rgba(0,0,0,.06);}
  .ccol{flex:1;}
  .chead{padding:16px;text-align:center;font-weight:700;font-size:15px;color:#fff;}
  .ccol.bad .chead{background:#8a8a86;}
  .ccol.good .chead{background:var(--accent-band);}
  .ccol.bad{background:#f3f3f1;}
  .ccol.good{background:var(--accent-tint2);}
  .crow{padding:13px 16px;font-size:13.5px;display:flex;gap:9px;align-items:flex-start;border-top:1px solid rgba(0,0,0,.05);}
  .ccol.bad .crow{color:#6f6f6c;}
  .ccol.good .crow{color:#3c4a1a;}
  .crow .mk{flex:0 0 16px;font-weight:800;margin-top:1px;}
  .ccol.bad .mk{color:#b04a3a;}
  .ccol.good .mk{color:var(--accent-deep);}

  /* ============ IMAGINE ============ */
  .imagine{background:var(--accent-tint);padding:60px 0;}
  .imagine h2{font-family:var(--serif);color:var(--accent);font-size:clamp(24px,3.6vw,34px);font-weight:700;margin-bottom:26px;}
  .imagine .chk{display:flex;gap:12px;align-items:flex-start;margin-bottom:13px;font-size:15.5px;}
  .imagine .chk svg{flex:0 0 22px;margin-top:2px;}
  .imagine .chk b{color:var(--ink);}
  .imagine .body p{margin:18px 0 0;font-size:15.5px;}
  .imagine .body .choice{margin:6px 0;font-size:15.5px;}

  /* recommended for band */
  .recfor{background:var(--accent-band);color:#fff;padding:46px 0;text-align:center;}
  .recfor h2{font-family:var(--serif);font-size:clamp(22px,3.4vw,32px);font-weight:700;margin-bottom:24px;}
  .recfor .rf{display:flex;gap:10px;justify-content:center;align-items:center;margin-bottom:12px;font-size:16px;font-weight:500;}
  .recfor .rf svg{flex:0 0 22px;}

  /* free ship strip */
  .ship{background:var(--accent-deep);color:#fff;text-align:center;padding:15px;font-weight:600;font-size:15px;letter-spacing:.2px;}

  /* steps */
  .steps{padding:44px 0 10px;}
  .steps-row{display:flex;justify-content:center;gap:0;max-width:520px;margin:0 auto;}
  .step{flex:1;text-align:center;position:relative;}
  .step .lbl-top{font-size:13px;color:var(--mid);margin-bottom:10px;}
  .step .circle{width:62px;height:62px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;background:var(--accent-tint2);}
  .step .lbl-bot{font-size:13px;color:var(--ink);font-weight:600;margin-top:10px;}
  .step:not(:last-child)::after{content:"";position:absolute;top:calc(33px + 26px);left:60%;width:80%;height:2px;background:var(--accent-tint3);z-index:-1;}

  .startblock{text-align:center;padding:26px 0 50px;}
  .startblock h2{font-family:var(--serif);color:var(--accent);font-style:italic;font-size:clamp(22px,3.4vw,32px);font-weight:700;line-height:1.2;margin-bottom:14px;}
  .startblock h2 .reg{font-style:normal;}
  .startblock .sub{color:var(--accent-deep);font-weight:600;font-size:15px;}

  /* ============ GIFT BANNER ============ */
  .gift{max-width:840px;margin:0 auto 48px;border-radius:12px;overflow:hidden;box-shadow:0 8px 26px rgba(0,0,0,.08);}
  .gift-top{background:linear-gradient(120deg,#EFFAD1 0%,#dcefa6 60%,#c8e57f 100%);padding:34px 30px 30px;text-align:center;position:relative;}
  .gift .tag{position:absolute;top:-0;left:50%;transform:translateX(-50%);background:var(--accent-deep);color:#fff;font-size:12px;font-weight:700;letter-spacing:.5px;padding:6px 18px;border-radius:0 0 8px 8px;text-transform:uppercase;}
  .gift h3{font-family:var(--serif);color:#2c3d09;font-size:clamp(24px,4vw,38px);font-weight:600;margin:14px 0 8px;}
  .gift h3 em{font-style:italic;}
  .gift h3 .small{font-size:.5em;font-weight:700;display:block;letter-spacing:1px;color:var(--accent-ink);text-transform:uppercase;font-family:var(--sans);}
  .gift .desc{color:#3c4a1a;font-size:14px;max-width:440px;margin:0 auto 16px;}
  .gift .pills{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
  .gift .pill{background:#fff;border:1px solid var(--accent-tint3);border-radius:30px;padding:9px 18px;font-size:13px;font-weight:700;color:var(--accent-ink);}
  .gift-bot{background:var(--accent-band);color:#fff;text-align:center;padding:11px;font-size:13px;}
  .gift-bot strong{color:#fff;}

  /* ============ PRICING ============ */
  .pricing{padding:10px 0 56px;}
  .ptiers{display:flex;gap:20px;align-items:stretch;justify-content:center;flex-wrap:wrap;}
  .ptier{flex:1;min-width:260px;max-width:320px;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;text-align:center;box-shadow:0 4px 16px rgba(0,0,0,.05);}
  .ptier .phead{padding:11px;font-weight:700;font-size:13px;letter-spacing:.4px;text-transform:uppercase;background:var(--accent-tint2);color:var(--accent-ink);}
  .ptier.best{border:2px solid var(--accent-deep);position:relative;transform:scale(1.02);box-shadow:0 10px 30px rgba(125,166,20,.2);}
  .ptier.best .phead{background:var(--accent-band);color:#fff;}
  .best-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--accent-deep);color:#fff;font-size:11px;font-weight:700;letter-spacing:.6px;padding:5px 16px;border-radius:20px;text-transform:uppercase;white-space:nowrap;}
  .pbody{padding:22px 18px 24px;display:flex;flex-direction:column;flex:1;}
  .pbody .supply{font-weight:800;color:var(--ink);font-size:20px;}
  .pbody .serv{color:var(--mid);font-size:13px;margin-bottom:6px;}
  .pbody .freeship{color:var(--accent-deep);font-style:italic;font-size:12px;font-weight:600;margin-bottom:10px;}
  .pbody .pimg{position:relative;margin:6px auto 14px;}
  .pbody .pimg .ph{min-height:130px;width:160px;}
  .pct-circle{position:absolute;top:-6px;left:-10px;width:54px;height:54px;border-radius:50%;background:var(--accent-deep);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;font-size:14px;line-height:1;box-shadow:0 3px 10px rgba(0,0,0,.18);}
  .pct-circle small{font-size:9px;font-weight:700;}
  .retail{color:var(--mid);text-decoration:line-through;font-size:13px;}
  .savings{color:#b04a3a;font-weight:700;font-size:13px;margin-bottom:6px;}
  .price{font-size:34px;font-weight:800;color:var(--ink);line-height:1;}
  .price-lbl{color:var(--mid);font-size:13px;margin:2px 0 2px;}
  .price-total{color:var(--mid);font-size:12px;margin-bottom:14px;}
  .pbody .btn{width:100%;margin-top:auto;}
  .otp{color:var(--mid);font-size:11px;margin-top:8px;}
  .ptrust{display:flex;justify-content:center;gap:18px;margin-top:14px;}
  .ptrust .ti{font-size:9px;color:var(--mid);text-align:center;max-width:70px;line-height:1.3;}
  .ptrust .ti svg{margin:0 auto 4px;display:block;}

  /* ============ PRESS BAR ============ */
  .press{background:var(--accent-band);color:#fff;}
  .press .r1,.press .r2{padding:22px;display:flex;align-items:center;justify-content:center;gap:32px;flex-wrap:wrap;}
  .press .r2{border-top:1px solid rgba(255,255,255,.18);}
  .press .lead{font-style:italic;font-size:13px;opacity:.92;}
  .press .logo{font-weight:800;letter-spacing:.5px;opacity:.95;font-size:17px;}
  .press .logo.serif{font-family:var(--serif);color:#fff;}

  /* ============ EXPERT ============ */
  .expert{padding:56px 0;text-align:center;}
  .expert h2{font-family:var(--serif);color:var(--accent);font-size:clamp(22px,3.4vw,30px);font-weight:700;margin-bottom:30px;}
  .expert-row{display:flex;gap:34px;align-items:center;text-align:left;}
  .expert-row .ph,.expert-row img.expert-pic{flex:0 0 38%;min-height:240px;object-fit:cover;border-radius:10px;}
  .expert .q{flex:1;font-style:italic;font-size:17px;color:var(--body);line-height:1.55;}
  .expert .q .name{display:block;font-style:normal;font-weight:700;color:var(--ink);margin-top:16px;font-size:15px;}
  .dots{margin-top:24px;}
  .dots span{display:inline-block;width:22px;height:3px;background:var(--accent-tint3);margin:0 3px;border-radius:2px;}
  .dots span.on{background:var(--accent-deep);}

  /* ============ Q&A ============ */
  .qa{padding:50px 0;background:var(--accent-tint);}
  .qa .row .col-img .ph,.qa .row .col-img img{min-height:300px;object-fit:cover;}
  .qa h2{font-family:var(--serif);color:var(--accent);font-size:clamp(22px,3.2vw,28px);font-weight:700;margin-bottom:18px;line-height:1.15;}
  .qa .a{font-size:15px;}
  .qa .a p{margin-bottom:14px;}
  .qa .a .lead{font-weight:700;color:var(--ink);}

  /* ============ HOW IT WORKS ============ */
  .how{padding:56px 0;}
  .how-row{display:flex;gap:40px;align-items:flex-start;}
  .how-left{flex:1;}
  .how-right{flex:1;}
  .how h2{font-family:var(--serif);color:var(--accent);font-size:clamp(26px,3.6vw,34px);font-weight:700;margin-bottom:18px;}
  .how h2 em{font-style:italic;}
  .how p{font-size:15px;margin-bottom:14px;}
  .how .chk{display:flex;gap:11px;align-items:flex-start;margin-bottom:13px;font-size:14.5px;}
  .how .chk svg{flex:0 0 20px;margin-top:2px;}
  .how .tagline{color:var(--accent-deep);font-weight:600;font-size:14px;margin-top:8px;}
  /* supplement facts */
  .sfacts{border:2px solid #111;padding:12px 14px;font-family:Arial,Helvetica,sans-serif;color:#111;background:#fff;font-size:13px;line-height:1.3;}
  .sfacts h3{font-size:30px;font-weight:800;letter-spacing:-1px;border-bottom:8px solid #111;padding-bottom:2px;margin-bottom:4px;font-family:Arial,sans-serif;}
  .sfacts .ss{font-weight:700;}
  .sfacts .bar{border-top:1px solid #111;}
  .sfacts .thick{border-top:6px solid #111;margin:4px 0;}
  .sfacts table{width:100%;border-collapse:collapse;}
  .sfacts td{padding:4px 0;vertical-align:top;border-top:1px solid #111;}
  .sfacts td.amt{text-align:right;white-space:nowrap;font-weight:700;}
  .sfacts .dvhead{display:flex;justify-content:flex-end;font-weight:700;border-top:1px solid #111;padding-top:3px;}
  .sfacts .foot{font-size:11px;margin-top:4px;border-top:5px solid #111;padding-top:4px;}
  .sfacts em{font-style:italic;}
  .otheri{font-size:12.5px;color:var(--mid);margin-top:12px;}
  .otheri b{color:var(--ink);}

  /* ============ CITATIONS ============ */
  .cites{padding:34px 0 56px;}
  .cites h2{font-family:var(--serif);color:var(--accent);font-style:italic;text-align:center;font-size:clamp(20px,3vw,28px);font-weight:700;margin-bottom:26px;letter-spacing:1px;}
  .cite{margin-bottom:18px;font-size:13px;color:var(--body);}
  .cite .ttl{font-style:italic;font-weight:700;color:var(--ink);margin-bottom:4px;}
  .cite ul{list-style:none;padding-left:14px;}
  .cite li{position:relative;padding-left:14px;margin-bottom:4px;}
  .cite li::before{content:"•";position:absolute;left:0;color:var(--accent-deep);}
  .cite a{color:var(--accent-ink);word-break:break-all;}

  /* ============ VIDEO TESTIMONIALS ============ */
  .vids{background:var(--accent-band);color:#fff;padding:46px 0 52px;}
  .vids .vhead{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:26px;}
  .vids h2{font-family:var(--serif);font-size:clamp(24px,3.6vw,32px);font-weight:600;}
  .vids h2 em{font-style:italic;}
  .vids .vsub{font-size:13px;opacity:.9;}
  .vgrid{display:flex;gap:20px;}
  .vcard{flex:1;position:relative;border-radius:8px;overflow:hidden;background:#2c3d09;min-height:330px;display:flex;align-items:flex-end;}
  .vcard .vthumb{position:absolute;inset:0;background:linear-gradient(135deg,#4a6310,#33480b);display:flex;align-items:center;justify-content:center;color:#cfe48f;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;text-align:center;padding:16px;}
