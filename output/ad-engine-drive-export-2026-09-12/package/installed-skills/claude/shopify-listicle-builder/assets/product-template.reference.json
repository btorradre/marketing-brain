          "settings": {
            "custom_liquid": "<div class=\"motilli-review\">\n  <div class=\"motilli-review__avatar\">\n    <img class=\"motilli-review__avatar-img\" src=\"https:\/\/i.pinimg.com\/736x\/de\/89\/fb\/de89fbe4efac392defa471d41ca55c77.jpg\" alt=\"Patricia H\">\n  <\/div>\n  <div class=\"motilli-review__body\">\n    <div class=\"motilli-review__header\">\n      <span class=\"motilli-review__name\">Patricia H., 64<\/span>\n      <span class=\"motilli-review__verified\" aria-label=\"Verified buyer\">\n        <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#1da1f2\"\/><path d=\"M7 12.5l3 3 7-7\" stroke=\"#ffffff\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\n      <\/span>\n      <span class=\"motilli-review__stars\">\n        {% for i in (1..5) %}<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"#f4b400\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"\/><\/svg>{% endfor %}\n      <\/span>\n    <\/div>\n    <p class=\"motilli-review__meta\">8 months on Mounjaro &middot; 11 months of Miralax<\/p>\n    <p class=\"motilli-review__text\">\"Eight months on Mounjaro and eleven months of Miralax that did nothing. Day 4 of Motilli I went on my own for the first time. My doctor just told me to drink more water and add more fiber. I almost quit the shot. These gummies saved my GLP-1.\"<\/p>\n  <\/div>\n<\/div>\n\n<style>\n  .motilli-review { display: flex; align-items: flex-start; gap: 14px; padding: 18px; border: 1px solid #e6e6e6; border-radius: 14px; background: #ffffff; margin: 16px 0 22px 0; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif; }\n  .motilli-review__avatar { flex-shrink: 0; width: 56px; height: 56px; }\n  .motilli-review__avatar-img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; display: block; background-color: #d4c4a8; }\n  .motilli-review__body { flex: 1; min-width: 0; }\n  .motilli-review__header { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; flex-wrap: wrap; }\n  .motilli-review__name { font-weight: 600; font-size: 14px; color: #1a1a1a; }\n  .motilli-review__verified { display: inline-flex; }\n  .motilli-review__stars { display: inline-flex; gap: 1px; margin-left: 4px; }\n  .motilli-review__meta { font-size: 12px; color: #888; margin: 0 0 8px 0; font-style: italic; }\n  .motilli-review__text { font-size: 13.5px; line-height: 1.5; color: #2a2a2a; margin: 0; }\n<\/style>"
          }
